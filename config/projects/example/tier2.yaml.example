# Tier 2 Language Configuration — Example
# Rename to tier2.yaml when using test_strategy: "tier"
# Required when: feature_toggles.test_strategy == "tier" AND tier2_tests == true

enabled: true
language: "python"
framework: "pytest"
tier: "Tier 2"

# Import configuration
imports:
  standard:
    - "time"
    - "logging"
  framework:
    - "pytest"
  project: []                           # Add project-specific imports

# Test patterns (used by test-generator for naming conventions)
test_patterns:
  function_prefix: "test_"
  class_prefix: "Test"
  assertion_style: "assert"

# Markers (pytest markers applied to generated tests)
# markers:
#   - "e2e"
#   - "slow"
