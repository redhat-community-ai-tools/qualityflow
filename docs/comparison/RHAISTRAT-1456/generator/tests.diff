+import json
+
+from ogx_client import OgxClient
+from openai import OpenAI
+import pytest
+import requests
+
+from tests.ogx_codex_sdk.utils import create_chat_completion, extract_tool_calls, validate_tool_call
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-tool", "randomize_name": True}, id="ogx-codex-tool")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkTools:
+    """Tool-call contract tests for the OGX Codex SDK."""
+
+    @pytest.mark.tier1
+    def test_tc_tool_001(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-TOOL-001: Verify all six tools return schema-valid JSON arguments."""
+        expected_tools = [
+            ("bash", {"command"}, "List all files in /tmp."),
+            ("read_file", {"path"}, "Read the contents of main.py."),
+            ("write_file", {"path", "content"}, "Write hello world to test.txt."),
+            ("edit_file", {"path", "old_text", "new_text"}, "Change line 5 of app.py to return 42."),
+            ("grep_search", {"pattern"}, "Search for TODO comments in the project."),
+            ("glob_search", {"pattern"}, "Find all .yaml files in the repo."),
+        ]
+        for tool_name, required_fields, prompt in expected_tools:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": tool_name}},
+                max_tokens=256,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for {tool_name}"
+            arguments = validate_tool_call(tool_calls[0], tool_name, required_fields)
+            assert arguments, f"Tool {tool_name} returned empty arguments"
+
+    @pytest.mark.tier1
+    def test_tc_tool_002(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-TOOL-002: Verify sequential tool calls can depend on prior outputs."""
+        workflow = [
+            (
+                "glob_search",
+                {"pattern"},
+                "Find all Python files in the project. The first result is calculator.py.",
+                {"pattern": "*.py"},
+            ),
+            (
+                "read_file",
+                {"path"},
+                "Read calculator.py, the first Python file from the previous result.",
+                {"path": "calculator.py"},
+            ),
+            (
+                "edit_file",
+                {"path", "old_text", "new_text"},
+                "Add a module-level docstring to calculator.py, the file you just read.",
+                {"path": "calculator.py"},
+            ),
+        ]
+        for tool_name, required_fields, prompt, expected_arguments in workflow:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": tool_name}},
+                max_tokens=256,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for {tool_name}"
+            arguments = validate_tool_call(tool_calls[0], tool_name, required_fields)
+            for key, expected in expected_arguments.items():
+                assert arguments.get(key) == expected, f"Tool {tool_name} did not chain {key} correctly"
+
+    @pytest.mark.tier3
+    def test_tc_tool_003(
+        self,
+        codex_base_url: str,
+        codex_http_session: requests.Session,
