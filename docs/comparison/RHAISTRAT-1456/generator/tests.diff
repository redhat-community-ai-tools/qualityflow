+from collections.abc import Generator
+from typing import Any
+import uuid
+
+import pytest
+import requests
+from ogx_client import OgxClient
+from openai import OpenAI
+
+from tests.ogx.conftest import (
+    distribution_name,
+    enabled_ogx_operator,
+    is_disconnected_cluster,
+    ogx_client,
+    ogx_models,
+    ogx_server,
+    ogx_server_deployment,
+    ogx_server_secret,
+    ogx_test_route,
+    postgres_deployment,
+    postgres_service,
+    skip_ogx_if_not_supported_openshift_version,
+)
+from tests.ogx.constants import OGX_CLIENT_VERIFY_SSL, ModelInfo
+from tests.ogx_codex_sdk.utils import codex_tools as codex_tool_definitions
+
+
+@pytest.fixture(scope="class")
+def codex_base_url(ogx_client: OgxClient) -> str:
+    """Return the OpenAI-compatible base URL for the OGX deployment."""
+    return f"{str(ogx_client.base_url).rstrip('/')}/v1"
+
+
+@pytest.fixture(scope="class")
+def codex_openai_client(codex_base_url: str) -> Generator[OpenAI, None, None]:
+    """Return an OpenAI SDK client pointed at the OGX deployment."""
+    client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+    try:
+        yield client
+    finally:
+        client.close()
+
+
+@pytest.fixture(scope="class")
+def codex_http_session() -> Generator[requests.Session, None, None]:
+    """Return a requests session configured for the OGX route."""
+    with requests.Session() as session:
+        session.verify = OGX_CLIENT_VERIFY_SSL
+        yield session
+
+
+@pytest.fixture(scope="class")
+def codex_model(ogx_models: ModelInfo) -> str:
+    """Return the model id selected for Codex SDK tests."""
+    return ogx_models.model_id
+
+
+@pytest.fixture(scope="class")
+def codex_tools() -> list[dict[str, Any]]:
+    """Return the six Codex CLI tool definitions."""
+    return codex_tool_definitions()
+
+
+@pytest.fixture
+def codex_session_id() -> str:
+    """Return a unique server-side session id."""
+    return str(uuid.uuid4())
