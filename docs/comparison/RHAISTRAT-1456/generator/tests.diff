+from kubernetes.dynamic import DynamicClient
+from ocp_resources.deployment import Deployment
+from ocp_resources.network_policy import NetworkPolicy
+from ocp_resources.pod import Pod
+from ocp_resources.service import Service
+from ogx_client import OgxClient
+import pytest
+
+from tests.ogx.constants import POSTGRESQL_USER
+from utilities.resources.ogx_server import OgxServer
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-infra", "randomize_name": True}, id="ogx-codex-infra")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkInfrastructure:
+    """Infrastructure tests for the OGX Codex SDK deployment."""
+
+    @pytest.mark.tier1
+    def test_tc_infra_001(
+        self,
+        ogx_client: OgxClient,
+        ogx_server: OgxServer,
+        ogx_server_deployment: Deployment,
+        ogx_test_route: object,
+        postgres_service: Service,
+        postgres_deployment: Deployment,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-INFRA-001: Verify OGX and PostgreSQL resources are healthy."""
+        assert ogx_server_deployment.instance is not None, "OGX Deployment was not created"
+        assert postgres_deployment.instance is not None, "PostgreSQL Deployment was not created"
+        assert ogx_test_route is not None, "OGX Route was not created"
+
+        service_ports = [port.port for port in postgres_service.instance.spec.ports]
+        assert 5432 in service_ports, f"PostgreSQL Service does not expose port 5432: {service_ports}"
+
+        ogx_pods = list(
+            Pod.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                label_selector="app=ogx",
+                raw=True,
+            )
+        )
+        assert ogx_pods, "No OGX pod was found"
+        assert all(pod.status.phase == "Running" for pod in ogx_pods), "Not all OGX pods are Running"
+
+        postgres_pods = list(
+            Pod.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                label_selector="app=postgres",
+                raw=True,
+            )
+        )
+        assert postgres_pods, "No PostgreSQL pod was found"
+        assert all(pod.status.phase == "Running" for pod in postgres_pods), "Not all PostgreSQL pods are Running"
+
+        ogx_client.inspect.health()
+        postgres_pod = Pod(
+            client=unprivileged_client,
+            namespace=ogx_server.namespace,
+            name=postgres_pods[0].metadata.name,
+        )
+        tables = postgres_pod.execute(
+            command=["psql", "-U", POSTGRESQL_USER, "-d", "ps_db", "-c", "\\dt"],
+            timeout=30,
+        )
+        assert tables is not None, "PostgreSQL did not return a table listing"
+
+    @pytest.mark.tier1
+    def test_tc_infra_002(
+        self,
+        ogx_client: OgxClient,
+        ogx_server: OgxServer,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-INFRA-002: Verify Memories and Compaction providers are active."""
+        provider_types = {provider.provider_type for provider in ogx_client.providers.list()}
+        assert "memory" in provider_types, "Memories provider is not active"
+        assert "compaction" in provider_types, "Compaction provider is not active"
+
+        ogx_pods = list(
+            Pod.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                label_selector="app=ogx",
+                raw=True,
+            )
+        )
+        assert ogx_pods, "No OGX pod was found"
+        logs = ogx_pods[0].log(container="ogx")
+        assert "memory" in logs.lower(), "OGX startup logs do not mention the Memories provider"
+        assert "compaction" in logs.lower(), "OGX startup logs do not mention the Compaction provider"
+
+    @pytest.mark.tier2
+    def test_tc_infra_003(
+        self,
+        ogx_server: OgxServer,
+        ogx_server_deployment: Deployment,
+        postgres_service: Service,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-INFRA-003: Verify NetworkPolicies allow OGX to PostgreSQL and block other pods."""
+        policies = list(
+            NetworkPolicy.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                raw=True,
+            )
+        )
+        assert policies, "No NetworkPolicies were found in the OGX namespace"
+
+        ogx_pods = list(
+            Pod.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                label_selector="app=ogx",
