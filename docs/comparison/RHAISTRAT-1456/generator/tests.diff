+from kubernetes.dynamic import DynamicClient
+from ocp_resources.pod import Pod
+from openai import OpenAI
+from openai.types.chat import ChatCompletion
+import uuid
+import pytest
+
+from tests.ogx.utils import wait_for_unique_ogx_pod
+from tests.ogx_codex_sdk.utils import create_chat_completion, extract_content, extract_tool_calls, validate_tool_call
+from utilities.resources.ogx_server import OgxServer
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-sess", "randomize_name": True}, id="ogx-codex-sess")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkSessions:
+    """Session persistence and isolation tests for the OGX Codex SDK."""
+
+    @pytest.mark.tier1
+    def test_tc_sess_001(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-SESS-001: Verify server-side state persists across six tool calls."""
+        workflow = [
+            ("read_file", {"path"}, "Read README.md and remember its first heading."),
+            ("grep_search", {"pattern"}, "Search for the heading you just read and remember the match."),
+            ("edit_file", {"path", "old_text", "new_text"}, "Update that heading and remember the edit."),
+            ("bash", {"command"}, "Run pytest and remember the result."),
+            ("read_file", {"path"}, "Read the updated heading and remember the verification."),
+        ]
+        for tool_name, required_fields, prompt in workflow:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": tool_name}},
+                max_tokens=256,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for {tool_name}"
+            validate_tool_call(tool_calls[0], tool_name, required_fields)
+
+        completion = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "Summarize the five previous actions without resending history."}],
+            session_id=codex_session_id,
+            max_tokens=320,
+        )
+        summary = extract_content(completion)
+        for expected in ("read", "grep", "edit", "pytest", "verification"):
+            assert expected in summary.lower(), f"Session state lost workflow detail: {expected}"
+
+    @pytest.mark.tier1
+    def test_tc_sess_002(
+        self,
+        codex_base_url: str,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+        ogx_server: OgxServer,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-SESS-002: Verify a session resumes after an OGX pod restart."""
+        initial_client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+        try:
+            for prompt in (
+                "Read README.md and remember its first heading.",
+                "Search for that heading and remember the match.",
+                "Edit that heading and remember the change.",
+            ):
+                completion = create_chat_completion(
+                    initial_client,
+                    model=codex_model,
+                    messages=[{"role": "user", "content": prompt}],
+                    session_id=codex_session_id,
+                    tools=codex_tools,
+                    max_tokens=256,
+                )
+                assert completion.choices, "Pre-disruption session turn returned no choices"
+        finally:
+            initial_client.close()
+
+        original_pod = wait_for_unique_ogx_pod(client=unprivileged_client, namespace=ogx_server.namespace)
+        original_pod.delete(wait=True)
+        replacement_pod = wait_for_unique_ogx_pod(client=unprivileged_client, namespace=ogx_server.namespace)
+        assert isinstance(replacement_pod, Pod)
+        assert replacement_pod.name != original_pod.name, "OGX did not replace the disrupted pod"
+
+        reconnected_client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+        try:
+            completion = create_chat_completion(
+                reconnected_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": "Describe the edit you made earlier in this session."}],
+                session_id=codex_session_id,
+                max_tokens=256,
+            )
+            summary = extract_content(completion)
+            assert "edit" in summary.lower(), "Restarted session lost the earlier edit context"
+        finally:
+            reconnected_client.close()
+
+    @pytest.mark.tier2
+    def test_tc_sess_003(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-SESS-003: Verify concurrent sessions do not cross-contaminate context."""
+        session_a = f"repo-a-session-{uuid.uuid4()}"
+        session_b = f"repo-b-session-{uuid.uuid4()}"
+        prompts = {
+            session_a: "Read repo-a/main.py and remember the file name.",
+            session_b: "Read repo-b/server.js and remember the file name.",
+        }
+        for session_id, prompt in prompts.items():
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=session_id,
+                tools=codex_tools,
+                max_tokens=256,
+            )
+            assert completion.choices, f"Session {session_id} returned no choices"
+
+        followups = {
+            session_a: "What file did I just read?",
+            session_b: "What file did I just read?",
+        }
+        summaries: dict[str, str] = {}
+        for session_id, prompt in followups.items():
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=session_id,
+                max_tokens=128,
+            )
+            summaries[session_id] = extract_content(completion)
+
+        assert "repo-a/main.py" in summaries[session_a], "Session A lost its own file context"
+        assert "repo-b/server.js" in summaries[session_b], "Session B lost its own file context"
+        assert "repo-b/server.js" not in summaries[session_a], "Session B context leaked into Session A"
+        assert "repo-a/main.py" not in summaries[session_b], "Session A context leaked into Session B"
+
+    @pytest.mark.tier3
+    def test_tc_sess_004(
+        self,
+        codex_base_url: str,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-SESS-004: Verify invalid and unauthorized session ids return safe errors."""
+        owner_client = OpenAI(
+            base_url=codex_base_url,
+            api_key="ogx-tests",
+            max_retries=0,
+            default_headers={"x-user-id": "user-a", "x-tenant-id": "tenant-alpha"},
+        )
+        other_client = OpenAI(
+            base_url=codex_base_url,
+            api_key="ogx-tests",
+            max_retries=0,
+            default_headers={"x-user-id": "user-b", "x-tenant-id": "tenant-beta"},
+        )
+        try:
+            owned_session_id = f"owned-session-{uuid.uuid4()}"
+            completion = create_chat_completion(
+                owner_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": "Read README.md and remember the heading."}],
+                session_id=owned_session_id,
+                tools=codex_tools,
+                max_tokens=256,
+            )
+            assert isinstance(completion, ChatCompletion)
+
+            invalid_session_id = "00000000-0000-0000-0000-000000000000"
+            invalid_completions = []
+            for client, session_id in (
+                (owner_client, invalid_session_id),
+                (other_client, owned_session_id),
+            ):
+                try:
+                    create_chat_completion(
+                        client,
+                        model=codex_model,
+                        messages=[{"role": "user", "content": "Read README.md."}],
+                        session_id=session_id,
+                        tools=codex_tools,
+                        max_tokens=128,
+                    )
+                except Exception as error:
+                    invalid_completions.append(error)
+                else:
+                    pytest.fail("Invalid or unauthorized session access unexpectedly succeeded")
+
+            assert len(invalid_completions) == 2, "Expected both invalid and unauthorized session access to fail"
+            for error in invalid_completions:
+                response = getattr(error, "response", None)
+                assert response is not None, "Session error did not include an HTTP response"
+                assert response.status_code in (404, 422), f"Unexpected session error status: {response.status_code}"
+                error_body = response.json()
+                assert isinstance(error_body, dict), "Session error body is not a JSON object"
+                error_text = str(error_body).lower()
+                for forbidden in ("traceback", "select ", "sql", "exception", "schema"):
+                    assert forbidden not in error_text, f"Session error leaked internal detail: {forbidden}"
+        finally:
+            owner_client.close()
+            other_client.close()
