@@ -0,0 +1,162 @@
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import math
+import os
+import time
+import uuid
+
+from openai import OpenAI
+import pytest
+
+from tests.ogx_codex_sdk.utils import create_chat_completion, percentile
+
+
+def _sample_size() -> int:
+    return int(os.getenv("OGX_CODEX_PERF_SAMPLE_SIZE", "100"))
+
+
+def _ttft_budget_ms() -> float:
+    return float(os.getenv("OGX_CODEX_TTFT_BUDGET_MS", "5000"))
+
+
+def _proxy_overhead_budget_ms() -> float:
+    return float(os.getenv("OGX_CODEX_PROXY_OVERHEAD_BUDGET_MS", "1000"))
+
+
+def _session_retrieval_budget_ms() -> float:
+    return float(os.getenv("OGX_CODEX_SESSION_RETRIEVAL_BUDGET_MS", "2000"))
+
+
+def _measure_ttft_ms(
+    client: OpenAI,
+    model: str,
+    messages: list[dict[str, str]],
+    tools: list[dict[str, object]] | None = None,
+) -> float:
+    start = time.perf_counter()
+    stream = create_chat_completion(
+        client,
+        model=model,
+        messages=messages,
+        tools=tools,
+        stream=True,
+        max_tokens=128,
+        timeout=30,
+    )
+    first_chunk = next(iter(stream))
+    elapsed_ms = (time.perf_counter() - start) * 1000
+    assert first_chunk.choices is not None, "Streaming response returned no choices"
+    stream.close()
+    return elapsed_ms
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-perf", "randomize_name": True}, id="ogx-codex-perf")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkPerformance:
+    """Performance tests for the OGX Codex SDK."""
+
+    @pytest.mark.slow
+    @pytest.mark.tier2
+    def test_tc_perf_001(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-PERF-001: Verify streaming TTFT stays within the configured budget."""
+        sample_size = _sample_size()
+        simple_prompt = [{"role": "user", "content": "Explain what a Kubernetes pod is in one sentence."}]
+        simple_ttft = [
+            _measure_ttft_ms(codex_openai_client, codex_model, simple_prompt) for _ in range(sample_size)
+        ]
+        tool_prompt = [{"role": "user", "content": "List the files in the current directory."}]
+        tool_ttft = [
+            _measure_ttft_ms(codex_openai_client, codex_model, tool_prompt, codex_tools)
+            for _ in range(sample_size)
+        ]
+
+        for values in (simple_ttft, tool_ttft):
+            assert all(math.isfinite(value) for value in values), "TTFT contained NaN or infinity"
+            assert percentile(values, 95) <= _ttft_budget_ms(), "P95 TTFT exceeded the configured budget"
+
+    @pytest.mark.slow
+    @pytest.mark.tier2
+    def test_tc_perf_002(
+        self,
+        codex_base_url: str,
+        codex_model: str,
+    ) -> None:
+        """TC-PERF-002: Verify the OGX proxy adds bounded latency over direct vLLM."""
+        direct_base_url = os.getenv("OGX_CODEX_VLLM_BASE_URL")
+        if not direct_base_url:
+            pytest.skip("Set OGX_CODEX_VLLM_BASE_URL to compare OGX with direct vLLM")
+
+        direct_client = OpenAI(base_url=direct_base_url, api_key="ogx-tests", max_retries=0)
+        proxied_client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+        try:
+            sample_size = _sample_size()
+            prompt = [{"role": "user", "content": "What is 2 + 2?"}]
+            overhead_ms: list[float] = []
+            for _ in range(sample_size):
+                direct_ttft = _measure_ttft_ms(direct_client, codex_model, prompt)
+                proxied_ttft = _measure_ttft_ms(proxied_client, codex_model, prompt)
+                overhead_ms.append(proxied_ttft - direct_ttft)
+        finally:
+            direct_client.close()
+            proxied_client.close()
+
+        assert all(math.isfinite(value) for value in overhead_ms), "Proxy overhead contained NaN or infinity"
+        assert percentile(overhead_ms, 95) <= _proxy_overhead_budget_ms(), (
+            "P95 proxy overhead exceeded the configured budget"
+        )
+
+    @pytest.mark.slow
+    @pytest.mark.tier2
+    def test_tc_perf_003(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-PERF-003: Verify PostgreSQL session retrieval stays bounded under load."""
+        session_count = _sample_size()
+        turn_count = 10
+        latencies_ms: list[float] = []
+
+        def run_session(session_index: int) -> list[float]:
+            session_id = f"perf-session-{session_index}-{uuid.uuid4()}"
+            session_latencies: list[float] = []
+            for turn_index in range(turn_count):
+                start = time.perf_counter()
+                completion = create_chat_completion(
+                    codex_openai_client,
+                    model=codex_model,
+                    messages=[
+                        {
+                            "role": "user",
+                            "content": f"Turn {turn_index}: run `echo session-{session_index}-turn-{turn_index}`.",
+                        }
+                    ],
+                    session_id=session_id,
+                    tools=codex_tools,
+                    tool_choice={"type": "function", "function": {"name": "bash"}},
+                    max_tokens=128,
+                    timeout=30,
+                )
+                session_latencies.append((time.perf_counter() - start) * 1000)
+                assert completion.choices, f"Session {session_index} turn {turn_index} returned no choices"
+            return session_latencies
+
+        with ThreadPoolExecutor(max_workers=min(20, session_count)) as executor:
+            futures = [executor.submit(run_session, index) for index in range(session_count)]
+            for future in as_completed(futures):
+                latencies_ms.extend(future.result())
+
+        assert len(latencies_ms) == session_count * turn_count, "Some concurrent session turns did not complete"
+        assert all(math.isfinite(value) for value in latencies_ms), "Session latency contained NaN or infinity"
+        assert percentile(latencies_ms, 95) <= _session_retrieval_budget_ms(), (
+            "P95 session retrieval latency exceeded the configured budget"
+        )
