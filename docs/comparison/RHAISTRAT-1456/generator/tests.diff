+from concurrent.futures import ThreadPoolExecutor, as_completed
+import uuid
+
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.pod import Pod
+from openai import OpenAI
+import pytest
+
+from tests.ogx.utils import wait_for_unique_ogx_pod
+from tests.ogx_codex_sdk.utils import create_chat_completion, extract_content, extract_tool_calls, validate_tool_call
+from utilities.resources.ogx_server import OgxServer
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-e2e", "randomize_name": True}, id="ogx-codex-e2e")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkEndToEnd:
+    """End-to-end tests for the OGX Codex SDK workflow."""
+
+    @pytest.mark.tier1
+    def test_tc_e2e_001(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-E2E-001: Verify a complete coding workflow persists across tool calls."""
+        workflow = [
+            ("bash", {"command"}, "Run pytest and remember the failing calculator test."),
+            ("read_file", {"path"}, "Read test_calculator.py and remember the failing assertion."),
+            ("grep_search", {"pattern"}, "Search for the calculator bug and remember the matching line."),
+            ("edit_file", {"path", "old_text", "new_text"}, "Fix calculator.py and remember the edited function."),
+            ("bash", {"command"}, "Run pytest again and remember the passing result."),
+        ]
+        for tool_name, required_fields, prompt in workflow:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": tool_name}},
+                max_tokens=256,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for {tool_name}"
+            validate_tool_call(tool_calls[0], tool_name, required_fields)
+
+        completion = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "Summarize the five actions you just completed."}],
+            session_id=codex_session_id,
+            max_tokens=320,
+        )
+        summary = extract_content(completion)
+        for expected in ("pytest", "test_calculator.py", "calculator.py", "fix", "passing"):
+            assert expected in summary.lower(), f"Session summary lost workflow detail: {expected}"
+
+    @pytest.mark.tier1
+    def test_tc_e2e_002(
+        self,
+        codex_base_url: str,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+        ogx_server: OgxServer,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-E2E-002: Verify session context survives an OGX pod restart."""
+        initial_client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+        try:
+            for prompt in (
+                "Run pytest and remember the failing calculator test.",
+                "Read test_calculator.py and remember the assertion.",
+                "Search for the calculator bug and remember the matching line.",
+            ):
+                completion = create_chat_completion(
+                    initial_client,
+                    model=codex_model,
+                    messages=[{"role": "user", "content": prompt}],
+                    session_id=codex_session_id,
+                    tools=codex_tools,
+                    max_tokens=256,
+                )
+                assert completion.choices, "Pre-disruption turn returned no choices"
+        finally:
+            initial_client.close()
+
+        original_pod = wait_for_unique_ogx_pod(client=unprivileged_client, namespace=ogx_server.namespace)
+        original_pod.delete(wait=True)
+        replacement_pod = wait_for_unique_ogx_pod(client=unprivileged_client, namespace=ogx_server.namespace)
+        assert isinstance(replacement_pod, Pod)
+        assert replacement_pod.name != original_pod.name, "OGX did not create a replacement pod"
+
+        reconnected_client = OpenAI(base_url=codex_base_url, api_key="ogx-tests", max_retries=0)
+        try:
+            completion = create_chat_completion(
+                reconnected_client,
+                model=codex_model,
+                messages=[
+                    {
+                        "role": "user",
+                        "content": "Based on the calculator error you found earlier, describe the failing assertion and fix the source file.",
+                    }
+                ],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                max_tokens=320,
+            )
+            summary = extract_content(completion)
+            assert "calculator" in summary.lower(), "Restarted session lost the earlier calculator context"
+        finally:
+            reconnected_client.close()
+
+    @pytest.mark.tier1
+    def test_tc_e2e_003(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-E2E-003: Verify all six Codex CLI tools produce valid JSON arguments."""
+        workflow = [
+            ("glob_search", {"pattern"}, "Find all Python files in the project."),
+            ("grep_search", {"pattern"}, "Search for functions without docstrings."),
+            ("read_file", {"path"}, "Read the first source file you found."),
+            ("edit_file", {"path", "old_text", "new_text"}, "Add a docstring to that function."),
+            ("write_file", {"path", "content"}, "Write a new test file for that function."),
+            ("bash", {"command"}, "Run the new test file with pytest."),
+        ]
+        for tool_name, required_fields, prompt in workflow:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": tool_name}},
+                max_tokens=256,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for {tool_name}"
+            validate_tool_call(tool_calls[0], tool_name, required_fields)
+
+        completion = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "Name each of the six tools you used in this session."}],
+            session_id=codex_session_id,
+            max_tokens=256,
+        )
+        summary = extract_content(completion)
+        for tool_name in ("bash", "read_file", "write_file", "edit_file", "grep_search", "glob_search"):
+            assert tool_name in summary, f"Session summary omitted tool {tool_name}"
+
+    @pytest.mark.tier2
+    def test_tc_e2e_004(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-E2E-004: Verify concurrent Codex sessions remain isolated."""
+        sessions = {
+            str(uuid.uuid4()): ("repo-alpha", "alpha-isolation-marker"),
+            str(uuid.uuid4()): ("repo-beta", "beta-isolation-marker"),
+            str(uuid.uuid4()): ("repo-gamma", "gamma-isolation-marker"),
+        }
+
+        def run_session(session_id: str, repo_name: str, marker: str) -> None:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[
+                    {
+                        "role": "user",
+                        "content": f"In {repo_name}, read main.py, add error handling, and remember {marker}.",
+                    }
+                ],
+                session_id=session_id,
+                tools=codex_tools,
+                max_tokens=320,
+            )
+            assert completion.choices, f"Session for {repo_name} returned no choices"
+
+        with ThreadPoolExecutor(max_workers=3) as executor:
+            futures = [
+                executor.submit(run_session, session_id, repo_name, marker)
+                for session_id, (repo_name, marker) in sessions.items()
+            ]
+            for future in as_completed(futures):
+                future.result()
+
+        for session_id, (repo_name, marker) in sessions.items():
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": "Which repository and marker did this session use?"}],
+                session_id=session_id,
+                max_tokens=128,
+            )
+            summary = extract_content(completion)
+            assert repo_name in summary, f"Session for {repo_name} lost its repository context"
+            assert marker in summary, f"Session for {repo_name} lost its marker"
+            for other_repo, other_marker in sessions.values():
+                if other_repo != repo_name:
+                    assert other_marker not in summary, f"Session for {repo_name} leaked marker {other_marker}"
