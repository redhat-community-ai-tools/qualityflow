+import json
+
+from openai import OpenAI
+import pytest
+import requests
+
+from tests.ogx_codex_sdk.utils import collect_raw_sse, collect_stream_chunks, create_chat_completion, extract_tool_calls, validate_tool_call
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-stream", "randomize_name": True}, id="ogx-codex-stream")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkStreaming:
+    """Streaming behavior tests for the OGX Codex SDK."""
+
+    @pytest.mark.tier1
+    def test_tc_stream_001(
+        self,
+        codex_base_url: str,
+        codex_http_session: requests.Session,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-STREAM-001: Verify SSE deltas contain incremental tool-call arguments."""
+        response = codex_http_session.post(
+            f"{codex_base_url}/chat/completions",
+            json={
+                "model": codex_model,
+                "messages": [{"role": "user", "content": "List the files in the current directory."}],
+                "tools": codex_tools,
+                "tool_choice": {"type": "function", "function": {"name": "bash"}},
+                "stream": True,
+                "temperature": 0,
+                "max_tokens": 256,
+            },
+            timeout=60,
+            stream=True,
+        )
+        response.raise_for_status()
+        events = collect_raw_sse(response)
+        assert events, "SSE stream returned no events"
+
+        tool_argument_fragments: list[str] = []
+        for event in events:
+            for choice in event.get("choices", []):
+                for tool_call in choice.get("delta", {}).get("tool_calls", []):
+                    function = tool_call.get("function", {})
+                    if function.get("arguments"):
+                        tool_argument_fragments.append(function["arguments"])
+        assert tool_argument_fragments, "SSE stream contained no tool-call argument fragments"
+        assert len(tool_argument_fragments) > 1, "Tool-call arguments were not streamed incrementally"
+        json.loads("".join(tool_argument_fragments))
+
+    @pytest.mark.tier1
+    def test_tc_stream_002(
