+import json
+import math
+from collections.abc import Generator, Sequence
+from typing import Any
+
+import requests
+from openai import OpenAI, Stream
+from openai.types.chat import ChatCompletion, ChatCompletionChunk
+
+
+def codex_tools() -> list[dict[str, Any]]:
+    """Return the six Codex CLI tool definitions used by the tests."""
+    return [
+        {
+            "type": "function",
+            "function": {
+                "name": "bash",
+                "description": "Run a shell command.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"command": {"type": "string"}},
+                    "required": ["command"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "read_file",
+                "description": "Read a file from disk.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"path": {"type": "string"}},
+                    "required": ["path"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "write_file",
+                "description": "Write a file to disk.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {
+                        "path": {"type": "string"},
+                        "content": {"type": "string"},
+                    },
+                    "required": ["path", "content"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "edit_file",
+                "description": "Edit an existing file.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {
+                        "path": {"type": "string"},
+                        "old_text": {"type": "string"},
+                        "new_text": {"type": "string"},
+                    },
+                    "required": ["path", "old_text", "new_text"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "grep_search",
+                "description": "Search file contents with a regular expression.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"pattern": {"type": "string"}},
+                    "required": ["pattern"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": "glob_search",
+                "description": "Find files matching a glob pattern.",
+                "parameters": {
+                    "type": "object",
+                    "properties": {"pattern": {"type": "string"}},
+                    "required": ["pattern"],
+                    "additionalProperties": False,
+                },
+            },
+        },
+    ]
+
+
+def create_chat_completion(
+    client: OpenAI,
+    *,
+    model: str,
+    messages: list[dict[str, str]],
+    session_id: str | None = None,
+    tools: list[dict[str, Any]] | None = None,
+    tool_choice: dict[str, Any] | str | None = None,
+    stream: bool = False,
+    temperature: float = 0.0,
+    max_tokens: int = 512,
+    timeout: float = 120.0,
+) -> ChatCompletion | Stream[ChatCompletionChunk]:
+    """Create a chat completion with the optional Codex session id."""
+    kwargs: dict[str, Any] = {
+        "model": model,
+        "messages": messages,
+        "temperature": temperature,
+        "max_tokens": max_tokens,
+        "timeout": timeout,
+    }
+    if session_id is not None:
+        kwargs["extra_body"] = {"session_id": session_id}
+    if tools is not None:
+        kwargs["tools"] = tools
+    if tool_choice is not None:
+        kwargs["tool_choice"] = tool_choice
+    if stream:
+        kwargs["stream"] = True
+    return client.chat.completions.create(**kwargs)
+
+
+def extract_content(completion: ChatCompletion) -> str:
+    """Return the first choice's assistant content."""
+    assert completion.choices, "Chat completion returned no choices"
+    content = completion.choices[0].message.content
+    assert content is not None, "Chat completion returned no content"
+    return content
+
+
+def extract_tool_calls(completion: ChatCompletion) -> list[dict[str, Any]]:
+    """Return the first choice's tool calls as dictionaries."""
+    assert completion.choices, "Chat completion returned no choices"
+    tool_calls = completion.choices[0].message.tool_calls
+    return [tool_call.model_dump() for tool_call in tool_calls or []]
+
+
+def validate_tool_call(tool_call: dict[str, Any], expected_name: str, required_fields: set[str]) -> dict[str, Any]:
+    """Validate a tool call name and JSON arguments."""
+    function = tool_call["function"]
+    assert function["name"] == expected_name, f"Expected {expected_name}, got {function['name']}"
+    arguments = json.loads(function["arguments"])
+    assert isinstance(arguments, dict), "Tool call arguments are not a JSON object"
+    missing = required_fields - arguments.keys()
+    assert not missing, f"Tool call is missing required fields: {sorted(missing)}"
+    return arguments
+
+
+def collect_stream_chunks(stream: Stream[ChatCompletionChunk], max_chunks: int = 10_000) -> list[dict[str, Any]]:
+    """Collect a bounded stream of chat completion chunks."""
+    chunks: list[dict[str, Any]] = []
+    for chunk in stream:
+        if len(chunks) >= max_chunks:
+            raise AssertionError(f"SSE stream exceeded the maximum of {max_chunks} chunks")
+        chunks.append(chunk.model_dump())
+    return chunks
+
+
+def iter_sse_lines(response: requests.Response) -> Generator[str]:
+    """Yield decoded SSE data lines from a streaming HTTP response."""
+    for raw_line in response.iter_lines(decode_unicode=True):
+        if raw_line is None:
+            continue
+        line = raw_line.strip()
+        if not line:
+            continue
+        if not line.startswith("data:"):
+            raise AssertionError(f"SSE line does not start with 'data:': {line!r}")
+        yield line[len("data:") :].strip()
+
+
+def collect_raw_sse(response: requests.Response, max_events: int = 10_000) -> list[dict[str, Any]]:
+    """Collect a bounded raw SSE stream and require a terminal DONE event."""
+    events: list[dict[str, Any]] = []
+    for event_count, data in enumerate(iter_sse_lines(response), start=1):
+        if event_count > max_events:
+            raise AssertionError(f"SSE stream exceeded the maximum of {max_events} events")
+        if data == "[DONE]":
+            return events
+        events.append(json.loads(data))
+    raise AssertionError("SSE stream ended without a '[DONE]' event")
+
+
+def percentile(values: Sequence[float], requested_percentile: float) -> float:
+    """Return a linearly interpolated percentile from a non-empty sample."""
+    if not values:
+        raise AssertionError("Cannot calculate a percentile from an empty sample")
+    if not 0 <= requested_percentile <= 100:
+        raise AssertionError(f"Percentile must be between 0 and 100, got {requested_percentile}")
+    ordered = sorted(values)
+    if len(ordered) == 1 or requested_percentile == 0:
+        return ordered[0]
+    if requested_percentile == 100:
+        return ordered[-1]
+    rank = (len(ordered) - 1) * requested_percentile / 100
+    lower_index = math.floor(rank)
+    upper_index = math.ceil(rank)
+    if lower_index == upper_index:
+        return ordered[lower_index]
+    fraction = rank - lower_index
+    return ordered[lower_index] + (ordered[upper_index] - ordered[lower_index]) * fraction
