+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+import pytest
+from ogx_client import OgxClient
+from openai import OpenAI
+
+from tests.ogx_codex_sdk.utils import create_chat_completion, extract_content, extract_tool_calls, validate_tool_call
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-compact", "randomize_name": True}, id="ogx-codex-compact")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkCompact:
+    """Tests for OGX Codex SDK conversation compaction."""
+
+    @pytest.mark.tier1
+    def test_tc_compact_001(
+        self,
+        ogx_client: OgxClient,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-COMPACT-001: Verify automatic compaction preserves long-session context."""
+        provider_types = {provider.provider_type for provider in ogx_client.providers.list()}
+        assert "compaction" in provider_types, "The compaction provider is not active"
+
+        markers = [f"compact-marker-{index:02d}" for index in range(24)]
+        for marker in markers:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": f"Run `echo {marker}` and remember the output."}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                tool_choice={"type": "function", "function": {"name": "bash"}},
+                max_tokens=128,
+            )
+            tool_calls = extract_tool_calls(completion)
+            assert tool_calls, f"No tool call was returned for marker {marker}"
+            validate_tool_call(tool_calls[0], "bash", {"command"})
+
+        completion = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "List the first five marker values from this session."}],
+            session_id=codex_session_id,
+            max_tokens=256,
+        )
+        summary = extract_content(completion)
+        for marker in markers[:5]:
+            assert marker in summary, f"Compacted session lost marker {marker}"
+
+    @pytest.mark.tier2
+    def test_tc_compact_002(
+        self,
+        ogx_client: OgxClient,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+        codex_session_id: str,
+    ) -> None:
+        """TC-COMPACT-002: Verify critical facts survive conversation compaction."""
+        provider_types = {provider.provider_type for provider in ogx_client.providers.list()}
+        assert "compaction" in provider_types, "The compaction provider is not active"
+
+        facts = {
+            "database hostname": "pgdb-prod-03.internal",
+            "refused port": "6379",
+            "retry limit": "7",
+            "diff file": "/tmp/patch-0612.diff",
+            "renamed function": "process_batch_v2",
+        }
+        prompts = [
+            "Read /app/config.yaml and remember db_host: pgdb-prod-03.internal.",
+            "Run a command that fails with ConnectionRefusedError on port 6379.",
+            "Search retry_handler.py and remember MAX_RETRIES = 7.",
+            "Create /tmp/patch-0612.diff.",
+            "Rename process_batch to process_batch_v2 in worker.py.",
+        ]
+        for prompt in prompts:
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": prompt}],
+                session_id=codex_session_id,
+                tools=codex_tools,
+                max_tokens=192,
+            )
+            assert completion.choices, "Compaction turn returned no choices"
+
+        completion = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[
+                {
+                    "role": "user",
+                    "content": "Answer with one line per fact: database hostname, refused port, retry limit, diff file, renamed function.",
+                }
+            ],
+            session_id=codex_session_id,
+            max_tokens=256,
+        )
+        summary = extract_content(completion)
+        for label, expected in facts.items():
+            assert expected in summary, f"Compacted session lost {label}: {expected}"
+
+    @pytest.mark.tier2
+    def test_tc_compact_003(
+        self,
+        ogx_client: OgxClient,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+        codex_tools: list[dict[str, object]],
+    ) -> None:
+        """TC-COMPACT-003: Verify compaction in one session does not affect another."""
+        provider_types = {provider.provider_type for provider in ogx_client.providers.list()}
+        assert "compaction" in provider_types, "The compaction provider is not active"
+
+        sessions = {
+            "session-a": [f"alpha-marker-{index:02d}" for index in range(18)],
+            "session-b": [f"beta-marker-{index:02d}" for index in range(18)],
+        }
+
+        def run_session(session_id: str, markers: list[str]) -> None:
+            for marker in markers:
+                completion = create_chat_completion(
+                    codex_openai_client,
+                    model=codex_model,
+                    messages=[{"role": "user", "content": f"Run `echo {marker}` and remember the output."}],
+                    session_id=session_id,
+                    tools=codex_tools,
+                    tool_choice={"type": "function", "function": {"name": "bash"}},
+                    max_tokens=128,
+                )
+                tool_calls = extract_tool_calls(completion)
+                assert tool_calls, f"Session {session_id} returned no tool call for {marker}"
+
+        with ThreadPoolExecutor(max_workers=2) as executor:
+            futures = [executor.submit(run_session, session_id, markers) for session_id, markers in sessions.items()]
+            for future in as_completed(futures):
+                future.result()
+
+        for session_id, markers in sessions.items():
+            completion = create_chat_completion(
+                codex_openai_client,
+                model=codex_model,
+                messages=[{"role": "user", "content": "List the first three marker values from this session."}],
+                session_id=session_id,
+                max_tokens=192,
+            )
+            summary = extract_content(completion)
+            for marker in markers[:3]:
+                assert marker in summary, f"Session {session_id} lost marker {marker}"
+            other_markers = next(values for key, values in sessions.items() if key != session_id)
+            for marker in other_markers[:3]:
+                assert marker not in summary, f"Session {session_id} leaked marker {marker}"
