+import uuid
+
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.deployment import Deployment
+from ocp_resources.pod import Pod
+from ocp_resources.pod_disruption_budget import PodDisruptionBudget
+from ocp_resources.resource import ResourceEditor
+from openai import OpenAI
+import pytest
+
+from tests.ogx_codex_sdk.utils import create_chat_completion, extract_content
+from utilities.resources.ogx_server import OgxServer
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [pytest.param({"name": "test-ogx-codex-regr", "randomize_name": True}, id="ogx-codex-regr")],
+    indirect=True,
+)
+@pytest.mark.ogx
+class TestOgxCodexSdkRegression:
+    """Regression tests for existing OpenAI clients and OGX rollout behavior."""
+
+    @pytest.mark.tier1
+    def test_tc_regr_001(
+        self,
+        codex_openai_client: OpenAI,
+        codex_model: str,
+    ) -> None:
+        """TC-REGR-001: Verify standard OpenAI SDK clients remain compatible."""
+        non_streaming = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "Reply with the single word ACK."}],
+            max_tokens=32,
+        )
+        assert non_streaming.choices, "Non-streaming completion returned no choices"
+        content = extract_content(non_streaming)
+        assert "ACK" in content, "Non-streaming completion did not return ACK"
+        assert not hasattr(non_streaming, "session_id"), "Non-streaming response leaked a Codex-specific field"
+
+        streaming = create_chat_completion(
+            codex_openai_client,
+            model=codex_model,
+            messages=[{"role": "user", "content": "Reply with the single word ACK."}],
+            stream=True,
+            max_tokens=32,
+        )
+        chunks = list(streaming)
+        assert chunks, "Streaming completion returned no chunks"
+        assembled_content = "".join(
+            chunk.choices[0].delta.content or "" for chunk in chunks if chunk.choices and chunk.choices[0].delta
+        )
+        assert "ACK" in assembled_content, "Streaming completion did not assemble ACK"
+
+    @pytest.mark.tier2
+    def test_tc_regr_002(
+        self,
+        ogx_server: OgxServer,
+        ogx_server_deployment: Deployment,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """TC-REGR-002: Verify HPA and PodDisruptionBudget survive an OGX rollout."""
+        hpa_resource = unprivileged_client.resources.get(api_version="autoscaling/v2", kind="HorizontalPodAutoscaler")
+        hpas = hpa_resource.get(namespace=ogx_server.namespace).items
+        assert hpas, "No HorizontalPodAutoscaler was found for the OGX deployment"
+
+        pdbs = list(
+            PodDisruptionBudget.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                raw=True,
+            )
+        )
+        assert pdbs, "No PodDisruptionBudget was found in the OGX namespace"
+
+        rollout_id = str(uuid.uuid4())
+        ResourceEditor(
+            patches={
+                ogx_server_deployment: {
+                    "metadata": {"annotations": {"ogx.io/test-rollout": rollout_id}},
+                }
+            }
+        ).update()
+        ogx_server_deployment.wait_for_replicas(deployed=True, timeout=240)
+
+        pods = list(
+            Pod.get(
+                client=unprivileged_client,
+                namespace=ogx_server.namespace,
+                label_selector="app=ogx",
+                raw=True,
+            )
+        )
+        assert pods, "No OGX pods were found after rollout"
+        ready_pods = [pod for pod in pods if pod.status.phase == "Running"]
+        assert ready_pods, "No OGX pods were Running after rollout"
