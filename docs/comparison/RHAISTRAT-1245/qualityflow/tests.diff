+    @pytest.mark.tier1
+    def test_qf_004_streaming_completion(
+        self,
+        ogx_client: OgxClient,
+        qf_gemini_model_id: str,
+    ) -> None:
+        """Scenario TS-RHAISTRAT-1245-004: streaming through completion.
+
+        STP: outputs/RHAISTRAT-1245/stp/RHAISTRAT-1245_test_plan.md
+        """
+        stream = ogx_client.chat.completions.create(
+            model=qf_gemini_model_id,
+            messages=[{"role": "user", "content": "Say hello in one sentence."}],
+            stream=True,
+            temperature=0,
+        )
+        content_parts = []
+        finish_reasons = []
+        for chunk_count, chunk in enumerate(stream, start=1):
+            assert chunk_count <= 2000, "stream did not terminate within the chunk limit"
+            if not chunk.choices:
+                continue
+            choice = chunk.choices[0]
+            if choice.delta and choice.delta.content:
+                content_parts.append(choice.delta.content)
+            if choice.finish_reason:
+                finish_reasons.append(choice.finish_reason)
+        assert content_parts
+        assert "".join(content_parts).strip()
+        assert "stop" in finish_reasons
