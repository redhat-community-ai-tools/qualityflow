+"""Deployment and packaging tests for the remote Gemini provider."""
+
+import pytest
+from ocp_resources.pod import Pod
+from ogx_client import OgxClient
+
+from tests.ogx.gemini.utils import is_gemini_provider_active, pod_env_var_is_set
+
+pytestmark = [pytest.mark.skip_on_disconnected]
+CONFIG_SEARCH_PATHS = ("/app", "/opt/app-root", "/etc/ogx", "/root/.ogx")
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-gemini-deploy", "randomize_name": True},
+            {"enable_gemini": True},
+            id="gemini",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.downstream_only
+class TestGeminiDeployment:
+    """Build, config, and operator-injection checks for remote Gemini."""
+
+    @pytest.mark.tier1
+    def test_tc_dep_001(self, ogx_client: OgxClient, ogx_gemini_pod: Pod) -> None:
+        """Verify the image ships the Gemini provider and google-genai."""
+        output = ogx_gemini_pod.execute(command=["sh", "-c", "python -c 'import google.genai' && echo IMPORT_OK"])
+        assert output.strip() == "IMPORT_OK", f"google-genai is not importable: {output!r}"
+        assert is_gemini_provider_active(ogx_client=ogx_client), "remote::gemini provider is not available"
+
+    @pytest.mark.tier1
+    def test_tc_dep_002(self, ogx_gemini_pod: Pod) -> None:
+        """Verify the distribution config contains the Gemini activation gate."""
+        search_roots = " ".join(CONFIG_SEARCH_PATHS)
+        config_files = ogx_gemini_pod.execute(
+            command=["sh", "-c", f"grep -rls 'remote::gemini' {search_roots} 2>/dev/null || true"]
+        ).strip()
+        assert config_files, "Could not locate the distribution config in the pod"
+        candidates = [line.strip() for line in config_files.splitlines() if line.strip()]
+        matched = False
+        for candidate in candidates:
+            contents = ogx_gemini_pod.execute(command=["sh", "-c", f"cat {candidate}"])
+            if "remote::gemini" in contents and ("ENABLE_GEMINI" in contents or "GEMINI_API_KEY" in contents):
+                matched = True
+                break
+        assert matched, f"No Gemini activation gate found in candidate config files: {candidates!r}"
+
+    @pytest.mark.tier1
+    def test_tc_dep_003(self, ogx_client: OgxClient, ogx_gemini_pod: Pod) -> None:
+        """Verify the operator injects GEMINI_API_KEY into the pod."""
+        assert pod_env_var_is_set(pod=ogx_gemini_pod, name="GEMINI_API_KEY"), "GEMINI_API_KEY is not set"
+        assert is_gemini_provider_active(ogx_client=ogx_client), "remote::gemini is not active"
