+"""Security tests for the remote Gemini provider."""
+
+import pytest
+from ocp_resources.pod import Pod
+from ogx_client import OgxClient
+
+from tests.ogx.constants import GEMINI_API_KEY
+from tests.ogx.gemini.utils import is_gemini_provider_active
+
+pytestmark = [pytest.mark.skip_on_disconnected]
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-gemini-security", "randomize_name": True},
+            {"enable_gemini": True},
+            id="gemini",
+        ),
+    ],
+    indirect=True,
+)
+class TestGeminiSecurity:
+    """The Gemini API key must never leak through specs, logs, or responses."""
+
+    @pytest.mark.tier2
+    def test_tc_sec_001(self, ogx_client: OgxClient, gemini_model_id: str, ogx_gemini_pod: Pod) -> None:
+        """Verify the Gemini API key is not exposed in observable outputs."""
+        containers = ogx_gemini_pod.instance.spec.containers
+        gemini_env_entries = [
+            env for container in containers for env in (container.env or []) if env.name == "GEMINI_API_KEY"
+        ]
+        assert gemini_env_entries, "GEMINI_API_KEY env var not found in the pod spec"
+        for env in gemini_env_entries:
+            assert env.value in (None, ""), "GEMINI_API_KEY is set as a plaintext value"
+            assert env.valueFrom and env.valueFrom.secretKeyRef, "GEMINI_API_KEY is not sourced from a Secret"
+        if not GEMINI_API_KEY:
+            pytest.fail(reason="Gemini API key value is unavailable; cannot verify leak prevention")
+        for container in containers:
+            logs = ogx_gemini_pod.log(container=container.name)
+            assert GEMINI_API_KEY not in logs, f"Key leaked into logs of container {container.name!r}"
+        providers_dump = str(list(ogx_client.providers.list()))
+        assert GEMINI_API_KEY not in providers_dump, "Key leaked into /v1/providers response"
+        chat = ogx_client.chat.completions.create(
+            model=gemini_model_id,
+            messages=[{"role": "user", "content": "Hello"}],
+        )
+        assert GEMINI_API_KEY not in str(chat), "Key leaked into a chat completion response"
+
+    @pytest.mark.tier3
+    def test_tc_sec_002(self, ogx_client: OgxClient) -> None:
+        """Verify outbound Gemini connections negotiate TLS 1.2 or newer."""
+        assert is_gemini_provider_active(ogx_client=ogx_client), "remote::gemini provider is not active"
+        pytest.fail(reason="TLS handshake capture requires network inspection tooling not available in this harness")
