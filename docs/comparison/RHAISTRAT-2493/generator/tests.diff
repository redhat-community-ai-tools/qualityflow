+    test_tc_neg_001 = _TestVllmOmniFailedStageInit.test_vllm_omni_failed_stage_init_stays_not_ready
+
+
+@pytest.mark.vllm_omni_nvidia_single_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_unready_isvc",
+    [
+        pytest.param(
+            {"name": "vllm-omni-single-gpu-negative"},
+            {"model-dir": "Qwen3-Omni-30B-A3B-Instruct"},
+            {"deployment_mode": KServeDeploymentType.STANDARD},
+            {
+                "name": "vllm-omni-single-gpu-negative",
+                "model_path": "Qwen3-Omni-30B-A3B-Instruct",
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "gpu_count": 1,
+            },
+            id="test_vllm_omni_single_gpu",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniSingleGpu:
+    """Validate that an under-provisioned GPU count fails with a clear error."""
+
+    def test_tc_neg_002(
+        self,
+        admin_client: DynamicClient,
+        vllm_omni_unready_isvc: InferenceService,
+    ) -> None:
+        """Given a vLLM-Omni deployment configured with only one GPU
+        When the predictor pod is observed for up to 10 minutes
+        Then it never becomes Ready and logs or events report insufficient GPU resources.
+        """
+        deadline = time.monotonic() + 600
+        pod_seen = False
+        insufficient_gpu_logged = False
+
+        while time.monotonic() < deadline:
+            pods: list[Pod] = list(get_pods_by_isvc_label(client=admin_client, isvc=vllm_omni_unready_isvc))
+            if not pods:
+                time.sleep(5)
+                continue
+
+            pod = pods[0]
+            pod_seen = True
