+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniTts:
+    """Validate Qwen3-TTS request handling and invalid-payload behavior."""
+
+    test_tc_tts_001 = _TestVllmOmniTtsQwen3.test_vllm_omni_tts_qwen3_basic
+    test_tc_tts_002 = _TestVllmOmniTtsQwen3.test_vllm_omni_tts_qwen3_single_word_prompt
+    test_tc_tts_003 = _TestVllmOmniTtsQwen3.test_vllm_omni_tts_invalid_payload_errors
+
+
+@pytest.mark.vllm_omni_nvidia_single_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_inference_service",
