+    test_tc_rbac_003 = _TestVllmOmniTtsQwen3.test_vllm_omni_namespace_scoped_user_read_only_access
+
+    def test_tc_rbac_004(
+        self,
+        vllm_omni_isvc_url: str,
+        prometheus: Prometheus,
+    ) -> None:
+        """Given a Monitoring User with metrics read access but no inference permission
+        When Prometheus is queried and an unauthenticated TTS request is sent
+        Then the metric query returns data and the inference request is rejected with HTTP 401 or 403.
+        """
+        metric_value: Any = get_metrics_value(
+            prometheus=prometheus,
+            metrics_query="vllm_omni:audio_ttfp_s",
