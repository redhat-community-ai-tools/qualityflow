+"""End-to-end vLLM-Omni deployment and inference tests."""
+
+from typing import Any
+
+import pytest
+import requests
+from ocp_resources.inference_service import InferenceService
+from ocp_resources.pod import Pod
+from ocp_resources.serving_runtime import ServingRuntime
+
+from tests.model_serving.model_runtime.utils import pod_is_ready
+from tests.model_serving.model_runtime.vllm_omni.s3.test_vllm_omni_e2e import (
+    TestVllmOmniFullE2E as _TestVllmOmniFullE2E,
+)
+from tests.model_serving.model_runtime.vllm_omni.utils import assert_health_ok
+from utilities.constants import KServeDeploymentType, Labels, Timeout
+from utilities.plugins.constant import OpenAIEnpoints
+
+
+pytestmark = pytest.mark.usefixtures("skip_if_no_vllm_omni_multi_gpu", "valid_aws_config")
+
+
+@pytest.mark.vllm_omni_nvidia_multi_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_inference_service",
+    [
+        pytest.param(
+            {"name": "vllm-omni-e2e"},
+            {"model-dir": "Qwen3-Omni-30B-A3B-Instruct"},
+            {"deployment_mode": KServeDeploymentType.STANDARD},
+            {
+                "name": "vllm-omni-e2e",
+                "model_path": "Qwen3-Omni-30B-A3B-Instruct",
+                "gpu_count": 2,
+                "timeout": Timeout.TIMEOUT_40MIN,
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "model_env_variables": [{"name": "HF_HOME", "value": "/tmp/hf_home"}],
+                "min-replicas": 1,
+            },
+            id="test_vllm_omni_e2e",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniEndToEnd:
+    """Complete deployment-to-inference journeys for vLLM-Omni."""
+
+    def test_tc_e2e_001(
+        self,
+        vllm_omni_serving_runtime: ServingRuntime,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_pod_resource: Pod,
+        vllm_omni_isvc_url: str,
+    ) -> None:
+        """Given a vLLM-Omni ServingRuntime and a Ready Qwen3-Omni deployment
+        When the dashboard annotation, pod readiness, health, model list, and TTS endpoint are checked
+        Then the runtime is discoverable, the pod completes all initialization stages,
+        the service reports healthy, the served model is listed, and TTS returns valid audio.
+        """
+        labels: dict[str, str] = vllm_omni_serving_runtime.instance.metadata.labels or {}
+        assert labels.get(Labels.OpenDataHub.DASHBOARD) == "true", (
+            f"ServingRuntime is missing dashboard label {Labels.OpenDataHub.DASHBOARD!r}: {labels}"
+        )
+
+        assert pod_is_ready(pod=vllm_omni_pod_resource), (
+            f"Predictor pod {vllm_omni_pod_resource.name} did not reach Ready state"
+        )
+        assert_health_ok(url=vllm_omni_isvc_url)
+
+        models_response = requests.get(
+            url=f"{vllm_omni_isvc_url}{OpenAIEnpoints.MODELS_INFO}",
+            verify=False,
+            timeout=120,
+        )
+        assert models_response.status_code == 200, (
+            f"GET /v1/models returned HTTP {models_response.status_code}: {models_response.text[:500]}"
+        )
+        models_body: dict[str, Any] = models_response.json()
+        model_ids = [entry.get("id") for entry in models_body.get("data", [])]
+        assert vllm_omni_inference_service.instance.metadata.name in model_ids, (
+            f"Expected served model {vllm_omni_inference_service.instance.metadata.name!r} "
+            f"in /v1/models response: {model_ids}"
+        )
+
+        tts_response = requests.post(
+            url=f"{vllm_omni_isvc_url}/v1/audio/speech",
+            json={
+                "model": vllm_omni_inference_service.instance.metadata.name,
+                "input": "This is an end-to-end vLLM-Omni text to speech validation.",
+                "voice": "vivian",
+                "response_format": "wav",
+            },
+            verify=False,
+            timeout=120,
+        )
+        assert tts_response.status_code == 200, (
+            f"POST /v1/audio/speech returned HTTP {tts_response.status_code}: {tts_response.text[:500]}"
+        )
+        assert len(tts_response.content) > 44, (
+            f"TTS response body is only {len(tts_response.content)} bytes; expected more than 44"
+        )
+
+    def test_tc_e2e_003(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_pod_resource: Pod,
+        vllm_omni_isvc_url: str,
+        vllm_omni_pod_logs: str,
+    ) -> None:
+        """Given an air-gapped vLLM-Omni deployment with mirrored image and local S3 weights
+        When the pod image, readiness, health endpoint, TTS inference, and logs are inspected
+        Then the pod uses a locally mirrored image, becomes Ready without external network access,
+        serves a valid TTS response, and logs contain no external network errors.
+        """
+        image_id = (
+            vllm_omni_pod_resource.instance.status.containerStatuses[0].imageID
+            if vllm_omni_pod_resource.instance.status.containerStatuses
+            else ""
+        )
+        assert image_id and "registry.redhat.io" not in image_id, (
+            f"Pod image ID is not locally mirrored or is empty: {image_id!r}"
+        )
+
+        assert pod_is_ready(pod=vllm_omni_pod_resource), (
+            f"Predictor pod {vllm_omni_pod_resource.name} did not reach Ready state"
+        )
+        assert_health_ok(url=vllm_omni_isvc_url)
+
+        tts_response = requests.post(
+            url=f"{vllm_omni_isvc_url}/v1/audio/speech",
+            json={
+                "model": vllm_omni_inference_service.instance.metadata.name,
+                "input": "This inference is running in a disconnected OpenShift environment.",
+                "voice": "vivian",
+                "response_format": "wav",
+            },
+            verify=False,
+            timeout=120,
+        )
+        assert tts_response.status_code == 200, (
+            f"Disconnected TTS request returned HTTP {tts_response.status_code}: {tts_response.text[:500]}"
+        )
+        assert len(tts_response.content) > 44, "Disconnected TTS response body is too small"
+
+        external_error_markers = (
+            "failed to resolve",
+            "dns resolution failed",
+            "failed to download",
+            "connection timed out",
+            "network is unreachable",
+        )
+        detected = [marker for marker in external_error_markers if marker in vllm_omni_pod_logs.lower()]
+        assert not detected, f"Pod logs contain external-network error markers: {detected}"
