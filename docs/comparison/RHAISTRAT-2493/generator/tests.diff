@@ -0,0 +1,142 @@
+"""Disconnected and air-gapped deployment tests for vLLM-Omni."""
+
+from typing import Any
+
+import pytest
+import requests
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.inference_service import InferenceService
+from ocp_resources.pod import Pod
+from ocp_resources.serving_runtime import ServingRuntime
+
+from tests.model_serving.model_runtime.utils import pod_is_ready
+from tests.model_serving.model_runtime.vllm_omni.s3.test_vllm_omni_e2e import (
+    TestVllmOmniFullE2E as _TestVllmOmniFullE2E,
+)
+from tests.model_serving.model_runtime.vllm_omni.utils import assert_health_ok
+from utilities.constants import KServeDeploymentType, Timeout
+from utilities.operator_utils import get_csv_related_images
+
+
+pytestmark = pytest.mark.usefixtures("skip_if_no_vllm_omni_multi_gpu", "valid_aws_config")
+
+
+@pytest.mark.vllm_omni_nvidia_multi_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_inference_service",
+    [
+        pytest.param(
+            {"name": "vllm-omni-disconnected"},
+            {"model-dir": "Qwen3-Omni-30B-A3B-Instruct"},
+            {"deployment_mode": KServeDeploymentType.STANDARD},
+            {
+                "name": "vllm-omni-disconnected",
+                "model_path": "Qwen3-Omni-30B-A3B-Instruct",
+                "gpu_count": 2,
+                "timeout": Timeout.TIMEOUT_40MIN,
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "model_env_variables": [{"name": "HF_HOME", "value": "/tmp/hf_home"}],
+                "min-replicas": 1,
+            },
+            id="test_vllm_omni_disconnected",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniDisconnected:
+    """Validate vLLM-Omni operation in a disconnected OpenShift environment."""
+
+    def test_tc_disc_001(
+        self,
+        vllm_omni_serving_runtime: ServingRuntime,
+        vllm_omni_pod_resource: Pod,
+    ) -> None:
+        """Given a disconnected cluster with a locally mirrored vLLM-Omni image
+        When the ServingRuntime image and running pod image ID are inspected
+        Then both use a digest-pinned image from a local registry rather than registry.redhat.io.
+        """
+        runtime_image: str = vllm_omni_serving_runtime.instance.spec.containers[0].image
+        assert "@sha256:" in runtime_image, (
+            f"ServingRuntime image is not digest-pinned: {runtime_image!r}"
+        )
+        assert "registry.redhat.io" not in runtime_image, (
+            f"ServingRuntime image still points to the upstream registry: {runtime_image!r}"
+        )
+
+        container_statuses = vllm_omni_pod_resource.instance.status.containerStatuses or []
+        assert container_statuses, f"No container statuses reported for pod {vllm_omni_pod_resource.name}"
+        image_id: str = container_statuses[0].imageID
+        assert image_id and "registry.redhat.io" not in image_id, (
+            f"Pod did not pull from the local mirror registry: {image_id!r}"
+        )
+        assert "@sha256:" in image_id, f"Pod image ID is not digest-pinned: {image_id!r}"
+
+    def test_tc_disc_002(
+        self,
+        admin_client: DynamicClient,
+        vllm_omni_serving_runtime: ServingRuntime,
+        vllm_omni_pod_resource: Pod,
+    ) -> None:
+        """Given a disconnected cluster with an ImageContentSourcePolicy configured
+        When the operator CSV relatedImages and the running pod image are compared
+        Then the CSV contains a digest-pinned vLLM-Omni image and the pod resolves to the same digest.
+        """
+        related_images: list[dict[str, Any]] = get_csv_related_images(admin_client=admin_client)
+        omni_images = [entry for entry in related_images if "vllm-omni" in entry.get("image", "")]
+        assert omni_images, f"No vLLM-Omni image found in operator CSV relatedImages: {related_images}"
+        assert all("@sha256:" in entry["image"] for entry in omni_images), (
+            f"Not all vLLM-Omni CSV images are digest-pinned: {omni_images}"
+        )
+
+        runtime_image: str = vllm_omni_serving_runtime.instance.spec.containers[0].image
+        assert any(entry["image"] == runtime_image for entry in omni_images), (
+            f"ServingRuntime image {runtime_image!r} does not match a CSV relatedImages entry"
+        )
+
+        container_statuses = vllm_omni_pod_resource.instance.status.containerStatuses or []
+        assert container_statuses, f"No container statuses reported for pod {vllm_omni_pod_resource.name}"
+        assert container_statuses[0].imageID, "Pod imageID is empty"
+
+    def test_tc_disc_003(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_pod_resource: Pod,
+        vllm_omni_isvc_url: str,
+        vllm_omni_pod_logs: str,
+    ) -> None:
+        """Given a disconnected cluster with model weights in local S3
+        When the pod becomes Ready and a completion request is sent
+        Then the model loads from /mnt/models, inference succeeds, and no external network errors appear.
+        """
+        assert pod_is_ready(pod=vllm_omni_pod_resource), (
+            f"Predictor pod {vllm_omni_pod_resource.name} did not reach Ready state"
+        )
+        assert "/mnt/models" in vllm_omni_pod_logs.lower(), (
+            "Pod logs do not show model loading from /mnt/models"
+        )
+        assert_health_ok(url=vllm_omni_isvc_url)
+
+        response = requests.post(
+            url=f"{vllm_omni_isvc_url}/v1/completions",
+            json={
+                "model": vllm_omni_inference_service.instance.metadata.name,
+                "prompt": "Disconnected inference test.",
+                "max_tokens": 10,
+                "modalities": ["text"],
+            },
+            verify=False,
+            timeout=120,
+        )
+        assert response.status_code == 200, (
+            f"Disconnected completion request returned HTTP {response.status_code}: {response.text[:500]}"
+        )
+
+        external_error_markers = (
+            "failed to resolve",
+            "dns resolution failed",
+            "failed to download",
+            "connection timed out",
+            "network is unreachable",
+        )
+        detected = [marker for marker in external_error_markers if marker in vllm_omni_pod_logs.lower()]
+        assert not detected, f"Pod logs contain external-network error markers: {detected}"
