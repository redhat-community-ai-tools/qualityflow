+"""Regression coverage for existing vLLM runtime templates."""
+
+from typing import Any
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.template import Template
+from pytest_testconfig import config as py_config
+
+from tests.model_serving.model_runtime.vllm_omni.s3.test_vllm_omni_regression import (
+    TestVllmOmniDoesNotBreakExistingCudaTemplate as _TestVllmOmniDoesNotBreakExistingCudaTemplate,
+)
+from utilities.constants import RuntimeTemplates
+
+
+pytestmark = pytest.mark.usefixtures("skip_if_no_supported_accelerator_type")
+
+
+class TestVllmOmniRegression:
+    """Ensure adding vLLM-Omni does not alter existing vLLM templates."""
+
+    test_tc_reg_001 = _TestVllmOmniDoesNotBreakExistingCudaTemplate.test_vllm_omni_does_not_break_existing_vllm
+
+    def test_tc_reg_002(
+        self,
+        admin_client: DynamicClient,
+    ) -> None:
+        """Given the vLLM-Omni template is installed alongside accelerator-specific vLLM templates
+        When ROCm, Gaudi, CPU, and Spyre templates are inspected
+        Then each existing template is present, none contains the --omni flag,
+        and each declares its original supported model formats.
+        """
+        template_names = (
+            RuntimeTemplates.VLLM_ROCM,
+            RuntimeTemplates.VLLM_GAUDI,
+            RuntimeTemplates.VLLM_CPU_x86,
+            RuntimeTemplates.VLLM_SPYRE,
+        )
+
+        for template_name in template_names:
+            template = Template(
+                client=admin_client,
+                name=template_name,
+                namespace=py_config["applications_namespace"],
+            )
+            assert template.exists, (
+                f"Expected existing vLLM template {template_name!r} in namespace "
+                f"{py_config['applications_namespace']!r}"
+            )
+
+            runtime_dict: dict[str, Any] = template.instance.objects[0].to_dict()
+            containers: list[dict[str, Any]] = runtime_dict.get("spec", {}).get("containers", [])
+            assert containers, f"Template {template_name!r} has no containers"
+
+            args: list[str] = list(containers[0].get("args") or [])
+            assert "--omni" not in args, (
+                f"Existing template {template_name!r} unexpectedly contains the --omni flag: {args}"
+            )
+
+            supported_formats: list[dict[str, Any]] = runtime_dict.get("spec", {}).get(
+                "supportedModelFormats", []
+            )
+            assert supported_formats, (
+                f"Template {template_name!r} has no supportedModelFormats declarations"
+            )
+            assert any(fmt.get("name") == "vLLM" for fmt in supported_formats), (
+                f"Template {template_name!r} no longer declares vLLM support: {supported_formats}"
+            )
