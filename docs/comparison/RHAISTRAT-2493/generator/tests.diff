+            {
+                "name": "vllm-omni-empty-model",
+                "model_path": "",
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "gpu_count": 1,
+            },
+            id="test_vllm_omni_empty_model_path",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniEmptyModelPath:
+    """Validate failure behavior when the S3 model path is empty."""
+
+    def test_tc_init_006(
+        self,
+        admin_client: DynamicClient,
+        vllm_omni_unready_isvc: InferenceService,
+    ) -> None:
+        """Given a vLLM-Omni InferenceService pointed at an empty S3 prefix
+        When the predictor pod is observed for up to 15 minutes
+        Then it never becomes Ready, /health remains non-200, and logs report missing model files.
+        """
+        deadline = time.monotonic() + 900
+        pod_seen = False
+        failure_logged = False
+
+        while time.monotonic() < deadline:
+            pods: list[Pod] = list(get_pods_by_isvc_label(client=admin_client, isvc=vllm_omni_unready_isvc))
+            if not pods:
+                time.sleep(5)
+                continue
+
+            pod = pods[0]
+            pod_seen = True
+            assert not pod_is_ready(pod=pod), f"Pod {pod.name} unexpectedly became Ready for an empty model path"
+
+            logs: str = pod.log(container="kserve-container")
+            if any(marker in logs.lower() for marker in ("model file", "no such file", "empty", "not found")):
+                failure_logged = True
+                break
+            time.sleep(5)
+
+        assert pod_seen, "No predictor pod appeared for the empty model-path InferenceService"
+        assert failure_logged, "Pod logs did not report a missing or empty model path"
