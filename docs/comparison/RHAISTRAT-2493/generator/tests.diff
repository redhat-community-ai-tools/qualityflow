+            {"deployment_mode": KServeDeploymentType.STANDARD},
+            {
+                "name": "vllm-omni-tts-voxtral",
+                "model_path": VOXTRAL_TTS_MODEL_PATH,
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "gpu_count": 1,
+            },
+            id="test_vllm_omni_tts_voxtral_multi_model",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniMultiModelTts:
+    """Validate TTS inference for each supported voice model."""
+
+    def test_tc_tts_004(
+        self,
+        vllm_omni_inference_service: InferenceService,
+    ) -> None:
+        """Given a Ready vLLM-Omni InferenceService for a supported TTS model
+        When one /v1/audio/speech request is sent
+        Then the response is HTTP 200 with a valid WAV body and matching audio content type.
+        """
+        response = run_tts_inference(
+            isvc=vllm_omni_inference_service,
+            text="OpenShift AI enables data scientists to deploy models at scale.",
+            response_format="wav",
+        )
+        assert response.status_code == 200, (
+            f"TTS request returned HTTP {response.status_code}: {response.text[:300]}"
+        )
+
+
+@pytest.mark.vllm_omni_nvidia_multi_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_inference_service",
