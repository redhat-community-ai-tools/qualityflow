+    """Validate OmniVoice loading and single-request inference."""
+
+    def test_tc_tts_005(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_pod_resource: Pod,
+    ) -> None:
+        """Given a Ready OmniVoice deployment
+        When one TTS request is sent
+        Then the response is valid audio and the predictor pod does not restart.
+        """
+        initial_restarts = get_restart_counts(pod=vllm_omni_pod_resource)
+        response = run_tts_inference(
+            isvc=vllm_omni_inference_service,
+            text="OmniVoice is ready for inference.",
+            response_format="wav",
+        )
+        assert response.status_code == 200, (
+            f"OmniVoice TTS request returned HTTP {response.status_code}: {response.text[:300]}"
+        )
+        assert_no_pod_restarts(
+            pod=vllm_omni_pod_resource,
+            initial_counts=initial_restarts,
+            context="OmniVoice single-request inference",
+        )
