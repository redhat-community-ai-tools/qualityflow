+            )
+
+            logs: str = pod.log(container="kserve-container")
+            if "gpu" in logs.lower() and ("insufficient" in logs.lower() or "minimum" in logs.lower()):
+                insufficient_gpu_logged = True
+                break
+            time.sleep(5)
+
