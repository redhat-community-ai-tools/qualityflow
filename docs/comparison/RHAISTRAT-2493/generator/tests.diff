+"""OpenAI-compatible API tests for the vLLM-Omni runtime."""
+
+from typing import Any
+
+import pytest
+import requests
+from ocp_resources.inference_service import InferenceService
+
+from tests.model_serving.model_runtime.vllm_omni.s3.test_vllm_omni_e2e import (
+    TestVllmOmniFullE2E as _TestVllmOmniFullE2E,
+)
+from utilities.constants import KServeDeploymentType, Timeout
+from utilities.plugins.constant import OpenAIEnpoints
+
+
+pytestmark = pytest.mark.usefixtures("skip_if_no_vllm_omni_multi_gpu", "valid_aws_config")
+
+
+@pytest.mark.vllm_omni_nvidia_multi_gpu
+@pytest.mark.parametrize(
+    "model_namespace, s3_models_storage_uri, vllm_omni_serving_runtime, vllm_omni_inference_service",
+    [
+        pytest.param(
+            {"name": "vllm-omni-api"},
+            {"model-dir": "Qwen3-Omni-30B-A3B-Instruct"},
+            {"deployment_mode": KServeDeploymentType.STANDARD},
+            {
+                "name": "vllm-omni-api",
+                "model_path": "Qwen3-Omni-30B-A3B-Instruct",
+                "gpu_count": 2,
+                "timeout": Timeout.TIMEOUT_40MIN,
+                "deployment_mode": KServeDeploymentType.STANDARD,
+                "model_env_variables": [{"name": "HF_HOME", "value": "/tmp/hf_home"}],
+                "min-replicas": 1,
+            },
+            id="test_vllm_omni_api",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniApi:
+    """OpenAI API contract coverage for a deployed vLLM-Omni service."""
+
+    test_tc_api_001 = _TestVllmOmniFullE2E.test_vllm_omni_models_endpoint
+    test_tc_api_003 = _TestVllmOmniFullE2E.test_vllm_omni_chat_completions_endpoint
+    test_tc_api_004 = _TestVllmOmniFullE2E.test_vllm_omni_completions_error_handling
+    test_tc_api_005 = _TestVllmOmniFullE2E.test_vllm_omni_chat_completions_error_handling
+
+    def test_tc_api_002(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_isvc_url: str,
+    ) -> None:
+        """Given a Ready vLLM-Omni InferenceService with a loaded model
+        When a text completion request is sent to /v1/completions
+        Then the response is HTTP 200 with a text_completion object, non-empty choices,
+        a matching model name, and complete token usage metadata.
+        """
+        response = requests.post(
+            url=f"{vllm_omni_isvc_url}{OpenAIEnpoints.COMPLETIONS}",
+            json={
+                "model": vllm_omni_inference_service.instance.metadata.name,
+                "prompt": "The capital of France is",
+                "max_tokens": 50,
+                "modalities": ["text"],
+            },
+            headers={"Content-Type": "application/json"},
+            verify=False,
+            timeout=120,
+        )
+        assert response.status_code == 200, (
+            f"POST /v1/completions returned HTTP {response.status_code}; expected 200. "
+            f"Response: {response.text[:500]}"
+        )
+
+        body: dict[str, Any] = response.json()
+        assert body.get("object") == "text_completion", (
+            f"Expected object='text_completion', got {body.get('object')!r}"
+        )
+        choices: list[dict[str, Any]] = body.get("choices", [])
+        assert choices, f"Expected at least one choice in /v1/completions response: {body}"
+        for choice in choices:
+            assert choice.get("text"), f"Expected non-empty text in choice: {choice}"
+            assert "finish_reason" in choice, f"Expected finish_reason in choice: {choice}"
+
+        assert body.get("model") == vllm_omni_inference_service.instance.metadata.name, (
+            f"Expected model name {vllm_omni_inference_service.instance.metadata.name!r}, "
+            f"got {body.get('model')!r}"
+        )
+        usage: dict[str, Any] = body.get("usage", {})
+        for token_key in ("prompt_tokens", "completion_tokens", "total_tokens"):
+            assert token_key in usage, f"Expected {token_key} in usage metadata: {usage}"
