+                "model_env_variables": [{"name": "HF_HOME", "value": "/tmp/hf_home"}],
+                "min-replicas": 1,
+            },
+            id="test_vllm_omni_initialization",
+        ),
+    ],
+    indirect=True,
+)
+class TestVllmOmniInitialization:
+    """Validate multi-stage initialization and liveness recovery."""
+
+    test_tc_init_001 = _TestVllmOmniFullE2E.test_vllm_omni_three_stage_init_sequence
+
+    def test_tc_init_005(
+        self,
+        vllm_omni_pod_resource: Pod,
+    ) -> None:
+        """Given a Ready vLLM-Omni predictor pod
+        When the serving process is paused so /health stops responding
+        Then the configured liveness probe restarts the container within its failure window.
+        """
+        assert pod_is_ready(pod=vllm_omni_pod_resource), (
+            f"Pod {vllm_omni_pod_resource.name} must be Ready before liveness failure injection"
+        )
+        initial_restarts: dict[str, int] = get_restart_counts(pod=vllm_omni_pod_resource)
+
+        try:
+            vllm_omni_pod_resource.execute(command=["kill", "-STOP", "1"])
+        except Exception as exc:  # noqa: BLE001
+            pytest.fail(f"Unable to pause the serving process for liveness validation: {exc}")
+
+        deadline = time.monotonic() + 120
+        restarted = False
+        while time.monotonic() < deadline:
+            current_restarts = get_restart_counts(pod=vllm_omni_pod_resource)
+            if any(current_restarts[name] > count for name, count in initial_restarts.items()):
+                restarted = True
+                break
+            time.sleep(5)
+
+        assert restarted, (
+            f"Liveness probe did not restart the paused container within 120 seconds. "
+            f"Initial restart counts: {initial_restarts}"
+        )
+
