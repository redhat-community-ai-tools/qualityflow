+    def test_continuous_dialogue_maintains_latency_and_memory_stability(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_isvc_url: str,
+        vllm_omni_pod_resource: Pod,
+        prometheus: Prometheus,
+    ) -> None:
+        """Scenario: continuous dialogue maintains latency and memory stability. [TS-RHAISTRAT-2493-016]
+
+        STP: outputs/RHAISTRAT-2493/stp/RHAISTRAT-2493_test_plan.md
+        """
+        model_name = vllm_omni_inference_service.instance.metadata.name
+        voice = OMNI_TTS_VOICE[QWEN3_TTS_MODEL_PATH]
+        warmup_tts(url=vllm_omni_isvc_url, model=model_name, voice=voice, count=WARM_UP_COUNT)
+        initial_restart_counts = get_restart_counts(pod=vllm_omni_pod_resource)
+
+        baseline_gpu = get_metrics_value(
+            prometheus=prometheus,
+            metrics_query=f'{PROMETHEUS_KV_CACHE_METRIC}{{pod=~"{vllm_omni_pod_resource.name}.*"}}',
+        )
+        minute_one_ttfb: list[float] = []
+        start = time.monotonic()
+        while time.monotonic() - start < _SOAK_DURATION_SECONDS:
+            status_code, ttfb, _ = timed_tts_request(
+                url=vllm_omni_isvc_url,
+                model=model_name,
+                prompt=TTS_PROMPT_CORPUS[int(time.monotonic() - start) % len(TTS_PROMPT_CORPUS)],
+                voice=voice,
+            )
+            assert status_code == HTTPStatus.OK, f"soak request returned HTTP {status_code}"
+            if time.monotonic() - start <= 60:
+                minute_one_ttfb.append(ttfb)
+
+        final_gpu = get_metrics_value(
+            prometheus=prometheus,
+            metrics_query=f'{PROMETHEUS_KV_CACHE_METRIC}{{pod=~"{vllm_omni_pod_resource.name}.*"}}',
+        )
+        final_window_ttfb = [
+            timed_tts_request(
+                url=vllm_omni_isvc_url,
+                model=model_name,
+                prompt=TTS_PROMPT_CORPUS[0],
+                voice=voice,
+            )[1]
+            for _ in range(20)
+        ]
+        assert minute_one_ttfb and final_window_ttfb
+        assert calculate_percentile(values=final_window_ttfb, percentile=95.0) <= (
+            SOAK_TTFB_DEGRADATION_RATIO * calculate_percentile(values=minute_one_ttfb, percentile=95.0)
+        )
+        assert float(final_gpu) - float(baseline_gpu) <= SOAK_GPU_MEMORY_GROWTH_THRESHOLD
+        final_restart_counts = get_restart_counts(pod=vllm_omni_pod_resource)
+        assert final_restart_counts == initial_restart_counts
