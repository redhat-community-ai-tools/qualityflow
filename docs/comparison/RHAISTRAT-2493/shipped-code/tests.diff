+    def test_warm_tts_route_latency_meets_percentile_targets(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_isvc_url: str,
+    ) -> None:
+        """Scenario: warm TTS route latency meets percentile targets. [TS-RHAISTRAT-2493-015]
