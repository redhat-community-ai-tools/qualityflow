+def _isvc_ready(isvc: InferenceService) -> bool:
+    """Return True when the InferenceService Ready condition is True."""
+    return any(
+        condition.type == "Ready" and condition.status == "True"
+        for condition in isvc.instance.status.conditions or []
+    )
+
+
+def _isvc_model_state(isvc: InferenceService) -> tuple[str | None, str | None]:
+    """Return the active and target model states reported by KServe."""
+    model_status = getattr(isvc.instance.status, "modelStatus", None)
+    states = getattr(model_status, "states", None)
+    if not states:
+        return None, None
+    return getattr(states, "activeModelState", None), getattr(states, "targetModelState", None)
+
+
+def _find_metric_data_lines(metrics_text: str, metric_name: str) -> list[str]:
+    """Return data lines for one Prometheus metric family."""
+    return [line for line in metrics_text.splitlines() if line.startswith(metric_name) and not line.startswith("#")]
+
+
+def _find_base64_leaks(log_text: str) -> str | None:
+    """Return a suspicious base64 block from persistent pod logs."""
+    for line in log_text.splitlines():
+        match = _BASE64_BLOCK_PATTERN.search(string=line)
+        if not match:
+            continue
+        candidate = match.group()
+        if any(char.isupper() for char in candidate) and any(char.islower() for char in candidate) and "+" in candidate:
+            return candidate
+    return None
+
+
+def _predictor_pod_name(isvc: InferenceService) -> str:
+    """Return the standard single-replica predictor pod name."""
+    return f"{isvc.name}-predictor-00000"
