+        """
+        model_name = vllm_omni_inference_service.instance.metadata.name
+        voice = OMNI_TTS_VOICE[QWEN3_TTS_MODEL_PATH]
+        warmup_tts(url=vllm_omni_isvc_url, model=model_name, voice=voice, count=WARM_UP_COUNT)
+
+        ttfb_values: list[float] = []
+        e2e_values: list[float] = []
+        for index in range(PERF_REQUEST_COUNT):
+            status_code, ttfb, e2e = timed_tts_request(
+                url=vllm_omni_isvc_url,
+                model=model_name,
+                prompt=TTS_PROMPT_CORPUS[index % len(TTS_PROMPT_CORPUS)],
+                voice=voice,
+            )
+            assert status_code == HTTPStatus.OK, f"request {index + 1} returned HTTP {status_code}"
+            ttfb_values.append(ttfb)
+            e2e_values.append(e2e)
+
+        assert calculate_percentile(values=ttfb_values, percentile=95.0) <= TTFB_P95_THRESHOLD_S
+        assert calculate_percentile(values=e2e_values, percentile=95.0) <= E2E_P95_THRESHOLD_S
