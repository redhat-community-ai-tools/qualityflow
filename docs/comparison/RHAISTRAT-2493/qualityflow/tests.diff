+    @pytest.mark.usefixtures("skip_if_no_supported_accelerator_type", "valid_aws_config", "cluster_monitoring_config")
+    def test_qf_rhaistrat_2493_016_continuous_dialogue_maintains_latency_and_memory_stability(
+        self,
+        vllm_omni_inference_service: InferenceService,
+        vllm_omni_isvc_url: str,
+        vllm_omni_pod_resource: Pod,
+        prometheus: Prometheus,
+    ) -> None:
+        """Scenario: Verify continuous dialogue maintains latency and memory stability [TS-RHAISTRAT-2493-016].
+
+        STP: outputs/RHAISTRAT-2493/stp/RHAISTRAT-2493_test_plan.md
+        """
+        raw_duration = os.environ.get("OMNI_SOAK_DURATION", "600")
+        soak_duration_s = int(raw_duration)
+        warmup_tts(
+            url=vllm_omni_isvc_url,
+            model=vllm_omni_inference_service.instance.metadata.name,
+            voice=OMNI_TTS_VOICE[QWEN3_TTS_MODEL_PATH],
+            count=WARM_UP_COUNT,
+        )
+        baseline_raw = get_metrics_value(prometheus=prometheus, metrics_query=PROMETHEUS_KV_CACHE_METRIC)
+        assert baseline_raw is not None, "Prometheus returned no baseline GPU memory metric"
+        baseline_gpu_usage = float(baseline_raw)
+        initial_restart_counts = get_restart_counts(pod=vllm_omni_pod_resource)
+        prompt_cycle = itertools.cycle(TTS_PROMPT_CORPUS)
+        start_time = time.monotonic()
+        min1_ttfb_values = []
+        final_window_ttfb_values = []
+        while (elapsed := time.monotonic() - start_time) < soak_duration_s:
+            prompt = next(prompt_cycle)
+            status_code, ttfb_s, _ = timed_tts_request(
+                url=vllm_omni_isvc_url,
+                model=vllm_omni_inference_service.instance.metadata.name,
+                prompt=prompt,
+                voice=OMNI_TTS_VOICE[QWEN3_TTS_MODEL_PATH],
+            )
+            assert status_code == 200, f"Soak request at T+{elapsed:.1f}s returned HTTP {status_code}"
+            if elapsed <= 60:
+                min1_ttfb_values.append(ttfb_s)
+            if elapsed > soak_duration_s - 60:
+                final_window_ttfb_values.append(ttfb_s)
+        assert min1_ttfb_values, "Soak collected no minute-1 TTFB samples"
+        assert final_window_ttfb_values, "Soak collected no final-window TTFB samples"
+        ttfb_min1 = calculate_percentile(values=min1_ttfb_values, percentile=95.0)
+        ttfb_final = calculate_percentile(values=final_window_ttfb_values, percentile=95.0)
+        assert ttfb_final <= SOAK_TTFB_DEGRADATION_RATIO * ttfb_min1, (
+            f"Soak TTFB p95 degraded from {ttfb_min1:.3f}s to {ttfb_final:.3f}s"
+        )
+        assert_no_pod_restarts(
+            pod=vllm_omni_pod_resource,
+            initial_counts=initial_restart_counts,
+            context="QualityFlow continuous dialogue",
+        )
+        final_raw = get_metrics_value(prometheus=prometheus, metrics_query=PROMETHEUS_KV_CACHE_METRIC)
+        assert final_raw is not None, "Prometheus returned no final GPU memory metric"
+        final_gpu_usage = float(final_raw)
+        growth_ratio = (final_gpu_usage - baseline_gpu_usage) / baseline_gpu_usage
+        assert growth_ratio < SOAK_GPU_MEMORY_GROWTH_THRESHOLD, (
+            f"Soak GPU memory growth {growth_ratio:.1%} exceeds {SOAK_GPU_MEMORY_GROWTH_THRESHOLD:.0%}"
+        )
