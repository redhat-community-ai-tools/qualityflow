+class TestQfVllmOmniHealthTransition:
+    """Readiness remains blocked while any model stage is initializing."""
+
+    @pytest.mark.usefixtures("valid_aws_config")
+    def test_qf_rhaistrat_2493_008_readiness_remains_blocked_throughout_partial_initialization(
+        self,
+        admin_client: DynamicClient,
+        model_namespace: Namespace,
+        s3_models_storage_uri: str,
+        vllm_omni_serving_runtime: ServingRuntime,
+        vllm_omni_unready_isvc: InferenceService,
+    ) -> None:
+        """Scenario: Verify readiness remains blocked throughout partial initialization [TS-RHAISTRAT-2493-008].
+
+        STP: outputs/RHAISTRAT-2493/stp/RHAISTRAT-2493_test_plan.md
+        """
+        pod = wait_for_pod_running(admin_client=admin_client, isvc=vllm_omni_unready_isvc)
+        saw_non_200 = False
+        transitioned_to_200 = False
+        try:
+            for health_code in TimeoutSampler(
+                wait_timeout=600,
+                sleep=HEALTH_POLL_INTERVAL_SECONDS,
+                func=safe_exec_health_probe,
+                pod=pod,
+                http_get={"path": "/health", "port": 8080, "scheme": "HTTP"},
+            ):
+                if health_code != "200":
+                    saw_non_200 = True
+                elif saw_non_200:
+                    transitioned_to_200 = True
+                    break
+        except TimeoutExpiredError:
+            pytest.fail("Predictor /health did not transition to HTTP 200 during partial initialization")
+        assert saw_non_200, "Predictor /health never reported non-200 during partial initialization"
+        assert transitioned_to_200, "Predictor /health did not transition to HTTP 200 after initialization"
+
