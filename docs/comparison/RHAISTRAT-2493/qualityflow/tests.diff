+class TestQfVllmOmniFailedStageInit:
+    """Failed model stages keep serving unavailable."""
+
+    @pytest.mark.usefixtures("valid_aws_config")
+    def test_qf_rhaistrat_2493_009_failed_model_stages_keep_serving_unavailable(
+        self,
+        admin_client: DynamicClient,
+        model_namespace: Namespace,
+        s3_models_storage_uri: str,
+        vllm_omni_serving_runtime: ServingRuntime,
+        vllm_omni_unready_isvc: InferenceService,
+    ) -> None:
+        """Scenario: Verify failed model stages keep serving unavailable [TS-RHAISTRAT-2493-009].
+
+        STP: outputs/RHAISTRAT-2493/stp/RHAISTRAT-2493_test_plan.md
+        """
+        deadline = time.monotonic() + 300
+        pod_appeared = False
+        pod_crashed = False
+        health_ever_200 = False
+        pods: list[Pod] = []
+        while time.monotonic() < deadline:
+            try:
+                pods = list(get_pods_by_isvc_label(client=admin_client, isvc=vllm_omni_unready_isvc))
+            except Exception:
+                time.sleep(HEALTH_POLL_INTERVAL_SECONDS)
+                continue
+            if not pods:
+                time.sleep(HEALTH_POLL_INTERVAL_SECONDS)
+                continue
+            pod = pods[0]
+            pod_appeared = True
+            if has_crash_loop_backoff(pod=pod):
+                pod_crashed = True
+                break
+            health_code = safe_exec_health_probe(
+                pod=pod,
+                http_get={"path": "/health", "port": 8080, "scheme": "HTTP"},
+            )
+            if health_code == "200":
+                health_ever_200 = True
+                break
+            if pod_is_ready(pod=pod):
+                pytest.fail("Failed-stage predictor became Ready unexpectedly")
+            time.sleep(HEALTH_POLL_INTERVAL_SECONDS)
+        assert pod_appeared, "No predictor pod appeared for the failed-stage InferenceService"
+        assert not health_ever_200, "Failed-stage predictor reported /health HTTP 200 unexpectedly"
+        assert pod_crashed, "Failed-stage predictor did not enter CrashLoopBackOff"
+
