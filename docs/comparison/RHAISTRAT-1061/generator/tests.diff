+
+def _deployment_env(deployment: dict[str, Any], name: str) -> dict[str, Any] | None:
+    containers = deployment.get("spec", {}).get("template", {}).get("spec", {}).get("containers", [])
+    for container in containers:
+        for env in container.get("env", []):
+            if env.get("name") == name:
+                return env
+    return None
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_secret_001(tmp_path: Path) -> None:
+    """Given a VLLM SecretKeyRef, when the Deployment is created, then the credential is injected without plaintext."""
+    ensure_oc_available()
+    with isolated_namespace("secret-001") as namespace:
+        secret = {
+            "apiVersion": "v1",
+            "kind": "Secret",
+            "metadata": {"name": "vllm-secret", "namespace": namespace, "labels": {"ogx.io/watch": "true"}},
+            "type": "Opaque",
+            "stringData": {"api-token": "test-vllm-api-token-value"},
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "ogx-secret-vllm", "namespace": namespace},
+            "spec": {
+                "distribution": {"name": "rh-dev"},
+                "providers": {
+                    "inference": {
+                        "remote": {
+                            "vllm": [
+                                {
+                                    "id": "vllm-inference",
+                                    "endpoint": "https://vllm.svc:8000",
+                                    "apiToken": {"name": "vllm-secret", "key": "api-token"},
+                                }
+                            ]
+                        }
+                    }
+                },
+            },
+        }
+        apply_manifest(write_manifest(tmp_path, secret, "secret-001-secret"))
+        apply_and_wait_ready(write_manifest(tmp_path, server, "secret-001-server"), "ogx-secret-vllm", namespace)
+
+        deployment = get_owned_deployment(namespace, "ogx-secret-vllm")
+        env = _deployment_env(deployment, "OGX_VLLM_INFERENCE_API_TOKEN")
+        assert env is not None, "VLLM API token environment variable must be auto-injected"
+        assert env.get("valueFrom", {}).get("secretKeyRef") == {"name": "vllm-secret", "key": "api-token"}
+        config_text = get_generated_configmap(namespace, "ogx-secret-vllm").get("data", {}).get("config.yaml", "")
