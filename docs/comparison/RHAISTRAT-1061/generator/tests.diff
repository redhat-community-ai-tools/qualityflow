+def test_tc_e2e_003(tmp_path: Path) -> None:
+    """Given an upgraded cluster, when OGX is enabled, then a new OGXServer becomes healthy and serves inference."""
+    ensure_oc_available()
+    patch = json.dumps({"spec": {"components": {"ogx": {"managementState": "Managed"}, "llamastackoperator": {"managementState": "Removed"}}}})
