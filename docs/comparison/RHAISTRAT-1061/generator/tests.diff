+            "workload": {"storage": {"size": "5Gi"}},
+        },
+    }
+    with isolated_namespace("schema-004") as namespace:
+        path = write_manifest(tmp_path, manifest, "schema-004")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "Empty providers array must be rejected"
