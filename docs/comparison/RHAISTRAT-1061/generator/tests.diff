+import base64
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from tests.runtime_config_in_crd.utils import (
+    apply_and_wait_ready,
+    ensure_oc_available,
+    get_generated_config,
+    get_generated_configmap,
+    get_resource,
+    isolated_namespace,
+    run_oc,
+    write_manifest,
+)
+
+
+def _distribution_image(namespace: str, name: str) -> str:
+    resource = get_resource("ogxserver", name, namespace)
+    image = resource.get("spec", {}).get("image") or resource.get("status", {}).get("image")
+    if not image:
+        pytest.fail(reason=f"OGXServer {name} does not report a distribution image")
+    return image
+
+
+def _image_info(image: str) -> dict[str, Any]:
+    success, stdout, stderr = run_oc(
+        command=["oc", "image", "info", image, "--filter-by-os", "linux/amd64", "-o", "json"],
+        timeout=180,
+    )
+    if not success:
+        raise AssertionError(f"Failed to inspect distribution image {image}: {stderr}")
+    return json.loads(stdout)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_oci_001(tmp_path: Path) -> None:
+    """Given OCI config labels, when an OGXServer starts, then generated config matches the labeled base."""
+    ensure_oc_available()
+    with isolated_namespace("oci-001") as namespace:
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "oci-test-001", "namespace": namespace},
+            "spec": {"distribution": {"name": "rh-dev"}},
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "oci-001-server"), "oci-test-001", namespace)
+        image = _distribution_image(namespace, "oci-test-001")
+        info = _image_info(image)
+        labels = info.get("config", {}).get("config", {}).get("Labels", {})
+        encoded = labels.get("com.ogx.config.config.yaml")
+        assert encoded, f"Distribution image {image} is missing com.ogx.config.config.yaml"
+        base_config = yaml.safe_load(base64.b64decode(encoded))
+        generated = get_generated_config(get_generated_configmap(namespace, "oci-test-001"))
+        assert generated == base_config
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
+def test_tc_oci_002(tmp_path: Path) -> None:
+    """Given an unlabeled distribution image, when an OGXServer starts, then embedded defaults are used."""
+    image = os.getenv("OGX_UNLABELED_DISTRIBUTION_IMAGE")
+    if not image:
