+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests.runtime_config_in_crd.utils import (
+    apply_and_wait_ready,
+    apply_manifest,
+    ensure_oc_available,
+    get_generated_config,
+    get_generated_configmap,
+    get_resources,
+    get_resource,
+    isolated_namespace,
+    wait_for_condition,
+    write_manifest,
+)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_baseconfig_001(tmp_path: Path) -> None:
+    """Given a custom baseConfig, when the CR reconciles, then generated config uses that base rather than OCI labels."""
+    ensure_oc_available()
+    with isolated_namespace("baseconfig-001") as namespace:
+        base_configmap = {
+            "apiVersion": "v1",
+            "kind": "ConfigMap",
+            "metadata": {"name": "custom-base", "namespace": namespace},
+            "data": {
+                "config.yaml": "providers:\n  inference:\n    - provider_id: custom-base-inference\n      provider_type: remote::vllm\n"
+            },
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "baseconfig-test-001", "namespace": namespace},
+            "spec": {
+                "distribution": {"name": "rh-dev"},
+                "baseConfig": {"configMapRef": {"name": "custom-base", "key": "config.yaml"}},
+                "providers": {"inference": {"remote": {"vllm": [{"id": "merged-vllm", "endpoint": "https://vllm.svc:8000"}]}}},
+            },
+        }
+        apply_manifest(write_manifest(tmp_path, base_configmap, "baseconfig-001-cm"))
+        apply_and_wait_ready(write_manifest(tmp_path, server, "baseconfig-001-server"), "baseconfig-test-001", namespace)
+
+        config = get_generated_config(get_generated_configmap(namespace, "baseconfig-test-001"))
+        assert "custom-base.db" in str(config), "Custom base ConfigMap content must be preserved"
+        assert "oci-label-only" not in str(config), "OCI-label-only values must not leak into generated config"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_baseconfig_002(tmp_path: Path) -> None:
+    """Given a missing baseConfig ConfigMap, when the CR reconciles, then generation fails terminally."""
+    ensure_oc_available()
+    with isolated_namespace("baseconfig-002") as namespace:
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "baseconfig-test-002", "namespace": namespace},
+            "spec": {
+                "distribution": {"name": "rh-dev"},
+                "baseConfig": {"configMapRef": {"name": "nonexistent-config", "key": "config.yaml"}},
+            },
+        }
+        apply_manifest(write_manifest(tmp_path, server, "baseconfig-002-server"))
+        wait_for_condition(
+            kind="ogxserver",
+            name="baseconfig-test-002",
+            namespace=namespace,
+            condition="ConfigGenerationFailed",
+            timeout=120,
+        )
+        resource = get_resource("ogxserver", "baseconfig-test-002", namespace)
+        conditions = resource.get("status", {}).get("conditions", [])
+        assert any(condition.get("type") == "ConfigGenerationFailed" for condition in conditions)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
+def test_tc_baseconfig_003(tmp_path: Path) -> None:
+    """Given only spec.baseConfig, when the CR reconciles, then config generation is not activated."""
+    ensure_oc_available()
+    with isolated_namespace("baseconfig-003") as namespace:
+        base_configmap = {
+            "apiVersion": "v1",
+            "kind": "ConfigMap",
+            "metadata": {"name": "base-only-config", "namespace": namespace},
+            "data": {"config.yaml": "providers: {}"},
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "baseconfig-test-003", "namespace": namespace},
+            "spec": {
+                "distribution": {"name": "rh-dev"},
+                "baseConfig": {"configMapRef": {"name": "base-only-config", "key": "config.yaml"}},
+            },
+        }
+        apply_manifest(write_manifest(tmp_path, base_configmap, "baseconfig-003-cm"))
+        apply_and_wait_ready(write_manifest(tmp_path, server, "baseconfig-003-server"), "baseconfig-test-003", namespace)
+
+        configmaps = get_resources("configmap", namespace, selector="ogx.io/owner=baseconfig-test-003")
+        assert all(configmap.get("metadata", {}).get("name") != "baseconfig-test-003-config" for configmap in configmaps)
+
