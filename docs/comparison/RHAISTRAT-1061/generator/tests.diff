+        path = write_manifest(tmp_path, manifest, "schema-003")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "Invalid provider_type must be rejected"
+        assert "provider_type" in stderr or "Unsupported value" in stderr, f"Unexpected schema error: {stderr}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_schema_004(tmp_path: Path) -> None:
+    """Given an empty providers array, when applying the CR, then CEL rejects the MinItems violation."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "schema-test-empty-providers"},
+        "spec": {
+            "distribution": {"name": "rh-dev"},
