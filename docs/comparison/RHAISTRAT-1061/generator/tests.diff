diff --git a/tests/runtime_config_in_crd/utils.py b/tests/runtime_config_in_crd/utils.py
new file mode 100644
index 0000000..2acf7bd
--- /dev/null
+++ b/tests/runtime_config_in_crd/utils.py
@@ -0,0 +1,174 @@
+from __future__ import annotations
+
+import json
+from contextlib import contextmanager
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+import shortuuid
+import yaml
+from pyhelper_utils.shell import run_command
+
+
+def ensure_oc_available() -> None:
+    """Fail fast when the OpenShift CLI is unavailable."""
+    success, _, _ = run_command(command=["oc", "whoami"], check=False, log_errors=False)
+    if not success:
+        pytest.fail(reason="OpenShift CLI is not available or not logged in")
+
+
+def run_oc(command: list[str], *, timeout: int = 180, check: bool = True) -> tuple[bool, str, str]:
+    """Run an OpenShift CLI command with an explicit timeout."""
+    return run_command(command=command, timeout=timeout, check=check, log_errors=not check)
+
+
+def run_oc_json(command: list[str], *, timeout: int = 180) -> dict[str, Any]:
+    """Run an OpenShift CLI command and parse its JSON output."""
+    success, stdout, stderr = run_oc(command=command, timeout=timeout)
+    if not success:
+        raise AssertionError(f"OpenShift command failed: {stderr}")
+    result = json.loads(stdout)
+    if not isinstance(result, dict):
+        raise AssertionError(f"Expected JSON object, got {type(result).__name__}")
+    return result
+
+
+def write_manifest(tmp_path: Path, manifest: dict[str, Any], name: str) -> Path:
+    """Write a YAML manifest to a temporary file."""
+    path = tmp_path / f"{name}.yaml"
+    path.write_text(yaml.safe_dump(manifest), encoding="utf-8")
+    return path
+
+
+def apply_manifest(manifest_path: Path) -> None:
+    """Apply a manifest file through the OpenShift CLI."""
+    success, _, stderr = run_oc(command=["oc", "apply", "-f", str(manifest_path)])
+    if not success:
+        raise AssertionError(f"Failed to apply manifest {manifest_path}: {stderr}")
+
+
+def delete_manifest(manifest_path: Path) -> None:
+    """Delete resources declared by a manifest file."""
+    success, _, stderr = run_oc(command=["oc", "delete", "-f", str(manifest_path), "--ignore-not-found=true"])
+    if not success:
+        raise AssertionError(f"Failed to delete manifest {manifest_path}: {stderr}")
+
+
+def create_namespace(name: str) -> None:
+    """Create a namespace for an isolated test."""
+    success, _, stderr = run_oc(command=["oc", "create", "namespace", name])
+    if not success:
+        raise AssertionError(f"Failed to create namespace {name}: {stderr}")
+
+
+def delete_namespace(name: str) -> None:
+    """Delete a namespace and wait for removal."""
+    success, _, stderr = run_oc(command=["oc", "delete", "namespace", name, "--wait=true"], timeout=300)
+    if not success:
+        raise AssertionError(f"Failed to delete namespace {name}: {stderr}")
+
+
+@contextmanager
+def isolated_namespace(prefix: str) -> Iterator[str]:
+    """Create and remove an isolated namespace for one test."""
+    namespace = f"{prefix}-{shortuuid.uuid()[:8].lower()}"
+    create_namespace(namespace)
+    try:
+        yield namespace
+    finally:
+        delete_namespace(namespace)
+
+
+def get_resource(kind: str, name: str, namespace: str) -> dict[str, Any]:
+    """Return a single cluster resource as a dictionary."""
+    return run_oc_json(command=["oc", "get", kind, name, "-n", namespace, "-o", "json"])
+
+
+def get_resources(kind: str, namespace: str, *, selector: str | None = None) -> list[dict[str, Any]]:
+    """Return cluster resources of a kind, optionally filtered by label."""
+    command = ["oc", "get", kind, "-n", namespace, "-o", "json"]
+    if selector:
+        command.extend(["-l", selector])
+    result = run_oc_json(command=command)
+    items = result.get("items", [])
+    if not isinstance(items, list):
+        raise AssertionError("Expected a list of resources")
+    return items
+
+
+def wait_for_condition(kind: str, name: str, namespace: str, condition: str, timeout: int = 300) -> None:
+    """Wait until a resource reports a condition as true."""
+    success, _, stderr = run_oc(
+        command=[
+            "oc",
+            "wait",
+            f"{kind}/{name}",
+            f"--for=condition={condition}",
+            f"--timeout={timeout}s",
+            "-n",
+            namespace,
+        ],
+        timeout=timeout + 30,
+    )
+    if not success:
+        raise AssertionError(f"Timed out waiting for {kind}/{name} condition {condition}: {stderr}")
+
+
+def apply_and_wait_ready(manifest_path: Path, name: str, namespace: str, *, timeout: int = 300) -> None:
+    """Apply a manifest and wait for its OGXServer to become Ready."""
+    apply_manifest(manifest_path)
+    wait_for_condition(kind="ogxserver", name=name, namespace=namespace, condition="Ready", timeout=timeout)
+
+
+def get_condition(resource: dict[str, Any], condition_type: str) -> dict[str, Any] | None:
+    """Return a status condition by type, if present."""
+    conditions = resource.get("status", {}).get("conditions", [])
+    for condition in conditions:
+        if condition.get("type") == condition_type:
+            return condition
+    return None
+
+
+def get_generated_configmap(namespace: str, owner: str) -> dict[str, Any]:
+    """Return the generated ConfigMap owned by an OGXServer."""
+    configmaps = get_resources("configmap", namespace, selector=f"ogx.io/owner={owner}")
+    if not configmaps:
+        raise AssertionError(f"No generated ConfigMap found for OGXServer {owner}")
+    if len(configmaps) != 1:
+        raise AssertionError(f"Expected one generated ConfigMap for {owner}, found {len(configmaps)}")
+    return configmaps[0]
+
+
+def get_generated_config(configmap: dict[str, Any]) -> dict[str, Any]:
+    """Parse config.yaml from a generated ConfigMap."""
+    data = configmap.get("data", {})
+    config_text = data.get("config.yaml")
+    if not config_text:
+        raise AssertionError("Generated ConfigMap does not contain config.yaml")
+    config = yaml.safe_load(config_text)
+    if not isinstance(config, dict):
+        raise AssertionError("Generated config.yaml is not a mapping")
+    return config
+
+
+def get_owned_deployment(namespace: str, owner: str) -> dict[str, Any]:
+    """Return the Deployment owned by an OGXServer."""
+    deployments = get_resources("deployment", namespace, selector=f"ogx.io/owner={owner}")
+    if not deployments:
+        raise AssertionError(f"No Deployment found for OGXServer {owner}")
+    if len(deployments) != 1:
+        raise AssertionError(f"Expected one Deployment for {owner}, found {len(deployments)}")
+    return deployments[0]
+
+
+def get_pod_logs(namespace: str, deployment_name: str, *, container: str | None = None) -> str:
+    """Return logs from the newest pod of a Deployment."""
+    command = ["oc", "logs", f"deployment/{deployment_name}", "-n", namespace, "--tail=500"]
+    if container:
+        command.extend(["-c", container])
+    success, stdout, stderr = run_oc(command=command)
+    if not success:
+        raise AssertionError(f"Failed to get logs for deployment {deployment_name}: {stderr}")
+    return stdout
