+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests.runtime_config_in_crd.utils import (
+    apply_and_wait_ready,
+    ensure_oc_available,
+    get_generated_configmap,
+    get_owned_deployment,
+    get_resources,
+    isolated_namespace,
+    run_oc,
+    write_manifest,
+)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_lifecycle_001(tmp_path: Path) -> None:
+    """Given an unchanged spec, when the pod is deleted, then the same ConfigMap is reused."""
+    ensure_oc_available()
+    with isolated_namespace("lifecycle-001") as namespace:
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "lifecycle-test-001", "namespace": namespace},
+            "spec": {"distribution": {"name": "rh-dev"}},
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "lifecycle-001-server"), "lifecycle-test-001", namespace)
+        original = get_generated_configmap(namespace, "lifecycle-test-001")
+
+        run_oc(command=["oc", "delete", "pod", "-l", "ogx.io/owner=lifecycle-test-001", "-n", namespace])
+        deployment_name = get_owned_deployment(namespace, "lifecycle-test-001")["metadata"]["name"]
+        run_oc(command=["oc", "wait", f"deployment/{deployment_name}", "--for=condition=Available", "--timeout=180s", "-n", namespace])
+        replacement = get_generated_configmap(namespace, "lifecycle-test-001")
+
+        assert replacement["metadata"]["uid"] == original["metadata"]["uid"]
+        assert len(get_resources("configmap", namespace, selector="ogx.io/owner=lifecycle-test-001")) == 1
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
+def test_tc_lifecycle_002(tmp_path: Path) -> None:
+    """Given repeated spec changes, when ConfigMaps are generated, then only the latest two are retained."""
+    ensure_oc_available()
+    with isolated_namespace("lifecycle-002") as namespace:
+        server: dict[str, Any] = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "lifecycle-test-002", "namespace": namespace},
+            "spec": {"distribution": {"name": "rh-dev"}, "providers": {"inference": {"remote": {"vllm": [{"id": "vllm-1"}]}}}},
+        }
+        path = write_manifest(tmp_path, server, "lifecycle-002-server")
+        apply_and_wait_ready(path, "lifecycle-test-002", namespace)
+
+        for index in range(2, 5):
+            server["spec"]["providers"] = {"inference": {"remote": {"vllm": [{"id": f"vllm-{index}"}]}}}
+            apply_and_wait_ready(write_manifest(tmp_path, server, f"lifecycle-002-server-{index}"), "lifecycle-test-002", namespace)
+            configmaps = get_resources("configmap", namespace, selector="ogx.io/owner=lifecycle-test-002")
+            assert len(configmaps) <= 2, f"Retention limit exceeded after change {index}: {len(configmaps)}"
+
+        deployment = get_owned_deployment(namespace, "lifecycle-test-002")
+        volumes = deployment.get("spec", {}).get("template", {}).get("spec", {}).get("volumes", [])
+        latest_names = {configmap["metadata"]["name"] for configmap in get_resources("configmap", namespace, selector="ogx.io/owner=lifecycle-test-002")}
+        assert any(volume.get("configMap", {}).get("name") in latest_names for volume in volumes)
+
