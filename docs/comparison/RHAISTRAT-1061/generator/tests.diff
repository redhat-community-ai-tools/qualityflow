+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests.runtime_config_in_crd.utils import (
+    ensure_oc_available,
+    isolated_namespace,
+    run_oc,
+    write_manifest,
+)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_cel_001(tmp_path: Path) -> None:
+    """Given a CR using both overrideConfig and providers, when applying it, then CEL rejects the combination."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "cel-test-001"},
+        "spec": {
+            "distribution": {"name": "rh-dev"},
+            "overrideConfig": {"configMapRef": {"name": "override", "key": "config.yaml"}},
+            "providers": {"inference": []},
+        },
+    }
+    with isolated_namespace("cel-001") as namespace:
+        path = write_manifest(tmp_path, manifest, "cel-001")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "CEL validation must reject overrideConfig together with providers"
+        assert "overrideConfig" in stderr and "providers" in stderr, f"Unexpected CEL error: {stderr}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_cel_002(tmp_path: Path) -> None:
+    """Given a CR using both overrideConfig and disabledAPIs, when applying it, then CEL rejects the combination."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "cel-test-002"},
+        "spec": {
+            "distribution": {"name": "rh-dev"},
+            "overrideConfig": {"configMapRef": {"name": "override", "key": "config.yaml"}},
+            "disabledAPIs": ["inference"],
+        },
+    }
+    with isolated_namespace("cel-002") as namespace:
+        path = write_manifest(tmp_path, manifest, "cel-002")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "CEL validation must reject overrideConfig together with disabledAPIs"
+        assert "overrideConfig" in stderr and "disabledAPIs" in stderr, f"Unexpected CEL error: {stderr}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_cel_003(tmp_path: Path) -> None:
+    """Given a CR using both overrideConfig and baseConfig, when applying it, then CEL rejects the combination."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
