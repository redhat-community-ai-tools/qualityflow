+                            {"name": "POSTGRES_PORT", "value": "5432"},
+                            {"name": "POSTGRES_DB", "value": "ogx_metadata"},
+                            {"name": "POSTGRES_USER", "value": "ogx"},
+                            {"name": "POSTGRES_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "ogx-postgres-secret", "key": "password"}}},
+                        ]
+                    }
+                },
+            },
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "e2e-003-server"), "ogx-upgrade-test", namespace)
+        deployment = get_owned_deployment(namespace, "ogx-upgrade-test")
+        _, health, _ = run_oc(command=["oc", "exec", f"deployment/{deployment['metadata']['name']}", "-n", namespace, "--", "curl", "-fsS", "http://localhost:8321/health"])
+        assert json.loads(health).get("status") in ("ok", "healthy")
+
+        payload = json.dumps({"model": "test-model", "messages": [{"role": "user", "content": "hello"}], "max_tokens": 1})
+        _, inference, _ = run_oc(
+            command=[
+                "oc",
+                "exec",
+                f"deployment/{deployment['metadata']['name']}",
+                "-n",
+                namespace,
+                "--",
+                "curl",
+                "-fsS",
+                "-X",
+                "POST",
+                "-H",
+                "Content-Type: application/json",
+                "-d",
+                payload,
+                "http://localhost:8321/v1/chat/completions",
+            ]
+        )
+        assert json.loads(inference).get("choices")
+
+        legacy = get_resources("llamastackdistribution", namespace)
+        assert legacy, "Legacy LlamaStackDistribution should remain available after upgrade"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
