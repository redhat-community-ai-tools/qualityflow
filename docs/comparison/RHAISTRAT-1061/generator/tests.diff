@@ -0,0 +1,156 @@
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from utilities.image_constants import SharedImages
+
+from tests.runtime_config_in_crd.utils import (
+    apply_and_wait_ready,
+    apply_manifest,
+    ensure_oc_available,
+    get_condition,
+    get_owned_deployment,
+    get_resource,
+    isolated_namespace,
+    run_oc,
+    write_manifest,
+)
+
+
+def _legacy_pvc(namespace: str) -> dict[str, Any]:
+    return {
+        "apiVersion": "v1",
+        "kind": "PersistentVolumeClaim",
+        "metadata": {"name": "llsd-legacy-storage", "namespace": namespace},
+        "spec": {"accessModes": ["ReadWriteOnce"], "resources": {"requests": {"storage": "1Gi"}}},
+    }
+
+
+def _marker_job(namespace: str, name: str, command: list[str]) -> dict[str, Any]:
+    return {
+        "apiVersion": "batch/v1",
+        "kind": "Job",
+        "metadata": {"name": name, "namespace": namespace},
+        "spec": {
+            "backoffLimit": 2,
+            "template": {
+                "metadata": {"labels": {"app": name}},
+                "spec": {
+                    "restartPolicy": "Never",
+                    "containers": [
+                        {
+                            "name": "marker",
+                            "image": SharedImages.BUSYBOX,
+                            "command": command,
+                            "volumeMounts": [{"name": "data", "mountPath": "/data"}],
+                        }
+                    ],
+                    "volumes": [{"name": "data", "persistentVolumeClaim": {"claimName": "llsd-legacy-storage"}}],
+                },
+            },
+        },
+    }
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_adopt_001(tmp_path: Path) -> None:
+    """Given adoption annotations, when an OGXServer is created, then the legacy PVC is adopted and mounted."""
+    ensure_oc_available()
+    with isolated_namespace("adopt-001") as namespace:
+        pvc = _legacy_pvc(namespace)
+        service = {
+            "apiVersion": "v1",
+            "kind": "Service",
+            "metadata": {"name": "llsd-legacy-service", "namespace": namespace},
+            "spec": {"ports": [{"port": 8321}], "selector": {"app": "legacy"}},
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {
+                "name": "ogx-adopt-test",
+                "namespace": namespace,
+                "annotations": {
+                    "ogx.io/adopt-pvc": "llsd-legacy-storage",
+                    "ogx.io/adopt-service": "llsd-legacy-service",
+                },
+            },
+            "spec": {"distribution": {"name": "rh-dev"}, "workload": {"storage": {"size": "1Gi"}}},
+        }
+        apply_manifest(write_manifest(tmp_path, pvc, "adopt-001-pvc"))
+        apply_manifest(write_manifest(tmp_path, service, "adopt-001-service"))
+        apply_and_wait_ready(write_manifest(tmp_path, server, "adopt-001-server"), "ogx-adopt-test", namespace)
+
+        adopted = get_resource("pvc", "llsd-legacy-storage", namespace)
+        owners = adopted.get("metadata", {}).get("ownerReferences", [])
+        assert owners and owners[0].get("kind") == "OGXServer" and owners[0].get("name") == "ogx-adopt-test"
+        condition = get_condition(get_resource("ogxserver", "ogx-adopt-test", namespace), "ResourcesAdopted")
+        assert condition is not None and condition.get("status") == "True"
+
+        deployment = get_owned_deployment(namespace, "ogx-adopt-test")
+        volumes = deployment.get("spec", {}).get("template", {}).get("spec", {}).get("volumes", [])
+        assert any(volume.get("persistentVolumeClaim", {}).get("claimName") == "llsd-legacy-storage" for volume in volumes)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
+def test_tc_adopt_002(tmp_path: Path) -> None:
+    """Given an adopted PVC with marker data, when the OGXServer is deleted, then the PVC and data remain."""
+    ensure_oc_available()
+    with isolated_namespace("adopt-002") as namespace:
+        apply_manifest(write_manifest(tmp_path, _legacy_pvc(namespace), "adopt-002-pvc"))
+        write_job = _marker_job(
+            namespace,
+            "adopt-write",
+            ["/bin/sh", "-c", "echo adoption-integrity-check > /data/test-marker.txt"],
+        )
+        apply_manifest(write_manifest(tmp_path, write_job, "adopt-002-write"))
+        run_oc(command=["oc", "wait", "job/adopt-write", "--for=condition=complete", "--timeout=120s", "-n", namespace])
+
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {
+                "name": "ogx-adopt-test",
+                "namespace": namespace,
+                "annotations": {"ogx.io/adopt-pvc": "llsd-legacy-storage"},
+            },
+            "spec": {"distribution": {"name": "rh-dev"}, "workload": {"storage": {"size": "1Gi"}}},
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "adopt-002-server"), "ogx-adopt-test", namespace)
+        run_oc(command=["oc", "delete", "ogxserver", "ogx-adopt-test", "-n", namespace, "--wait=true"], timeout=300)
+
+        pvc = get_resource("pvc", "llsd-legacy-storage", namespace)
+        assert not pvc.get("metadata", {}).get("ownerReferences")
+        read_job = _marker_job(namespace, "adopt-read", ["/bin/sh", "-c", "cat /data/test-marker.txt"])
+        apply_manifest(write_manifest(tmp_path, read_job, "adopt-002-read"))
+        run_oc(command=["oc", "wait", "job/adopt-read", "--for=condition=complete", "--timeout=120s", "-n", namespace])
+        success, stdout, stderr = run_oc(command=["oc", "logs", "job/adopt-read", "-n", namespace])
+        assert success and stdout.strip() == "adoption-integrity-check", f"Marker read failed: {stderr}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier2
+def test_tc_adopt_003(tmp_path: Path) -> None:
+    """Given invalid adoption annotations, when reconciliation runs, then the operator remains healthy and reports the miss."""
+    ensure_oc_available()
+    with isolated_namespace("adopt-003") as namespace:
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {
+                "name": "ogx-adopt-test",
+                "namespace": namespace,
+                "annotations": {"ogx.io/adopt-pvc": "does-not-exist"},
+            },
+            "spec": {"distribution": {"name": "rh-dev"}, "workload": {"storage": {"size": "1Gi"}}},
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "adopt-003-server"), "ogx-adopt-test", namespace)
+
+        resource = get_resource("ogxserver", "ogx-adopt-test", namespace)
+        condition = get_condition(resource, "ResourcesAdopted")
+        assert condition is not None and condition.get("status") == "False"
+        assert "not found" in str(condition.get("message", "")).lower()
+
