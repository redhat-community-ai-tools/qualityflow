+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_schema_001(tmp_path: Path) -> None:
+    """Given a valid VLLM provider, when the CR is applied, then it reaches Ready without schema errors."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "schema-test-valid"},
+        "spec": {
+            "distribution": {"name": "rh-dev"},
+            "workload": {
+                "overrides": {"env": [{"name": "VLLM_URL", "value": "https://vllm.example.svc:8000/v1"}]},
+                "storage": {"size": "5Gi"},
+            },
+        },
+    }
+    with isolated_namespace("schema-001") as namespace:
+        path = write_manifest(tmp_path, manifest, "schema-001")
+        apply_and_wait_ready(path, "schema-test-valid", namespace)
+        resource = get_resource("ogxserver", "schema-test-valid", namespace)
+        conditions = resource.get("status", {}).get("conditions", [])
+        assert not any("schema" in str(condition.get("message", "")).lower() for condition in conditions)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_schema_002(tmp_path: Path) -> None:
+    """Given a CR missing spec.distribution, when applying it, then admission rejects the required field."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "schema-test-missing"},
+        "spec": {"workload": {"storage": {"size": "5Gi"}}},
+    }
+    with isolated_namespace("schema-002") as namespace:
+        path = write_manifest(tmp_path, manifest, "schema-002")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "Missing spec.distribution must be rejected"
+        assert "distribution" in stderr, f"Unexpected schema error: {stderr}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_schema_003(tmp_path: Path) -> None:
+    """Given an invalid provider_type, when applying the CR, then admission rejects the unsupported value."""
+    ensure_oc_available()
+    manifest: dict[str, Any] = {
+        "apiVersion": "ogx.io/v1beta1",
+        "kind": "OGXServer",
+        "metadata": {"name": "schema-test-invalid-type"},
+        "spec": {
+            "distribution": {"name": "rh-dev"},
+            "providers": [
