+        },
+    }
+    with isolated_namespace("cel-003") as namespace:
+        path = write_manifest(tmp_path, manifest, "cel-003")
+        success, _, stderr = run_oc(command=["oc", "apply", "-f", str(path), "-n", namespace], check=False)
+        assert not success, "CEL validation must reject overrideConfig together with baseConfig"
+        assert "overrideConfig" in stderr and "baseConfig" in stderr, f"Unexpected CEL error: {stderr}"
+
