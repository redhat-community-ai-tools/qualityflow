+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_storage_001(tmp_path: Path) -> None:
+    """Given Postgres storage, when the server starts, then config uses the exact database and credentials."""
+    ensure_oc_available()
+    with isolated_namespace("storage-001") as namespace:
+        secret = {
+            "apiVersion": "v1",
+            "kind": "Secret",
+            "metadata": {"name": "ogx-postgres-secret", "namespace": namespace},
+            "type": "Opaque",
+            "stringData": {"password": "test-postgres-password"},
+        }
+        postgres = {
+            "apiVersion": "apps/v1",
+            "kind": "Deployment",
+            "metadata": {"name": "ogx-postgres", "namespace": namespace},
+            "spec": {
+                "replicas": 1,
+                "selector": {"matchLabels": {"app": "ogx-postgres"}},
+                "template": {
+                    "metadata": {"labels": {"app": "ogx-postgres"}},
+                    "spec": {
+                        "containers": [
+                            {
+                                "name": "postgres",
+                                "image": SharedImages.POSTGRESQL_15,
+                                "env": [
+                                    {"name": "POSTGRESQL_USER", "value": "ogx"},
+                                    {"name": "POSTGRESQL_PASSWORD", "value": "test-postgres-password"},
+                                    {"name": "POSTGRESQL_DATABASE", "value": "ogx_metadata"},
+                                ],
+                                "ports": [{"containerPort": 5432}],
+                            }
+                        ]
+                    },
+                },
+            },
+        }
+        service = {
+            "apiVersion": "v1",
+            "kind": "Service",
+            "metadata": {"name": "ogx-postgres", "namespace": namespace},
+            "spec": {"selector": {"app": "ogx-postgres"}, "ports": [{"port": 5432, "targetPort": 5432}]},
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "ogx-postgres-storage", "namespace": namespace},
+            "spec": {
+                "distribution": {"name": "rh-dev"},
+                "storage": {
+                    "type": "postgres",
+                    "config": {
+                        "host": f"ogx-postgres.{namespace}.svc.cluster.local",
+                        "port": 5432,
+                        "db": "ogx_metadata",
+                        "user": "ogx",
+                        "password": {"valueFrom": {"secretKeyRef": {"name": "ogx-postgres-secret", "key": "password"}}},
+                    },
+                },
+            },
+        }
+        for index, manifest in enumerate((secret, postgres, service)):
+            apply_manifest(write_manifest(tmp_path, manifest, f"storage-001-{index}"))
+        run_oc(command=["oc", "wait", "deployment/ogx-postgres", "--for=condition=Available", "--timeout=180s", "-n", namespace])
+        apply_and_wait_ready(write_manifest(tmp_path, server, "storage-001-server"), "ogx-postgres-storage", namespace)
+
+        config = get_generated_config(get_generated_configmap(namespace, "ogx-postgres-storage"))
+        storage = config.get("metadata_store", {})
+        assert storage.get("type") == "postgres"
+        assert storage.get("host") == f"ogx-postgres.{namespace}.svc.cluster.local"
+        assert storage.get("port") == 5432
+        assert storage.get("db") == "ogx_metadata"
+        assert storage.get("user") == "ogx"
+        assert "test-postgres-password" not in str(config)
+
