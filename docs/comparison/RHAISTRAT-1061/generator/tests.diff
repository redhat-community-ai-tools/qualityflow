+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from utilities.image_constants import SharedImages
+
+from tests.runtime_config_in_crd.utils import (
+    apply_and_wait_ready,
+    apply_manifest,
+    ensure_oc_available,
+    get_generated_config,
+    get_generated_configmap,
+    get_owned_deployment,
+    get_resources,
+    isolated_namespace,
+    run_oc,
+    run_oc_json,
+    write_manifest,
+)
+
+
+def _postgres(namespace: str) -> list[dict[str, Any]]:
+    secret = {
+        "apiVersion": "v1",
+        "kind": "Secret",
+        "metadata": {"name": "ogx-postgres-secret", "namespace": namespace},
+        "type": "Opaque",
+        "stringData": {"password": "test-postgres-password"},
+    }
+    deployment = {
+        "apiVersion": "apps/v1",
+        "kind": "Deployment",
+        "metadata": {"name": "ogx-postgres", "namespace": namespace},
+        "spec": {
+            "replicas": 1,
+            "selector": {"matchLabels": {"app": "ogx-postgres"}},
+            "template": {
+                "metadata": {"labels": {"app": "ogx-postgres"}},
+                "spec": {
+                    "containers": [
+                        {
+                            "name": "postgres",
+                            "image": SharedImages.POSTGRESQL_15,
+                            "env": [
+                                {"name": "POSTGRESQL_USER", "value": "ogx"},
+                                {"name": "POSTGRESQL_PASSWORD", "value": "test-postgres-password"},
+                                {"name": "POSTGRESQL_DATABASE", "value": "ogx_metadata"},
+                            ],
+                            "ports": [{"containerPort": 5432}],
+                        }
+                    ]
+                },
+            },
+        },
+    }
+    service = {
+        "apiVersion": "v1",
+        "kind": "Service",
+        "metadata": {"name": "ogx-postgres", "namespace": namespace},
+        "spec": {"selector": {"app": "ogx-postgres"}, "ports": [{"port": 5432, "targetPort": 5432}]},
+    }
+    return [secret, deployment, service]
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+@pytest.mark.skip_on_disconnected
+def test_tc_e2e_001(tmp_path: Path) -> None:
+    """Given providers and storage, when the server starts, then config, health, and inference all succeed."""
+    ensure_oc_available()
+    with isolated_namespace("e2e-001") as namespace:
+        inference_secret = {
+            "apiVersion": "v1",
+            "kind": "Secret",
+            "metadata": {"name": "ogx-inference-secret", "namespace": namespace},
+            "type": "Opaque",
+            "stringData": {"VLLM_URL": "https://vllm.example.svc/v1", "VLLM_API_TOKEN": "test-token"},
+        }
+        for index, manifest in enumerate((inference_secret, *_postgres(namespace))):
+            apply_manifest(write_manifest(tmp_path, manifest, f"e2e-001-{index}"))
+        run_oc(command=["oc", "wait", "deployment/ogx-postgres", "--for=condition=Available", "--timeout=180s", "-n", namespace])
+
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "ogx-e2e-test", "namespace": namespace},
+            "spec": {
+                "replicas": 1,
+                "distribution": {"name": "rh-dev"},
+                "workload": {
+                    "overrides": {
+                        "env": [
+                            {"name": "VLLM_URL", "valueFrom": {"secretKeyRef": {"name": "ogx-inference-secret", "key": "VLLM_URL"}}},
+                            {"name": "VLLM_API_TOKEN", "valueFrom": {"secretKeyRef": {"name": "ogx-inference-secret", "key": "VLLM_API_TOKEN"}}},
+                            {"name": "POSTGRES_HOST", "value": f"ogx-postgres.{namespace}.svc.cluster.local"},
+                            {"name": "POSTGRES_PORT", "value": "5432"},
+                            {"name": "POSTGRES_DB", "value": "ogx_metadata"},
+                            {"name": "POSTGRES_USER", "value": "ogx"},
+                            {"name": "POSTGRES_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "ogx-postgres-secret", "key": "password"}}},
+                        ]
+                    },
+                    "storage": {"size": "1Gi"},
+                },
+            },
+        }
+        apply_and_wait_ready(write_manifest(tmp_path, server, "e2e-001-server"), "ogx-e2e-test", namespace)
+
+        deployment = get_owned_deployment(namespace, "ogx-e2e-test")
+        assert deployment.get("spec", {}).get("replicas") == 1
+        config = get_generated_config(get_generated_configmap(namespace, "ogx-e2e-test"))
+        assert config.get("providers") and config.get("metadata_store")
+
+        _, health, _ = run_oc(command=["oc", "exec", f"deployment/{deployment['metadata']['name']}", "-n", namespace, "--", "curl", "-fsS", "http://localhost:8321/health"])
+        assert json.loads(health).get("status") in ("ok", "healthy")
+
+        payload = json.dumps({"model": "test-model", "messages": [{"role": "user", "content": "hello"}], "max_tokens": 1})
+        _, inference, _ = run_oc(
+            command=[
+                "oc",
+                "exec",
+                f"deployment/{deployment['metadata']['name']}",
+                "-n",
+                namespace,
+                "--",
+                "curl",
+                "-fsS",
+                "-X",
+                "POST",
+                "-H",
+                "Content-Type: application/json",
+                "-d",
+                payload,
+                "http://localhost:8321/v1/chat/completions",
+            ]
+        )
+        assert json.loads(inference).get("choices")
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_e2e_002(tmp_path: Path) -> None:
+    """Given overrideConfig, when the server starts, then the custom ConfigMap is used directly."""
+    ensure_oc_available()
+    with isolated_namespace("e2e-002") as namespace:
+        custom_config = {
+            "version": "2",
+            "apis": ["inference", "safety"],
+            "providers": {
+                "inference": [{"provider_id": "stub-inference", "provider_type": "inline::meta-reference"}],
+                "safety": [{"provider_id": "stub-safety", "provider_type": "inline::llama-guard"}],
+            },
+        }
+        configmap = {
+            "apiVersion": "v1",
+            "kind": "ConfigMap",
+            "metadata": {"name": "ogx-custom-config", "namespace": namespace},
+            "data": {"config.yaml": yaml.safe_dump(custom_config)},
+        }
+        server = {
+            "apiVersion": "ogx.io/v1beta1",
+            "kind": "OGXServer",
+            "metadata": {"name": "ogx-override-test", "namespace": namespace},
+            "spec": {
+                "replicas": 1,
+                "distribution": {"name": "rh-dev"},
+                "overrideConfig": {"configMapRef": {"name": "ogx-custom-config", "key": "config.yaml"}},
+            },
+        }
+        apply_manifest(write_manifest(tmp_path, configmap, "e2e-002-cm"))
+        apply_and_wait_ready(write_manifest(tmp_path, server, "e2e-002-server"), "ogx-override-test", namespace)
+
+        deployment = get_owned_deployment(namespace, "ogx-override-test")
+        volumes = deployment.get("spec", {}).get("template", {}).get("spec", {}).get("volumes", [])
