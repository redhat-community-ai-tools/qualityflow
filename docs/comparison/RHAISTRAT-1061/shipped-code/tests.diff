+package config
+
+import (
+	"strings"
+	"testing"
+
+	ogxiov1beta1 "github.com/ogx-ai/ogx-k8s-operator/api/v1beta1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/serializer"
+)
+
+const qfBaseConfig = `version: '2'
+distro_name: starter
+image_name: starter
+apis:
+- inference
+- vector_io
+providers:
+  inference:
+  - provider_id: default-vllm
+    provider_type: remote::vllm
+    config:
+      url: http://default:8000
+models:
+- model_id: default-model
+  provider_id: default-vllm
+  model_type: llm
+vector_stores:
+  default_provider_id: faiss
+`
+
+func qfMinimalDeclarativeSpec() *ogxiov1beta1.OGXServerSpec {
+	return &ogxiov1beta1.OGXServerSpec{
+		Distribution: ogxiov1beta1.DistributionSpec{Name: "starter"},
+		Providers: &ogxiov1beta1.ProvidersSpec{
+			Inference: &ogxiov1beta1.InferenceProvidersSpec{
+				Remote: &ogxiov1beta1.InferenceRemoteProviders{
+					OpenAI: []ogxiov1beta1.OpenAIProvider{
+						{
+							RoutedProviderBase: ogxiov1beta1.RoutedProviderBase{ID: "openai-primary"},
+							APIKey:             ogxiov1beta1.SecretKeyRef{Name: "openai-creds", Key: "api-key"},
+						},
+					},
+				},
+			},
+		},
+		Resources: &ogxiov1beta1.ResourcesSpec{
+			Models: []ogxiov1beta1.ModelConfig{
+				{Name: "gpt-4o-mini", Provider: "openai-primary"},
+			},
+		},
+	}
+}
+
+func TestQFMinimalDeclarativeConfigIsUsable(t *testing.T) {
+	// STP: outputs/RHAISTRAT-1061/stp/RHAISTRAT-1061_test_plan.md
+	generated, err := GenerateConfig(qfMinimalDeclarativeSpec(), []byte(qfBaseConfig), false)
+	if err != nil {
+		t.Fatalf("GenerateConfig returned error: %v", err)
+	}
+	if generated.ConfigYAML == "" || generated.ContentHash == "" {
+		t.Fatal("expected generated config and content hash")
+	}
+	for _, want := range []string{
+		"provider_id: openai-primary",
+		"provider_type: remote::openai",
+		"model_id: gpt-4o-mini",
+		"${env.OGX_OPENAI_PRIMARY_API_KEY}",
+	} {
+		if !strings.Contains(generated.ConfigYAML, want) {
+			t.Fatalf("generated config missing %q:\n%s", want, generated.ConfigYAML)
+		}
+	}
+	if generated.ProviderCount < 1 || generated.ResourceCount < 1 {
+		t.Fatalf("expected provider and resource counts >= 1, got providers=%d resources=%d", generated.ProviderCount, generated.ResourceCount)
+	}
+}
+
+func TestQFGeneratedConfigDoesNotExposeSecretValues(t *testing.T) {
+	// STP: outputs/RHAISTRAT-1061/stp/RHAISTRAT-1061_test_plan.md
+	generated, err := GenerateConfig(qfMinimalDeclarativeSpec(), []byte(qfBaseConfig), false)
+	if err != nil {
+		t.Fatalf("GenerateConfig returned error: %v", err)
+	}
+	if !strings.Contains(generated.ConfigYAML, "${env.OGX_OPENAI_PRIMARY_API_KEY}") {
+		t.Fatalf("generated config does not reference the secret-backed environment variable:\n%s", generated.ConfigYAML)
+	}
+	if strings.Contains(generated.ConfigYAML, "super-secret-api-key") {
+		t.Fatal("generated config exposed a literal secret value")
+	}
+	found := false
+	for _, env := range generated.EnvVars {
+		if env.Name == "OGX_OPENAI_PRIMARY_API_KEY" && env.ValueFrom != nil && env.ValueFrom.SecretKeyRef != nil {
+			ref := env.ValueFrom.SecretKeyRef
+			found = ref.Name == "openai-creds" && ref.Key == "api-key"
+		}
+	}
+	if !found {
+		t.Fatalf("expected SecretKeyRef openai-creds/api-key, got env vars %+v", generated.EnvVars)
+	}
+}
+
+func TestQFOnlyCurrentAPIVersionIsAccepted(t *testing.T) {
+	// STP: outputs/RHAISTRAT-1061/stp/RHAISTRAT-1061_test_plan.md
+	scheme := runtime.NewScheme()
+	if err := ogxiov1beta1.AddToScheme(scheme); err != nil {
+		t.Fatalf("failed to register v1beta1 scheme: %v", err)
+	}
+	codec := serializer.NewCodecFactory(scheme).UniversalDeserializer()
+
+	current := []byte(`apiVersion: ogx.io/v1beta1
+kind: OGXServer
+metadata:
+  name: current-api-resource
+spec:
+  distribution:
+    name: starter
+`)
+	obj, _, err := codec.Decode(current, nil, nil)
+	if err != nil {
+		t.Fatalf("current API version was rejected: %v", err)
+	}
+	if _, ok := obj.(*ogxiov1beta1.OGXServer); !ok {
+		t.Fatalf("current API version decoded to %T, expected *OGXServer", obj)
+	}
+
+	previous := []byte(`apiVersion: ogx.io/v1alpha1
+kind: LlamaStackDistribution
+metadata:
+  name: previous-api-resource
+spec:
+  distribution:
+    name: starter
+`)
+	if _, _, err := codec.Decode(previous, nil, nil); err == nil {
+		t.Fatal("previous API version was accepted by the v1beta1 scheme")
+	}
+}
