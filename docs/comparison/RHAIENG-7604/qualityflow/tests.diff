+
+    def test_missing_and_empty_tenants_use_fallback(
+        self,
+        ogx_client: OgxClient,
+        ogx_models: ModelInfo,
+        ogx_postgres_pod: Pod,
+        ogx_server: OgxServer,
+        ogx_connection_string_secret: Secret,
+        praxis_connection_string_secret: Secret,
+        praxis_postgres_pod: Pod,
+        praxis_gateway_route: Route,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """Scenario: TS-RHAIENG-7604-003 applies tenant fallback to null and empty values.
+
+        Jira: https://redhat.atlassian.net/browse/RHAIENG-7604
+        """
+        seeds = [
+            _seed_paths(
+                ogx_client=ogx_client,
+                ogx_models=ogx_models,
+                ogx_postgres_pod=ogx_postgres_pod,
+                identity=SourceIdentity(tenant_id=missing_value, owner_principal="qf-source-owner"),
+            )
+            for missing_value in (None, "")
+        ]
+        _reset_praxis_tables(praxis_postgres_pod=praxis_postgres_pod)
+        _run_migration(
+            unprivileged_client=unprivileged_client,
+            ogx_server=ogx_server,
+            ogx_connection_string_secret=ogx_connection_string_secret,
+            praxis_connection_string_secret=praxis_connection_string_secret,
+            fallback_tenant=FALLBACK_TENANT,
+            fallback_owner_subject=None,
+            expect_success=True,
+        )
+        target_rows = _query_target_rows(praxis_postgres_pod=praxis_postgres_pod)
+        for seed in seeds:
+            _assert_seed(
+                seed=seed,
+                expected_tenant=FALLBACK_TENANT,
+                expected_owner="qf-source-owner",
+                target_rows=target_rows,
+            )
+
+    def test_mixed_tenants_preserve_source_and_fallback(
+        self,
+        ogx_client: OgxClient,
+        ogx_models: ModelInfo,
+        ogx_postgres_pod: Pod,
+        ogx_server: OgxServer,
+        ogx_connection_string_secret: Secret,
+        praxis_connection_string_secret: Secret,
+        praxis_postgres_pod: Pod,
+        praxis_gateway_route: Route,
+        unprivileged_client: DynamicClient,
+    ) -> None:
+        """Scenario: TS-RHAIENG-7604-004 preserves source-or-fallback tenant assignments.
+
+        Jira: https://redhat.atlassian.net/browse/RHAIENG-7604
+        """
+        identities = (SourceIdentity("qf-tenant-a", "qf-owner-a"), SourceIdentity(None, "qf-owner-b"), SourceIdentity("", "qf-owner-c"))
+        seeds = [
+            _seed_paths(
+                ogx_client=ogx_client,
+                ogx_models=ogx_models,
+                ogx_postgres_pod=ogx_postgres_pod,
+                identity=identity,
+            )
+            for identity in identities
+        ]
+        _reset_praxis_tables(praxis_postgres_pod=praxis_postgres_pod)
+        _run_migration(
+            unprivileged_client=unprivileged_client,
+            ogx_server=ogx_server,
+            ogx_connection_string_secret=ogx_connection_string_secret,
+            praxis_connection_string_secret=praxis_connection_string_secret,
+            fallback_tenant=FALLBACK_TENANT,
+            fallback_owner_subject=None,
+            expect_success=True,
+        )
+        target_rows = _query_target_rows(praxis_postgres_pod=praxis_postgres_pod)
+        for identity, seed in zip(identities, seeds, strict=True):
+            _assert_seed(
+                seed=seed,
+                expected_tenant=identity.tenant_id or FALLBACK_TENANT,
+                expected_owner=identity.owner_principal or "",
+                target_rows=target_rows,
+            )
+
+    def test_missing_tenants_fail_without_fallback(
