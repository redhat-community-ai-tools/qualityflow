+"""Negative coverage for missing Praxis state ownership fallbacks."""
+
+from typing import Any
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ogx_client import OgxClient
+from ocp_resources.job import Job
+from ocp_resources.pod import Pod
+from ocp_resources.resource import ResourceEditor
+from ocp_resources.route import Route
+from ocp_resources.secret import Secret
+
+from tests.ogx.praxis.constants import (
+    OGX_CONNECTION_SECRET_KEY,
+    OGX_POSTGRES_DATABASE,
+    PRAXIS_CONNECTION_SECRET_KEY,
+    PRAXIS_POSTGRES_DATABASE,
+    SOURCE_CONVERSATIONS_TABLE,
+    TARGET_CONVERSATIONS_TABLE,
+)
+from tests.ogx.conftest import *  # noqa: F403
+from tests.ogx.praxis.conftest import *  # noqa: F403
+from tests.ogx.praxis.utils import query_database, seed_conversations
+from utilities.resources.ogx_server import OgxServer
+
+
+NAMESPACE_PARAMS: dict[str, Any] = {"name": "test-ogx-praxis-missing-ownership", "randomize_name": True}
+OGX_SERVER_PARAMS: dict[str, Any] = {
+    "ogx_storage_size": "2Gi",
+    "vector_io_provider": "pgvector",
+    "files_provider": "local",
+    "cpu_requests": "500m",
+    "cpu_limits": "2",
+}
+_MIGRATION_JOB_NAME_SUFFIX: str = "-praxis-migration"
+_MIGRATION_JOB_TIMEOUT: int = 600
+_SQL_SCRIPT: str = (
+    'export PGPASSWORD="$POSTGRESQL_PASSWORD"; '
+    'exec psql --host 127.0.0.1 --username "$POSTGRESQL_USER" --dbname "$1" '
+    '--tuples-only --no-align --quiet --set ON_ERROR_STOP=1 --command "$2"'
+)
+
+
+def _sql_literal(value: str) -> str:
+    """Return a safely escaped PostgreSQL string literal."""
+    return f"'{value.replace("'", "''")}'"
+
+
+def _execute_sql(database: str, sql_statement: str, postgres_pod: Pod) -> None:
+    """Execute a test-owned SQL statement in a PostgreSQL pod."""
+    postgres_pod.execute(
+        command=["sh", "-c", _SQL_SCRIPT, "sh", database, sql_statement],
+        container="postgres",
+    )
+
+
+def _assert_ownership_schema(ogx_postgres_pod: Pod, praxis_postgres_pod: Pod) -> None:
+    """Fail when either database lacks the state-ownership schema."""
+    source_columns = {
+        row["column_name"]
+        for row in query_database(
+            postgres_pod=ogx_postgres_pod,
+            database=OGX_POSTGRES_DATABASE,
+            select_statement=(
+                "SELECT column_name FROM information_schema.columns "
+                f"WHERE table_name = {SOURCE_CONVERSATIONS_TABLE!r}"
+            ),
+        )
+    }
+    target_columns = {
+        row["column_name"]
+        for row in query_database(
+            postgres_pod=praxis_postgres_pod,
+            database=PRAXIS_POSTGRES_DATABASE,
+            select_statement=(
+                "SELECT column_name FROM information_schema.columns "
+                f"WHERE table_name = {TARGET_CONVERSATIONS_TABLE!r}"
+            ),
+        )
+    }
+    assert {"tenant_id", "owner_principal"} <= source_columns, (
+        "The source schema lacks RHAIENG-7604 ownership columns"
+    )
+    assert {"tenant_id", "owner_subject", "owner_issuer"} <= target_columns, (
+        "The target schema lacks RHAIENG-7604 ownership columns"
+    )
+
+
+def _run_failed_migration(
+    ogx_server: OgxServer,
+    unprivileged_client: DynamicClient,
+    ogx_connection_string_secret: Secret,
+    praxis_connection_string_secret: Secret,
+) -> Job:
+    """Run migration without ownership fallbacks and wait for Job failure."""
+    ResourceEditor(
+        patches={
+            ogx_server: {
+                "spec": {
+                    "storage": {
+                        "sql": {
+                            "type": "postgres",
+                            "connectionString": {
+                                "name": ogx_connection_string_secret.name,
+                                "key": OGX_CONNECTION_SECRET_KEY,
+                            },
+                        },
+                    },
+                    "praxisMode": {
+                        "enabled": True,
+                        "migrationJob": {
+                            "enabled": True,
+                            "targetConnectionString": {
+                                "name": praxis_connection_string_secret.name,
+                                "key": PRAXIS_CONNECTION_SECRET_KEY,
+                            },
+                        },
+                    },
+                },
+            },
+        },
+    ).update()
+
+    job = Job(
+        client=unprivileged_client,
+        name=f"{ogx_server.name}{_MIGRATION_JOB_NAME_SUFFIX}",
+        namespace=ogx_server.namespace,
+    )
+    job.wait(timeout=_MIGRATION_JOB_TIMEOUT)
+    job.wait_for_condition(condition="Failed", status="True", timeout=_MIGRATION_JOB_TIMEOUT)
+    return job
+
+
+def _migration_job_logs(client: DynamicClient, job: Job) -> str:
+    """Return logs from the pod created by `job`."""
+    pods = list(Pod.get(client=client, namespace=job.namespace, label_selector=f"job-name={job.name}"))
+    assert pods, f"No pod was created for migration Job {job.name}"
+    return "\n".join(pod.log() for pod in pods)
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [pytest.param(NAMESPACE_PARAMS, OGX_SERVER_PARAMS)],
+    indirect=True,
+)
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_neg_001(
+    unprivileged_client: DynamicClient,
+    ogx_server: OgxServer,
+    ogx_connection_string_secret: Secret,
+    praxis_connection_string_secret: Secret,
+    praxis_gateway_route: Route,
+    ogx_postgres_pod: Pod,
+    praxis_postgres_pod: Pod,
+    ogx_client: OgxClient,
+) -> None:
+    """TC-NEG-001: Verify missing tenant without fallback fails clearly.
+
+    Given a source row with no tenant and a present owner principal.
+    When migration runs without a fallback tenant.
+    Then the Job fails, its log identifies both conditions, and no row migrates.
+    """
+    _assert_ownership_schema(ogx_postgres_pod=ogx_postgres_pod, praxis_postgres_pod=praxis_postgres_pod)
+    conversation_id = seed_conversations(ogx_client=ogx_client, count=1)[0]
+    _execute_sql(
+        database=OGX_POSTGRES_DATABASE,
+        sql_statement=(
+            f"UPDATE {SOURCE_CONVERSATIONS_TABLE} SET tenant_id = NULL, "
+            f"owner_principal = {_sql_literal('principal-batch-02')} "
+            f"WHERE id = {_sql_literal(conversation_id)}"
+        ),
+        postgres_pod=ogx_postgres_pod,
+    )
+
+    job = _run_failed_migration(
+        ogx_server=ogx_server,
+        unprivileged_client=unprivileged_client,
+        ogx_connection_string_secret=ogx_connection_string_secret,
+        praxis_connection_string_secret=praxis_connection_string_secret,
+    )
+    logs = _migration_job_logs(client=unprivileged_client, job=job)
+    normalized_logs = " ".join(logs.split()).casefold()
+    assert "tenant_id" in normalized_logs, "Migration error must identify the missing tenant_id"
+    assert "fallback" in normalized_logs, "Migration error must state that no fallback tenant was provided"
+
+    target_rows = query_database(
+        postgres_pod=praxis_postgres_pod,
+        database=PRAXIS_POSTGRES_DATABASE,
+        select_statement=(
+            f"SELECT conversation_id FROM {TARGET_CONVERSATIONS_TABLE} "
+            f"WHERE conversation_id = {_sql_literal(conversation_id)}"
+        ),
+    )
+    assert not target_rows, "The failed fixture row must not be reported as a successful migration"
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [pytest.param(NAMESPACE_PARAMS, OGX_SERVER_PARAMS)],
+    indirect=True,
+)
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_neg_002(
+    unprivileged_client: DynamicClient,
+    ogx_server: OgxServer,
+    ogx_connection_string_secret: Secret,
+    praxis_connection_string_secret: Secret,
+    praxis_gateway_route: Route,
+    ogx_postgres_pod: Pod,
+    praxis_postgres_pod: Pod,
+    ogx_client: OgxClient,
+) -> None:
+    """TC-NEG-002: Verify missing owner subject without fallback fails clearly.
+
+    Given a source row with a present tenant and no owner principal.
+    When migration runs without a fallback owner subject.
+    Then the Job fails, its log identifies both conditions, and no row migrates.
