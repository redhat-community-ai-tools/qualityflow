+def _shared_external_model_kind_dict(
+    model_name: str,
+    namespace: str,
+    provider_name: str,
+    path_tag: str,
+    gateway_name: str,
+    gateway_namespace: str,
+) -> dict[str, Any]:
+    """Build an ExternalModel attached to one tenant Gateway."""
+    return {
+        "apiVersion": f"{ApiGroups.INFERENCE_OPENDATAHUB_IO}/v1alpha1",
+        "kind": "ExternalModel",
+        "metadata": {"name": model_name, "namespace": namespace},
+        "spec": {
+            "externalProviderRefs": [
+                {
+                    "ref": {"name": provider_name},
+                    "targetModel": "gpt-3.5-turbo",
+                    "apiFormat": "openai-chat",
+                    "path": f"/anything/{path_tag}",
+                },
+            ],
+            "gatewayRefs": [{"name": gateway_name, "namespace": gateway_namespace}],
+            "modelName": model_name,
+        },
+    }
+
+
+def _shared_maas_model_ref_kind_dict(
