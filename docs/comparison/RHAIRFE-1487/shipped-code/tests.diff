+    @pytest.mark.tier2
+    def test_independent_tenant_rate_limit_enforcement(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_inference_url: str,
+        tenant_b_inference_url: str,
+        tenant_inference_chat_payload: dict[str, Any],
+        qf_rate_limit_api_keys: list[dict[str, Any]],
+    ) -> None:
+        """Given asymmetric token limits, when tenant A exhausts its limit,
+        then tenant B continues to receive successful responses.
+        """
+        tenant_a_payload = dict(tenant_inference_chat_payload)
+        tenant_a_payload["max_tokens"] = 1
+        tenant_a_statuses: list[int] = []
+        for _attempt in range(QF_RATE_LIMIT_ATTEMPTS):
+            response = request_session_http.post(
+                url=tenant_a_inference_url,
+                headers={"Authorization": f"Bearer {qf_rate_limit_api_keys[0]['key']}"},
+                json=tenant_a_payload,
+                timeout=60,
+            )
+            tenant_a_statuses.append(response.status_code)
+            if response.status_code == 429:
+                break
+
+        assert_mixed_200_and_429(
+            actor_label="tenant A",
+            status_codes_list=tenant_a_statuses,
+            context="asymmetric token-rate limit exhaustion",
+        )
+
+        tenant_b_response = request_session_http.post(
+            url=tenant_b_inference_url,
+            headers={"Authorization": f"Bearer {qf_rate_limit_api_keys[1]['key']}"},
+            json=tenant_inference_chat_payload,
+            timeout=60,
+        )
+        assert tenant_b_response.status_code == 200, (
+            f"Tenant B should remain successful after tenant A is limited, "
+            f"got {tenant_b_response.status_code}: {tenant_b_response.text[:300]}"
+        )
