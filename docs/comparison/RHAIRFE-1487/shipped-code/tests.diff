+def _dashboard_names(admin_client: DynamicClient) -> set[str]:
+    """Return the names of all installed Perses dashboards."""
+    dashboard_resource = admin_client.resources.get(api_version="perses.dev/v1alpha1", kind="PersesDashboard")
+    return {dashboard.metadata.name for dashboard in dashboard_resource.get().items}
+
+
+def _wait_for_positive_metric(prometheus: Prometheus, query: str) -> None:
+    """Wait until a Prometheus query returns a positive numeric value."""
+    for value in TimeoutSampler(
+        wait_timeout=QF_USAGE_LOGS_WAIT_TIMEOUT,
+        sleep=QF_USAGE_LOGS_WAIT_SLEEP,
+        func=get_metrics_value,
+        prometheus=prometheus,
+        metrics_query=query,
+    ):
+        if value is not None and float(value) > 0:
+            return
+    raise AssertionError(f"Timed out waiting for positive Prometheus result: {query}")
+
+
+def _loki_subscription_count(
+    http_session: requests.Session,
+    admin_token: str,
+    subscription_name: str,
+) -> int:
+    """Return the number of usage-log records attributed to a subscription."""
+    logql_query = (
+        'sum(count_over_time({service_name="models-as-a-service", '
+        f'subscription="{subscription_name}"}}[1h]))'
+    )
+    return loki_query_value(
+        query_response=query_loki_instant(
+            http_session=http_session,
+            admin_token=admin_token,
+            logql_query=logql_query,
+        ),
+    )
+
+
+def _wait_for_positive_loki_count(
+    http_session: requests.Session,
+    admin_token: str,
+    subscription_name: str,
+) -> None:
+    """Wait until Loki has at least one usage record for a subscription."""
+    for count in TimeoutSampler(
+        wait_timeout=QF_USAGE_LOGS_WAIT_TIMEOUT,
+        sleep=QF_USAGE_LOGS_WAIT_SLEEP,
+        func=_loki_subscription_count,
+        http_session=http_session,
+        admin_token=admin_token,
+        subscription_name=subscription_name,
+    ):
+        if count > 0:
+            return
+    raise AssertionError(f"Timed out waiting for Loki usage records for subscription {subscription_name!r}")
+
