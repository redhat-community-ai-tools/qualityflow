+from collections.abc import Generator
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+
+from tests.ai_gateway.models_as_a_service.utils import aitenant_from_spec
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import (
+    AITenantTestContext,
+    build_aitenant_test_context,
+)
+from utilities.resources.aitenant import AITenant
+
+
+def pytest_configure(config):
+    config.addinivalue_line(
+        "markers",
+        "qf_test_id(id): QualityFlow scenario id",
+    )
+
+
+@pytest.fixture
+def aitenant_missing_gateway(
+    admin_client: DynamicClient,
+    aitenant_infra_namespace: str,
+    aitenant_test_params: dict,
+    teardown_resources: bool,
+) -> Generator[AITenant, None, None]:
+    """Deploy an AITenant whose prerequisite bootstrap Gateway does not exist."""
+    aitenant = aitenant_from_spec(
+        admin_client=admin_client,
+        aitenant_name=aitenant_test_params["aitenant_name"],
+        cr_namespace=aitenant_infra_namespace,
+        aitenant_spec=aitenant_test_params["aitenant_spec"],
+        teardown=teardown_resources,
+    )
+    with aitenant:
+        yield aitenant
+
+
+@pytest.fixture
+def ready_aitenant_for_deletion(
+    aitenant_for_test: AITenant,
+) -> AITenantTestContext:
+    """Return a Ready AITenant whose deletion is owned by the test."""
+    return build_aitenant_test_context(aitenant=aitenant_for_test)
