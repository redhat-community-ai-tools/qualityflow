+from __future__ import annotations
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.namespace import Namespace
+
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import (
+    AITenantTestContext,
+    delete_aitenant_and_wait,
+    verify_aitenant_bootstrap_children_removed,
+    verify_default_maas_tenant_unaffected,
+    verify_tenant_namespace_aitenant_metadata_stripped,
+    verify_tenant_namespace_preserved,
+)
+from tests.ai_gateway.models_as_a_service.utils import verify_aitenant_ready
+
+
+@pytest.mark.usefixtures("maas_subscription_controller_enabled_latest", "aitenant_infra_namespace")
+class TestMaasMultiTenancyCleanup:
+    """Verify tenant deletion removes owned resources without harming other tenants."""
+
+    @pytest.mark.tier1
+    def test_tc_cleanup_001(
+        self,
+        admin_client: DynamicClient,
+        aitenant_infra_namespace: str,
+        ready_aitenant_for_deletion: AITenantTestContext,
+    ) -> None:
+        """TC-CLEANUP-001: Verify tenant deletion removes controller-owned resources."""
+        delete_aitenant_and_wait(aitenant=ready_aitenant_for_deletion["aitenant"])
+        verify_aitenant_bootstrap_children_removed(
+            admin_client=admin_client,
+            test_context=ready_aitenant_for_deletion,
+            infra_namespace=aitenant_infra_namespace,
+        )
+        verify_tenant_namespace_preserved(
+            admin_client=admin_client,
+            tenant_namespace_name=ready_aitenant_for_deletion["tenant_namespace_name"],
+        )
+        verify_tenant_namespace_aitenant_metadata_stripped(
+            admin_client=admin_client,
+            tenant_namespace_name=ready_aitenant_for_deletion["tenant_namespace_name"],
+        )
+
+    @pytest.mark.tier1
+    def test_tc_cleanup_002(
+        self,
+        admin_client: DynamicClient,
+        two_aitenant_test_contexts: tuple[AITenantTestContext, AITenantTestContext],
+    ) -> None:
+        """TC-CLEANUP-002: Verify deleting one tenant leaves another tenant active."""
+        deleted_tenant, surviving_tenant = two_aitenant_test_contexts
+        delete_aitenant_and_wait(aitenant=deleted_tenant["aitenant"])
+
+        verify_aitenant_ready(aitenant=surviving_tenant["aitenant"])
+        surviving_namespace = Namespace(
+            client=admin_client,
+            name=surviving_tenant["tenant_namespace_name"],
+            ensure_exists=True,
+        )
+        assert surviving_namespace.exists, (
+            f"Surviving tenant namespace '{surviving_tenant['tenant_namespace_name']}' was removed"
+        )
+        assert surviving_namespace.instance.status.phase == "Active", (
+            f"Surviving tenant namespace phase should be Active, got "
+            f"{surviving_namespace.instance.status.phase!r}"
+        )
+        verify_default_maas_tenant_unaffected(admin_client=admin_client)
