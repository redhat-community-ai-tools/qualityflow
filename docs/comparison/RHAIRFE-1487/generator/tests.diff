+from __future__ import annotations
+
+import pytest
+import requests
+
+from tests.ai_gateway.models_as_a_service.maas_api_key.utils import get_api_key, list_api_keys
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import AITenantTestContext
+from tests.ai_gateway.models_as_a_service.multitenancy.utils import (
+    assert_api_key_search_excludes_ids,
+    assert_api_key_search_includes_ids,
+    isolation_tenant_api_key_id,
+    isolation_tenant_api_key_plaintext,
+)
+from tests.ai_gateway.models_as_a_service.utils import (
+    assert_api_key_created_ok,
+    create_api_key,
+    revoke_api_key,
+)
+from utilities.general import generate_random_name
+
+
+@pytest.mark.usefixtures(
+    "maas_subscription_controller_enabled_latest",
+    "aitenant_infra_namespace",
+    "isolation_tenant_governance",
+    "per_tenant_maas_api_ready",
+)
+class TestMaasMultiTenancyApiKey:
+    """Verify API-key persistence, validation, and tenant isolation."""
+
+    @pytest.mark.tier1
+    def test_tc_apikey_001(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        tenant_a_subscription_name: str,
+        current_client_token: str,
+        two_aitenant_test_contexts: tuple[AITenantTestContext, AITenantTestContext],
+    ) -> None:
+        """TC-APIKEY-001: Verify tenant API-key creation persists the tenant field."""
+        tenant_a_name = two_aitenant_test_contexts[0]["aitenant_name"]
+        create_response, create_body = create_api_key(
+            base_url=tenant_a_base_url,
+            ocp_user_token=current_client_token,
+            request_session_http=request_session_http,
+            api_key_name=f"tc-apikey-001-{generate_random_name()}",
+            subscription=tenant_a_subscription_name,
+        )
+        assert_api_key_created_ok(resp=create_response, body=create_body, required_fields=("id", "key"))
+        key_id = create_body["id"]
+
+        get_response, get_body = get_api_key(
+            request_session_http=request_session_http,
+            base_url=tenant_a_base_url,
+            key_id=key_id,
+            ocp_user_token=current_client_token,
+        )
+        assert get_response.status_code == 200, (
+            f"Expected 200 when reading tenant API key {key_id}, got {get_response.status_code}: "
+            f"{get_response.text[:200]}"
+        )
+        assert get_body.get("tenant") == tenant_a_name, (
+            f"API key {key_id} should persist tenant={tenant_a_name!r}, got {get_body.get('tenant')!r}"
+        )
+
+        revoke_response, _ = revoke_api_key(
+            request_session_http=request_session_http,
+            base_url=tenant_a_base_url,
+            key_id=key_id,
+            ocp_user_token=current_client_token,
+        )
+        assert revoke_response.status_code == 200, (
+            f"Expected 200 when revoking tenant API key {key_id}, got {revoke_response.status_code}"
+        )
+
+    @pytest.mark.tier1
+    def test_tc_apikey_002(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        tenant_a_subscription_name: str,
+        current_client_token: str,
+        two_aitenant_test_contexts: tuple[AITenantTestContext, AITenantTestContext],
+    ) -> None:
+        """TC-APIKEY-002: Verify internal API-key validation returns tenant identity fields."""
+        tenant_a_name = two_aitenant_test_contexts[0]["aitenant_name"]
+        with isolation_tenant_api_key_plaintext(
+            request_session_http=request_session_http,
+            base_url=tenant_a_base_url,
+            ocp_user_token=current_client_token,
+            subscription=tenant_a_subscription_name,
+            key_name_prefix="tc-apikey-002",
+            fixture_label="TC-APIKEY-002",
+        ) as plaintext_api_key:
+            validation_response = request_session_http.post(
+                url=f"{tenant_a_base_url}/internal/v1/api-keys/validate",
+                json={"apiKey": plaintext_api_key},
+                timeout=60,
+            )
+            assert validation_response.status_code == 200, (
+                f"Expected 200 from internal API-key validation, got {validation_response.status_code}: "
+                f"{validation_response.text[:200]}"
+            )
+            validation_body = validation_response.json()
+            assert validation_body.get("tenant") == tenant_a_name, (
+                f"ValidationResult tenant should be {tenant_a_name!r}, got {validation_body.get('tenant')!r}"
+            )
+            assert validation_body.get("userID"), f"ValidationResult userID is empty: {validation_body}"
+            assert validation_body.get("modelRef"), f"ValidationResult modelRef is empty: {validation_body}"
+
+    @pytest.mark.tier3
+    def test_tc_apikey_003(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        tenant_b_base_url: str,
+        tenant_a_subscription_name: str,
+        current_client_token: str,
+        two_aitenant_test_contexts: tuple[AITenantTestContext, AITenantTestContext],
+    ) -> None:
+        """TC-APIKEY-003: Verify a tenant A API key is rejected in tenant B context."""
+        tenant_b_name = two_aitenant_test_contexts[1]["aitenant_name"]
+        with isolation_tenant_api_key_plaintext(
+            request_session_http=request_session_http,
+            base_url=tenant_a_base_url,
+            ocp_user_token=current_client_token,
+            subscription=tenant_a_subscription_name,
+            key_name_prefix="tc-apikey-003",
+            fixture_label="TC-APIKEY-003",
+        ) as plaintext_api_key:
+            validation_response = request_session_http.post(
+                url=f"{tenant_b_base_url}/internal/v1/api-keys/validate",
+                headers={"X-MaaS-Tenant": tenant_b_name},
+                json={"apiKey": plaintext_api_key},
+                timeout=60,
+            )
+            assert validation_response.status_code == 401, (
+                f"Expected 401 for tenant A key in tenant B context, got {validation_response.status_code}: "
+                f"{validation_response.text[:200]}"
+            )
+
+    @pytest.mark.tier2
+    def test_tc_apikey_004(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        tenant_b_base_url: str,
+        tenant_a_subscription_name: str,
+        tenant_b_subscription_name: str,
+        current_client_token: str,
+    ) -> None:
+        """TC-APIKEY-004: Verify tenant A API-key listing excludes tenant B keys."""
+        with (
+            isolation_tenant_api_key_id(
+                request_session_http=request_session_http,
+                base_url=tenant_a_base_url,
+                ocp_user_token=current_client_token,
+                subscription=tenant_a_subscription_name,
+                key_name_prefix="tc-apikey-004-a",
+                fixture_label="TC-APIKEY-004-A",
+            ) as tenant_a_key_id,
+            isolation_tenant_api_key_id(
+                request_session_http=request_session_http,
+                base_url=tenant_b_base_url,
+                ocp_user_token=current_client_token,
+                subscription=tenant_b_subscription_name,
+                key_name_prefix="tc-apikey-004-b",
+                fixture_label="TC-APIKEY-004-B",
+            ) as tenant_b_key_id,
+        ):
+            list_response, list_body = list_api_keys(
+                request_session_http=request_session_http,
+                base_url=tenant_a_base_url,
+                ocp_user_token=current_client_token,
+                filters={"status": ["active"]},
+                sort={"by": "created_at", "order": "desc"},
+                pagination={"limit": 50, "offset": 0},
+            )
+            assert list_response.status_code == 200, (
+                f"Expected 200 from tenant A API-key listing, got {list_response.status_code}: "
+                f"{list_response.text[:200]}"
+            )
+            assert_api_key_search_includes_ids(list_body=list_body, expected_key_ids={tenant_a_key_id})
+            assert_api_key_search_excludes_ids(list_body=list_body, excluded_key_ids={tenant_b_key_id})
