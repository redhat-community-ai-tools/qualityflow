+from __future__ import annotations
+
+from contextlib import ExitStack
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.maas_model_ref import MaaSModelRef
+
+from tests.ai_gateway.models_as_a_service.maas_subscription.utils import create_maas_subscription
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import (
+    FINALIZER_SUBSCRIPTION,
+    SUBSCRIPTION_RECONCILED_PHASES,
+    assert_maas_resource_stays_unreconciled,
+    synthetic_discovery_tenant_namespace,
+    wait_for_maas_resource_finalizer,
+    wait_for_maas_resource_phase,
+)
+
+
+@pytest.mark.usefixtures(
+    "maas_subscription_controller_enabled_latest",
+    "tenant_namespace_discovery_prerequisites",
+    "maas_model_tinyllama_free",
+)
+class TestMaasMultiTenancyController:
+    """Verify namespace discovery and multi-tenant controller reconciliation."""
+
+    @staticmethod
+    def _model_reference(maas_model_tinyllama_free: MaaSModelRef) -> tuple[str, str]:
+        return maas_model_tinyllama_free.name, maas_model_tinyllama_free.namespace
+
+    @pytest.mark.tier1
+    def test_tc_ctrl_001(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-CTRL-001: Verify a labeled namespace is discovered and its subscription reconciled."""
+        model_name, model_namespace = self._model_reference(maas_model_tinyllama_free)
+        with (
+            synthetic_discovery_tenant_namespace(
+                admin_client=admin_client,
+                teardown=teardown_resources,
+            ) as discovery_case,
+            create_maas_subscription(
+                admin_client=admin_client,
+                subscription_namespace=discovery_case["tenant_namespace_name"],
+                subscription_name=discovery_case["subscription_name"],
+                owner_group_name="system:authenticated",
+                model_name=model_name,
+                model_namespace=model_namespace,
+                tokens_per_minute=100,
+                teardown=teardown_resources,
+                wait_for_resource=True,
+            ) as subscription,
+        ):
+            wait_for_maas_resource_finalizer(
+                resource=subscription,
+                expected_finalizer=FINALIZER_SUBSCRIPTION,
+            )
+            phase = wait_for_maas_resource_phase(
+                resource=subscription,
+                expected_phases=SUBSCRIPTION_RECONCILED_PHASES,
+            )
+            assert phase in SUBSCRIPTION_RECONCILED_PHASES
+
+    @pytest.mark.tier3
+    def test_tc_ctrl_002(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-CTRL-002: Verify an unlabeled namespace is not reconciled by maas-controller."""
+        model_name, model_namespace = self._model_reference(maas_model_tinyllama_free)
+        with (
+            synthetic_discovery_tenant_namespace(
+                admin_client=admin_client,
+                teardown=teardown_resources,
+                discovery_labels_applied=False,
+            ) as discovery_case,
+            create_maas_subscription(
+                admin_client=admin_client,
+                subscription_namespace=discovery_case["tenant_namespace_name"],
+                subscription_name=discovery_case["subscription_name"],
+                owner_group_name="system:authenticated",
+                model_name=model_name,
+                model_namespace=model_namespace,
+                tokens_per_minute=100,
+                teardown=teardown_resources,
+                wait_for_resource=True,
+            ) as subscription,
+        ):
+            assert_maas_resource_stays_unreconciled(
+                resource=subscription,
+                forbidden_finalizer=FINALIZER_SUBSCRIPTION,
+                timeout=60,
+            )
+
+    @pytest.mark.tier2
+    def test_tc_ctrl_003(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-CTRL-003: Verify subscriptions reconcile independently across three tenants."""
+        model_name, model_namespace = self._model_reference(maas_model_tinyllama_free)
+        with ExitStack() as stack:
+            subscriptions = []
+            for tenant_index in range(3):
+                discovery_case = stack.enter_context(
+                    synthetic_discovery_tenant_namespace(
+                        admin_client=admin_client,
+                        teardown=teardown_resources,
+                    )
+                )
+                subscriptions.append(
+                    stack.enter_context(
+                        create_maas_subscription(
+                            admin_client=admin_client,
+                            subscription_namespace=discovery_case["tenant_namespace_name"],
+                            subscription_name=discovery_case["subscription_name"],
+                            owner_group_name="system:authenticated",
+                            model_name=model_name,
+                            model_namespace=model_namespace,
+                            tokens_per_minute=100,
+                            teardown=teardown_resources,
+                            wait_for_resource=True,
+                        )
+                    )
+                )
+            for subscription in subscriptions:
+                wait_for_maas_resource_finalizer(
+                    resource=subscription,
+                    expected_finalizer=FINALIZER_SUBSCRIPTION,
+                )
+                phase = wait_for_maas_resource_phase(
+                    resource=subscription,
+                    expected_phases=SUBSCRIPTION_RECONCILED_PHASES,
+                )
+                assert phase in SUBSCRIPTION_RECONCILED_PHASES
