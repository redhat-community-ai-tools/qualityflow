+from __future__ import annotations
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from kubernetes.dynamic.exceptions import DynamicApiError
+from ocp_resources.maas_model_ref import MaaSModelRef
+
+from tests.ai_gateway.models_as_a_service.maas_subscription.utils import create_maas_subscription
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import (
+    synthetic_discovery_tenant_namespace,
+)
+from utilities.resources.maa_s_auth_policy import MaaSAuthPolicy
+
+
+@pytest.mark.usefixtures(
+    "maas_subscription_controller_enabled_latest",
+    "tenant_namespace_discovery_prerequisites",
+    "maas_model_tinyllama_free",
+)
+class TestMaasMultiTenancyWebhook:
+    """Verify admission enforcement by tenant namespace labels."""
+
+    @pytest.mark.tier3
+    def test_tc_webhook_001(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-WEBHOOK-001: Verify MaaSSubscription creation is rejected without a tenant label."""
+        with synthetic_discovery_tenant_namespace(
+            admin_client=admin_client,
+            teardown=teardown_resources,
+            discovery_labels_applied=False,
+        ) as discovery_case:
+            subscription = create_maas_subscription(
+                admin_client=admin_client,
+                subscription_namespace=discovery_case["tenant_namespace_name"],
+                subscription_name=discovery_case["subscription_name"],
+                owner_group_name="system:authenticated",
+                model_name=maas_model_tinyllama_free.name,
+                model_namespace=maas_model_tinyllama_free.namespace,
+                tokens_per_minute=100,
+                teardown=teardown_resources,
+                wait_for_resource=False,
+            )
+            with pytest.raises(DynamicApiError, match=r"(?i)maas\.opendatahub\.io/tenant|label"):
+                with subscription:
+                    pass
+            assert not subscription.exists, "Rejected MaaSSubscription must not exist"
+
+    @pytest.mark.tier3
+    def test_tc_webhook_002(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-WEBHOOK-002: Verify MaaSAuthPolicy creation is rejected without a tenant label."""
+        with synthetic_discovery_tenant_namespace(
+            admin_client=admin_client,
+            teardown=teardown_resources,
+            discovery_labels_applied=False,
+        ) as discovery_case:
+            auth_policy = MaaSAuthPolicy(
+                client=admin_client,
+                name=discovery_case["policy_name"],
+                namespace=discovery_case["tenant_namespace_name"],
+                model_refs=[
+                    {
+                        "name": maas_model_tinyllama_free.name,
+                        "namespace": maas_model_tinyllama_free.namespace,
+                    }
+                ],
+                subjects={"groups": [{"name": "system:authenticated"}]},
+                teardown=teardown_resources,
+                wait_for_resource=False,
+            )
+            with pytest.raises(DynamicApiError, match=r"(?i)maas\.opendatahub\.io/tenant|label"):
+                with auth_policy:
+                    pass
+            assert not auth_policy.exists, "Rejected MaaSAuthPolicy must not exist"
+
+    @pytest.mark.tier2
+    def test_tc_webhook_003(
+        self,
+        admin_client: DynamicClient,
+        teardown_resources: bool,
+        maas_model_tinyllama_free: MaaSModelRef,
+    ) -> None:
+        """TC-WEBHOOK-003: Verify MaaSSubscription creation is allowed with a tenant label."""
+        with (
+            synthetic_discovery_tenant_namespace(
+                admin_client=admin_client,
+                teardown=teardown_resources,
+            ) as discovery_case,
+            create_maas_subscription(
+                admin_client=admin_client,
+                subscription_namespace=discovery_case["tenant_namespace_name"],
+                subscription_name=discovery_case["subscription_name"],
+                owner_group_name="system:authenticated",
+                model_name=maas_model_tinyllama_free.name,
+                model_namespace=maas_model_tinyllama_free.namespace,
+                tokens_per_minute=100,
+                teardown=teardown_resources,
+                wait_for_resource=True,
+            ) as subscription,
+        ):
+            assert subscription.exists, "MaaSSubscription was not admitted in labeled tenant namespace"
