+from __future__ import annotations
+
+import pytest
+import requests
+
+from tests.ai_gateway.models_as_a_service.multitenancy.aitenant.utils import AITenantTestContext
+from tests.ai_gateway.models_as_a_service.multitenancy.utils import (
+    TENANT_ISOLATION_MODEL_NAME,
+    TenantIsolationGovernance,
+    isolation_tenant_api_key_plaintext,
+)
+
+
+@pytest.mark.usefixtures(
+    "maas_subscription_controller_enabled_latest",
+    "aitenant_infra_namespace",
+    "isolation_tenant_governance",
+    "per_tenant_maas_api_ready",
+)
+class TestMaasMultiTenancyContract:
+    """Verify the internal subscription-selection contract and tenant-context binding."""
+
+    @pytest.mark.tier2
+    def test_tc_contract_001(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        current_client_token: str,
+        tenant_a_subscription_name: str,
+        isolation_tenant_governance: list[TenantIsolationGovernance],
+    ) -> None:
+        """TC-CONTRACT-001: Verify subscription selection returns the caller's tenant subscription."""
+        response = request_session_http.post(
+            url=f"{tenant_a_base_url}/internal/v1/subscriptions/select",
+            headers={"Authorization": f"Bearer {current_client_token}"},
+            json={"model": TENANT_ISOLATION_MODEL_NAME},
+            timeout=60,
+        )
+        assert response.status_code == 200, (
+            f"Expected 200 from subscription selection, got {response.status_code}: {response.text[:200]}"
+        )
+        body = response.json()
+        assert body.get("name") == tenant_a_subscription_name, (
+            f"Expected tenant A subscription {tenant_a_subscription_name!r}, got {body.get('name')!r}"
+        )
+        tenant_names = {
+            governance["aitenant_name"]
+            for governance in isolation_tenant_governance
+            if governance["subscription_name"] == body.get("name")
+        }
+        assert tenant_names == {isolation_tenant_governance[0]["aitenant_name"]}, (
+            f"Selected subscription must belong only to tenant A, matched tenants={tenant_names}"
+        )
+
+    @pytest.mark.tier3
+    def test_tc_contract_002(
+        self,
+        request_session_http: requests.Session,
+        tenant_a_base_url: str,
+        tenant_a_subscription_name: str,
+        current_client_token: str,
+        two_aitenant_test_contexts: tuple[AITenantTestContext, AITenantTestContext],
+    ) -> None:
+        """TC-CONTRACT-002: Verify a tenant context mismatch is rejected without subscription data."""
+        tenant_b_name = two_aitenant_test_contexts[1]["aitenant_name"]
+        with isolation_tenant_api_key_plaintext(
+            request_session_http=request_session_http,
+            base_url=tenant_a_base_url,
+            ocp_user_token=current_client_token,
+            subscription=tenant_a_subscription_name,
+            key_name_prefix="tc-contract-002",
+            fixture_label="TC-CONTRACT-002",
+        ) as plaintext_api_key:
+            response = request_session_http.post(
+                url=f"{tenant_a_base_url}/internal/v1/subscriptions/select",
+                headers={
+                    "Authorization": f"Bearer {plaintext_api_key}",
+                    "X-MaaS-Tenant": tenant_b_name,
+                },
+                json={"model": TENANT_ISOLATION_MODEL_NAME},
+                timeout=60,
+            )
+            assert response.status_code == 403, (
+                f"Expected 403 for tenant context mismatch, got {response.status_code}: {response.text[:200]}"
+            )
+            assert "subscription" not in response.json(), (
+                f"Rejected response must not contain subscription data: {response.text[:200]}"
+            )
