+    "isolation_tenant_governance",
+    "per_tenant_maas_api_ready",
+)
+class TestMaasMultiTenancyPolicy:
+    """Verify MaaSAuthPolicy propagation to the tenant Gateway AuthPolicy."""
+
+    @staticmethod
+    def _gateway_reference(
+        test_context: AITenantTestContext,
+    ) -> tuple[str, str]:
+        return gateway_ref_from_aitenant(aitenant=test_context["aitenant"])
+
+    @pytest.mark.tier2
+    def test_tc_policy_001(
+        self,
+        admin_client: DynamicClient,
+        maas_api_infra_namespace: str,
+        isolation_primary_aitenant_for_test: AITenantTestContext,
+    ) -> None:
+        """TC-POLICY-001: Verify a tenant MaaSAuthPolicy generates a Gateway AuthPolicy."""
+        gateway_name, gateway_namespace = self._gateway_reference(isolation_primary_aitenant_for_test)
+        callback_url = verify_tenant_gateway_auth_policy_callback_url(
+            admin_client=admin_client,
+            gateway_name=gateway_name,
+            gateway_namespace=gateway_namespace,
+            aitenant_name=isolation_primary_aitenant_for_test["aitenant_name"],
+            api_namespace=maas_api_infra_namespace,
+            tenant_namespace_name=isolation_primary_aitenant_for_test["tenant_namespace_name"],
+        )
+        assert callback_url, "Gateway AuthPolicy callback URL must not be empty"
+
+    @pytest.mark.tier2
+    def test_tc_policy_002(
+        self,
+        admin_client: DynamicClient,
+        isolation_primary_aitenant_for_test: AITenantTestContext,
+        isolation_tenant_governance: list[TenantIsolationGovernance],
+    ) -> None:
+        """TC-POLICY-002: Verify updating a tenant MaaSAuthPolicy updates its Gateway AuthPolicy."""
+        test_context = isolation_primary_aitenant_for_test
+        governance = isolation_tenant_governance[0]
+        gateway_name, gateway_namespace = self._gateway_reference(test_context)
+        auth_policy_before = wait_for_tenant_gateway_maas_auth_policy(
+            admin_client=admin_client,
+            gateway_name=gateway_name,
+            gateway_namespace=gateway_namespace,
+        )
+        version_before = auth_policy_before.instance.metadata.resourceVersion
+
+        maas_auth_policy = MaaSAuthPolicy(
+            client=admin_client,
+            name=governance["auth_policy_name"],
+            namespace=governance["tenant_namespace_name"],
+        )
+        updated_subjects = {
+            "groups": [
+                {"name": "system:authenticated"},
+                {"name": "maas-policy-update"},
+            ]
+        }
+        with ResourceEditor(patches={maas_auth_policy: {"spec": {"subjects": updated_subjects}}}):
+            auth_policy_after = wait_for_tenant_gateway_maas_auth_policy(
+                admin_client=admin_client,
+                gateway_name=gateway_name,
+                gateway_namespace=gateway_namespace,
+            )
+            version_after = auth_policy_after.instance.metadata.resourceVersion
+            assert version_after != version_before, (
+                f"Gateway AuthPolicy resourceVersion did not change after MaaSAuthPolicy update: "
+                f"{version_before!r}"
+            )
+
+    @pytest.mark.tier3
+    def test_tc_policy_003(
+        self,
+        admin_client: DynamicClient,
+        isolation_primary_aitenant_for_test: AITenantTestContext,
+        isolation_tenant_governance: list[TenantIsolationGovernance],
+    ) -> None:
+        """TC-POLICY-003: Verify deleting a tenant MaaSAuthPolicy removes its Gateway AuthPolicy."""
+        test_context = isolation_primary_aitenant_for_test
+        governance = isolation_tenant_governance[0]
+        gateway_name, gateway_namespace = self._gateway_reference(test_context)
+        auth_policy = wait_for_tenant_gateway_maas_auth_policy(
+            admin_client=admin_client,
+            gateway_name=gateway_name,
+            gateway_namespace=gateway_namespace,
+        )
+        maas_auth_policy = MaaSAuthPolicy(
+            client=admin_client,
+            name=governance["auth_policy_name"],
+            namespace=governance["tenant_namespace_name"],
+        )
+        maas_auth_policy.delete()
+        try:
+            for auth_policy_exists in TimeoutSampler(
+                wait_timeout=120,
+                sleep=5,
+                func=auth_policy.get,
+                exceptions_dict={NotFoundError: [], ResourceNotFoundError: []},
+            ):
+                if not auth_policy.exists:
+                    break
+        except TimeoutExpiredError as error:
+            raise AssertionError(
+                f"Gateway AuthPolicy '{gateway_namespace}/{auth_policy.name}' was not removed after "
+                "MaaSAuthPolicy deletion"
+            ) from error
