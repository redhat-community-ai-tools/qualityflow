+@pytest.fixture(scope="class")
+def anthropic_model_id(anthropic_ogx_client: OgxClient) -> str:
+    """Resolve a live Claude model served by remote::anthropic."""
+    models = anthropic_ogx_client.models.list()
+    for model in models.data:
+        if model.provider_id == ANTHROPIC_PROVIDER_ID and model.model_type == "llm":
+            LOGGER.info(f"Resolved Anthropic LLM model: {model.id}")
+            return model.id
+
+    pytest.fail(
