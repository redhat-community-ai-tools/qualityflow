+@pytest.fixture(scope="class")
+def anthropic_ogx_test_route(
+    unprivileged_client: DynamicClient,
+    unprivileged_model_namespace: Namespace,
+    anthropic_ogx_server_deployment: Deployment,
+    teardown_resources: bool,
+) -> Generator[Route, Any, Any]:
+    """Expose the Anthropic-enabled OGX server through an OpenShift route."""
+    route_name = generate_random_name(prefix="qf-anthropic", length=12)
+    with Route(
+        client=unprivileged_client,
+        namespace=unprivileged_model_namespace.name,
+        name=route_name,
+        service=f"{anthropic_ogx_server_deployment.name}-service",
+        wait_for_resource=True,
+        teardown=teardown_resources,
+    ) as route:
+        ResourceEditor(
+            patches={
+                route: {
+                    "spec": {
