+@pytest.fixture(scope="class")
+def anthropic_secret(
+    unprivileged_client: DynamicClient,
+    unprivileged_model_namespace: Namespace,
+    teardown_resources: bool,
+) -> Generator[Secret, Any, Any]:
+    """Create the Secret that supplies the live Anthropic API key."""
+    if not ANTHROPIC_API_KEY:
+        pytest.fail(reason="No Anthropic API key configured; set OGX_CORE_ANTHROPIC_API_KEY to run these tests")
+
+    secret = Secret(
+        client=unprivileged_client,
+        namespace=unprivileged_model_namespace.name,
+        name=generate_random_name(prefix="qf-anthropic-secret"),
+        type="Opaque",
+        string_data={"anthropic-api-token": ANTHROPIC_API_KEY},
+        teardown=teardown_resources,
+    )
+    with secret:
+        yield secret
+
+
+@pytest.fixture(scope="class")
+def anthropic_ogx_server(
+    distribution_name: str,
+    unprivileged_client: DynamicClient,
+    unprivileged_model_namespace: Namespace,
+    enabled_ogx_operator: Any,
+    vector_io_provider_deployment_config_factory: Callable[[str], list[dict[str, str]]],
+    files_provider_config_factory: Callable[[str], list[dict[str, str]]],
+    is_disconnected_cluster: bool,
+    teardown_resources: bool,
+    ogx_server_secret: Secret,
+    anthropic_secret: Secret,
+    postgres_deployment: Deployment,
+    postgres_service: Any,
+) -> Generator[OgxServer, Any, Any]:
+    """Create an OGX server with the native Anthropic provider enabled."""
+    config = build_ogx_server_config(
+        vector_io_provider_deployment_config_factory=vector_io_provider_deployment_config_factory,
+        files_provider_config_factory=files_provider_config_factory,
+        is_disconnected_cluster=is_disconnected_cluster,
+        params={
+            "network": {
+                "policy": {
+                    "ingress": [
+                        {
+                            "ports": [{"port": 8321, "protocol": "TCP"}],
+                            "from": [
+                                {
+                                    "namespaceSelector": {
+                                        "matchLabels": {"network.openshift.io/policy-group": "ingress"}
+                                    }
+                                },
+                                {
+                                    "namespaceSelector": {
+                                        "matchLabels": {"network.openshift.io/policy-group": "host-network"}
+                                    }
+                                },
+                            ],
+                        }
+                    ]
+                }
+            }
+        },
+    )
+    config["workload"]["overrides"]["env"].append(
+        {
+            "name": "ANTHROPIC_API_KEY",
+            "valueFrom": {
+                "secretKeyRef": {"name": anthropic_secret.name, "key": "anthropic-api-token"}
+            },
+        }
+    )
+
+    with create_ogx_server(
+        client=unprivileged_client,
+        name=distribution_name,
+        namespace=unprivileged_model_namespace.name,
+        config=config,
+        teardown=teardown_resources,
+    ) as ogx_server:
+        ogx_server.wait_for_status(status=OgxServer.Status.READY, timeout=600)
+        yield ogx_server
+
