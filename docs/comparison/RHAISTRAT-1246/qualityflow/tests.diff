+                            "termination": "edge",
+                            "insecureEdgeTerminationPolicy": "Redirect",
+                        },
+                        "port": {"targetPort": "http"},
+                    },
+                    "metadata": {
+                        "annotations": {"haproxy.router.openshift.io/timeout": "10m"},
+                    },
+                }
+            }
+        ).update()
+        route.wait(timeout=60)
+        yield route
+
