+@pytest.mark.parametrize(
+    "unprivileged_model_namespace",
+    [
+        pytest.param(
+            {"name": "test-qf-anthropic", "randomize_name": True},
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.ogx
+@pytest.mark.skip_on_disconnected
+class TestQfAnthropicProvider:
+    """Live tests for the native remote::anthropic provider."""
+
+    @pytest.mark.tier1
+    def test_native_chat_returns_ack(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 1: native chat returns ACK without custom auth headers.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        response = anthropic_ogx_client.chat.completions.create(
+            model=anthropic_model_id,
+            messages=[{"role": "user", "content": "Just respond ACK."}],
+        )
+        assert response.choices, "Anthropic chat completion returned no choices"
+        content = response.choices[0].message.content
+        assert content, "Anthropic chat completion returned empty content"
+        assert "ACK" in content, "Anthropic chat completion did not return ACK"
+
+    @pytest.mark.tier1
+    def test_streaming_chat_delivers_ack(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 3: streaming chat delivers content and terminates.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        stream = anthropic_ogx_client.chat.completions.create(
+            model=anthropic_model_id,
+            messages=[{"role": "user", "content": "Just respond ACK."}],
+            stream=True,
+        )
+        content = ""
+        finish_reasons = []
+        for chunk in stream:
+            if not chunk.choices:
+                continue
+            choice = chunk.choices[0]
+            if choice.delta and choice.delta.content:
+                content += choice.delta.content
+            if choice.finish_reason:
+                finish_reasons.append(choice.finish_reason)
+
+        assert content, "Anthropic streaming chat returned no content"
+        assert "ACK" in content, "Anthropic streaming chat did not return ACK"
+        assert "stop" in finish_reasons, f"Anthropic stream did not stop cleanly: {finish_reasons!r}"
+
+    @pytest.mark.tier1
+    def test_supported_temperatures_return_answers(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 4: supported temperature endpoints return complete answers.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        for temperature in (0.0, 1.0):
+            response = anthropic_ogx_client.chat.completions.create(
+                model=anthropic_model_id,
+                messages=[{"role": "user", "content": "Just respond ACK."}],
+                temperature=temperature,
+            )
+            assert response.choices, f"No choices at temperature {temperature}"
+            content = response.choices[0].message.content
+            assert content, f"Empty content at temperature {temperature}"
+            assert "ACK" in content, f"ACK was not returned at temperature {temperature}"
+
+    @pytest.mark.tier1
+    def test_anthropic_model_discovery(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 16: Anthropic-format model discovery returns model IDs.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        models = anthropic_ogx_client.models.list(anthropic_version=ANTHROPIC_VERSION)
+        assert models.data, "Anthropic-format model discovery returned no models"
+        model_ids = [model.id for model in models.data]
+        assert all(model_ids), "Anthropic-format model discovery returned an empty model id"
+        assert anthropic_model_id in model_ids, (
+            f"Expected resolved Anthropic model {anthropic_model_id!r} in discovered models {model_ids!r}"
+        )
+
+    @pytest.mark.tier1
+    def test_responses_create_returns_paris(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 18: responses API returns the requested answer.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        response = anthropic_ogx_client.responses.create(
+            model=anthropic_model_id,
+            input="What is the capital of France?",
+            instructions="You are a helpful assistant.",
+            temperature=0.0,
+            max_output_tokens=4096,
+        )
+        assert response.output_text, "Anthropic responses API returned empty output text"
+        assert "paris" in response.output_text.lower(), (
+            "Anthropic responses API did not include Paris in the answer"
+        )
+
+    @pytest.mark.tier1
+    def test_streaming_responses_deliver_paris(
+        self,
+        anthropic_ogx_client: OgxClient,
+        anthropic_model_id: str,
+    ) -> None:
+        """Scenario 19: streaming responses deliver content and completion.
+
+        STP: outputs/RHAISTRAT-1246/stp/RHAISTRAT-1246_test_plan.md
+        """
+        stream = anthropic_ogx_client.responses.create(
+            model=anthropic_model_id,
+            input="What is the capital of France?",
+            instructions="You are a helpful assistant.",
+            temperature=0.0,
+            max_output_tokens=4096,
+            stream=True,
+        )
+        events = []
+        delta_content = ""
+        for event in stream:
+            events.append(event)
+            if event.type == "response.output_text.delta":
+                delta_content += event.delta
+            elif event.type == "response.completed":
+                delta_content = event.response.output_text
+
+        event_types = [event.type for event in events]
+        assert "response.created" in event_types, "Responses stream did not emit response.created"
+        assert "response.completed" in event_types, "Responses stream did not emit response.completed"
+        assert delta_content, "Responses stream returned no output text"
+        assert "paris" in delta_content.lower(), "Responses stream did not include Paris"
