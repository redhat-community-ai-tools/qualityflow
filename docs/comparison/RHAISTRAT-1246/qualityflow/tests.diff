+@pytest.fixture(scope="class")
+def anthropic_ogx_server_deployment(
+    unprivileged_client: DynamicClient,
+    anthropic_ogx_server: OgxServer,
+) -> Generator[Deployment, Any, Any]:
+    """Return the deployment for the Anthropic-enabled OGX server."""
+    deployment = Deployment(
+        client=unprivileged_client,
+        namespace=anthropic_ogx_server.namespace,
+        name=anthropic_ogx_server.name,
+        min_ready_seconds=10,
+    )
+    deployment.timeout_seconds = 240
+    deployment.wait(timeout=240)
+    deployment.wait_for_replicas()
+    yield deployment
+
