+@pytest.fixture(scope="class")
+def anthropic_ogx_client(
+    anthropic_ogx_test_route: Route,
+) -> Generator[OgxClient, Any, Any]:
+    """Return a client connected to the Anthropic-enabled OGX route."""
+    http_client = httpx.Client(verify=OGX_CLIENT_VERIFY_SSL, timeout=300)
+    try:
+        client = OgxClient(
+            base_url=f"https://{anthropic_ogx_test_route.host}",
+            max_retries=3,
+            http_client=http_client,
+            timeout=300,
+        )
+        wait_for_ogx_client_ready(client=client)
+        yield client
+    finally:
+        http_client.close()
+
