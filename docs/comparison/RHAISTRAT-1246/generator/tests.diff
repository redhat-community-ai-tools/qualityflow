@@ -0,0 +1,129 @@
+"""Non-functional requirements for the remote::anthropic provider."""
+
+import json
+
+import pytest
+import structlog
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.namespace import Namespace
+from ocp_resources.pod import Pod
+from ogx_client import APIStatusError, OgxClient
+
+from tests.ogx.conftest import ogx_client, ogx_server
+from tests.ogx.constants import (
+    ANTHROPIC_API_KEY,
+    ANTHROPIC_PROVIDER_DATA_HEADER,
+    ANTHROPIC_PROVIDER_ID,
+    ANTHROPIC_PROVIDER_TYPE,
+    OGX_CORE_POD_FILTER,
+)
+from utilities.general import wait_for_pods_by_labels
+
+LOGGER = structlog.get_logger(name=__name__)
+
+pytestmark = [pytest.mark.ogx, pytest.mark.skip_on_disconnected]
+
+
+@pytest.fixture(scope="class")
+def anthropic_ogx_pod(
+    admin_client: DynamicClient,
+    unprivileged_model_namespace: Namespace,
+    ogx_server: object,
+) -> Pod:
+    """Return the single OGX pod used by the Anthropic provider tests."""
+    return wait_for_pods_by_labels(
+        admin_client=admin_client,
+        namespace=unprivileged_model_namespace.name,
+        label_selector=OGX_CORE_POD_FILTER,
+        expected_num_pods=1,
+    )[0]
+
+
+def _anthropic_model_id(ogx_client: OgxClient) -> str:
+    """Return an Anthropic LLM model id."""
+    for model in ogx_client.models.list().data:
+        if model.provider_id == ANTHROPIC_PROVIDER_ID and model.model_type == "llm":
+            return model.id
+    pytest.fail(reason=f"{ANTHROPIC_PROVIDER_TYPE} is active but registered no LLM model")
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-security", "randomize_name": True},
+            {"enable_anthropic": True},
+            id="anthropic",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicSecurity:
+    """Security properties for Anthropic credentials and egress."""
+
+    @pytest.mark.tier2
+    def test_tc_nfr_001(
+        self,
+        ogx_client: OgxClient,
+        anthropic_ogx_pod: Pod,
+    ) -> None:
+        """TC-NFR-001: Verify Anthropic keys are not exposed in observable output."""
+        if not ANTHROPIC_API_KEY:
+            pytest.fail(
+                reason="Anthropic API key value is not available to the test; "
+                "cannot verify absence in logs and responses"
+            )
+
+        containers = anthropic_ogx_pod.instance.spec.containers
+        anthropic_env_entries = [
+            env for container in containers for env in (container.env or []) if env.name == "ANTHROPIC_API_KEY"
+        ]
+        assert anthropic_env_entries, "ANTHROPIC_API_KEY env var not found in the OGX pod spec"
+        for env in anthropic_env_entries:
+            assert env.value in (None, ""), "ANTHROPIC_API_KEY is stored as plaintext in the pod spec"
+            assert env.valueFrom and env.valueFrom.secretKeyRef, (
+                "ANTHROPIC_API_KEY is not sourced from a Secret via secretKeyRef"
+            )
+
+        model_id = _anthropic_model_id(ogx_client=ogx_client)
+        chat = ogx_client.chat.completions.create(
+            model=model_id,
+            messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+        )
+        assert chat.choices and chat.choices[0].message.content, "Anthropic chat completion did not succeed"
+
+        invalid_override = "invalid-anthropic-key-for-leak-check"
+        with pytest.raises(APIStatusError) as exc_info:
+            ogx_client.chat.completions.create(
+                model=model_id,
+                messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+                extra_headers={
+                    ANTHROPIC_PROVIDER_DATA_HEADER: json.dumps({"anthropic_api_key": invalid_override})
+                },
+            )
+        error_text = str(exc_info.value.body or exc_info.value)
+        assert invalid_override not in error_text, "Invalid per-request Anthropic key leaked in an error response"
+
+        for container in containers:
+            logs = anthropic_ogx_pod.log(container=container.name)
+            assert ANTHROPIC_API_KEY not in logs, (
+                f"Anthropic API key leaked into logs of container {container.name!r}"
+            )
+            assert invalid_override not in logs, (
+                f"Invalid per-request key leaked into logs of container {container.name!r}"
+            )
+
+        providers_dump = str(list(ogx_client.providers.list()))
+        assert ANTHROPIC_API_KEY not in providers_dump, "Anthropic API key leaked into /v1/providers"
+        assert invalid_override not in providers_dump, "Invalid per-request key leaked into /v1/providers"
+
+    @pytest.mark.tier3
+    def test_tc_nfr_002(self, ogx_client: OgxClient) -> None:
+        """TC-NFR-002: Verify Anthropic egress negotiates TLS 1.2 or newer."""
+        provider_types = [provider.provider_type for provider in ogx_client.providers.list()]
+        assert ANTHROPIC_PROVIDER_TYPE in provider_types, "remote::anthropic provider is not active"
+        pytest.fail(
+            reason="TC-NFR-002 requires pod-level TLS handshake capture or proxy inspection; "
+            "wire network inspection tooling before enabling this test"
+        )
