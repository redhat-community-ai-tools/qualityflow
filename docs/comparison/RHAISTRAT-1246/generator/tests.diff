+"""Upgrade and migration tests for the remote::anthropic provider."""
+
+import pytest
+import structlog
+from ogx_client import OgxClient
+
+from tests.ogx.conftest import ogx_client, ogx_server
+from tests.ogx.constants import ANTHROPIC_PROVIDER_TYPE
+
+LOGGER = structlog.get_logger(name=__name__)
+
+pytestmark = [pytest.mark.ogx, pytest.mark.skip_on_disconnected]
+
+
+def _assert_anthropic_provider(ogx_client: OgxClient) -> None:
+    """Fail if remote::anthropic is not active."""
+    provider_types = [provider.provider_type for provider in ogx_client.providers.list()]
+    assert ANTHROPIC_PROVIDER_TYPE in provider_types, (
+        f"remote::anthropic is not active after upgrade; providers={provider_types!r}"
+    )
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-upgrade", "randomize_name": True},
+            {"enable_anthropic": True},
+            id="anthropic-upgrade",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicUpgrade:
+    """Upgrade compatibility for Anthropic provider configurations."""
+
+    @pytest.mark.parametrize(
+        "upgrade_phase",
+        [
+            pytest.param("pre", marks=pytest.mark.pre_upgrade, id="pre"),
+            pytest.param("post", marks=pytest.mark.post_upgrade, id="post"),
+        ],
+    )
+    def test_tc_upg_001(self, ogx_client: OgxClient, upgrade_phase: str) -> None:
+        """TC-UPG-001: Verify the remote::openai workaround survives upgrade."""
+        _assert_anthropic_provider(ogx_client=ogx_client)
+        pytest.fail(
+            reason=f"TC-UPG-001 {upgrade_phase}-upgrade phase requires a persisted "
+            "remote::openai workaround configuration with network.headers; "
+            "add that deployment harness before enabling this test"
+        )
+
+    @pytest.mark.parametrize(
+        "upgrade_phase",
+        [
+            pytest.param("pre", marks=pytest.mark.pre_upgrade, id="pre"),
+            pytest.param("post", marks=pytest.mark.post_upgrade, id="post"),
+        ],
+    )
+    def test_tc_upg_002(self, ogx_client: OgxClient, upgrade_phase: str) -> None:
+        """TC-UPG-002: Verify migration from the workaround to native Anthropic."""
+        _assert_anthropic_provider(ogx_client=ogx_client)
+        pytest.fail(
+            reason=f"TC-UPG-002 {upgrade_phase}-upgrade phase requires a persisted "
+            "remote::openai configuration and an in-test migration to remote::anthropic; "
+            "add configuration update and pod restart support before enabling this test"
+        )
