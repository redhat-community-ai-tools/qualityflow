@@ -0,0 +1,313 @@
+"""End-to-end tests for the remote::anthropic provider."""
+
+import json
+from typing import Any
+
+import pytest
+import structlog
+from ogx_client import APIStatusError, OgxClient
+
+from tests.ogx.conftest import ogx_client, ogx_server
+from tests.ogx.constants import (
+    ANTHROPIC_API_KEY_SECONDARY,
+    ANTHROPIC_INFERENCE_MODEL,
+    ANTHROPIC_PROVIDER_DATA_HEADER,
+    ANTHROPIC_PROVIDER_ID,
+    ANTHROPIC_PROVIDER_TYPE,
+)
+
+LOGGER = structlog.get_logger(name=__name__)
+
+pytestmark = [pytest.mark.ogx, pytest.mark.skip_on_disconnected]
+
+WEATHER_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "get_weather",
+        "description": "Get the current weather for a location",
+        "parameters": {
+            "type": "object",
+            "properties": {"location": {"type": "string"}},
+            "required": ["location"],
+        },
+    },
+}
+
+
+def _anthropic_provider(ogx_client: OgxClient) -> Any:
+    """Return the remote::anthropic provider, failing if it is not active."""
+    for provider in ogx_client.providers.list():
+        if provider.provider_type == ANTHROPIC_PROVIDER_TYPE:
+            return provider
+    pytest.fail(reason=f"{ANTHROPIC_PROVIDER_TYPE} provider is not active")
+
+
+def _anthropic_model_id(ogx_client: OgxClient) -> str:
+    """Return an Anthropic LLM model id, failing if the provider registered none."""
+    if ANTHROPIC_INFERENCE_MODEL:
+        return ANTHROPIC_INFERENCE_MODEL
+
+    for model in ogx_client.models.list().data:
+        if model.provider_id == ANTHROPIC_PROVIDER_ID and model.model_type == "llm":
+            return model.id
+
+    pytest.fail(
+        reason=f"{ANTHROPIC_PROVIDER_TYPE} is active but registered no LLM model; "
+        "expected at least one Anthropic LLM model to be served by the distribution"
+    )
+
+
+def _provider_data_headers(anthropic_api_key: str) -> dict[str, str]:
+    """Build the per-request Anthropic API key override header."""
+    return {ANTHROPIC_PROVIDER_DATA_HEADER: json.dumps({"anthropic_api_key": anthropic_api_key})}
+
+
+def _assert_chat_completion(
+    ogx_client: OgxClient,
+    model_id: str,
+    extra_headers: dict[str, str] | None = None,
+) -> None:
+    """Assert a deterministic Anthropic chat completion returns non-empty content."""
+    response = ogx_client.chat.completions.create(
+        model=model_id,
+        messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+        temperature=0,
+        extra_headers=extra_headers,
+    )
+    assert response.choices, "Anthropic chat completion returned no choices"
+    assert response.choices[0].message.content, "Anthropic chat completion returned no content"
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-e2e", "randomize_name": True},
+            {"enable_anthropic": True},
+            id="anthropic",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicEndToEnd:
+    """Positive end-to-end behavior for remote::anthropic."""
+
+    @pytest.mark.tier1
+    def test_tc_e2e_001(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-001: Verify Anthropic chat completions work with native auth."""
+        _anthropic_provider(ogx_client=ogx_client)
+        _assert_chat_completion(
+            ogx_client=ogx_client,
+            model_id=_anthropic_model_id(ogx_client=ogx_client),
+        )
+
+    @pytest.mark.tier1
+    def test_tc_e2e_002(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-002: Verify streaming responses terminate with a finish reason."""
+        model_id = _anthropic_model_id(ogx_client=ogx_client)
+        stream = ogx_client.chat.completions.create(
+            model=model_id,
+            messages=[{"role": "user", "content": "Say hello in one short sentence."}],
+            temperature=0,
+            stream=True,
+        )
+
+        finish_reasons = []
+        for chunk_number, chunk in enumerate(stream, start=1):
+            if chunk_number == 10_000:
+                pytest.fail(reason="Anthropic streaming response exceeded 10,000 chunks")
+            if chunk.choices and chunk.choices[0].finish_reason is not None:
+                finish_reasons.append(chunk.choices[0].finish_reason)
+
+        assert finish_reasons, "Anthropic streaming response ended without a finish_reason"
+
+    @pytest.mark.tier2
+    def test_tc_e2e_003(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-003: Verify a per-request API key override is accepted."""
+        if not ANTHROPIC_API_KEY_SECONDARY:
+            pytest.skip(
+                reason="OGX_CORE_ANTHROPIC_API_KEY_SECONDARY must be set "
+                "to exercise the per-request key override scenario"
+            )
+
+        model_id = _anthropic_model_id(ogx_client=ogx_client)
+        _assert_chat_completion(ogx_client=ogx_client, model_id=model_id)
+        _assert_chat_completion(
+            ogx_client=ogx_client,
+            model_id=model_id,
+            extra_headers=_provider_data_headers(anthropic_api_key=ANTHROPIC_API_KEY_SECONDARY),
+        )
+        # The second call intentionally uses the secondary key. Without request
+        # capture, success proves override acceptance but cannot prove Key B was
+        # selected instead of Key A.
+
+    @pytest.mark.tier2
+    def test_tc_e2e_004(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-004: Verify Anthropic models are listed with provider metadata."""
+        models = [
+            model
+            for model in ogx_client.models.list().data
+            if model.provider_id == ANTHROPIC_PROVIDER_ID and model.model_type == "llm"
+        ]
+        assert models, "No Anthropic LLM models were returned by /v1/models"
+        assert all(model.id and model.object == "model" for model in models), (
+            "An Anthropic model entry is missing a model id or object discriminator"
+        )
+
+    @pytest.mark.tier1
+    def test_tc_e2e_005(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-005: Verify remote::anthropic appears in the provider list."""
+        provider = _anthropic_provider(ogx_client=ogx_client)
+        assert provider.provider_id == ANTHROPIC_PROVIDER_ID, (
+            f"Expected Anthropic provider_id {ANTHROPIC_PROVIDER_ID!r}, got {provider.provider_id!r}"
+        )
+        assert provider.health, "Anthropic provider returned no health metadata"
+
+    @pytest.mark.tier1
+    def test_tc_e2e_006(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-006: Verify chat completions tool calling and follow-up."""
+        model_id = _anthropic_model_id(ogx_client=ogx_client)
+        first = ogx_client.chat.completions.create(
+            model=model_id,
+            messages=[{"role": "user", "content": "What is the weather in Paris?"}],
+            tools=[WEATHER_TOOL],
+            tool_choice={"type": "function", "function": {"name": "get_weather"}},
+        )
+        assert first.choices, "Anthropic tool-calling response returned no choices"
+        tool_calls = first.choices[0].message.tool_calls
+        assert tool_calls, "Anthropic tool-calling response returned no tool_calls"
+
+        tool_call = tool_calls[0]
+        assert tool_call.function.name == "get_weather", (
+            f"Expected tool 'get_weather', got {tool_call.function.name!r}"
+        )
+        arguments = json.loads(tool_call.function.arguments)
+        assert arguments.get("location"), "Anthropic tool call omitted the location argument"
+
+        follow_up = ogx_client.chat.completions.create(
+            model=model_id,
+            messages=[
+                {"role": "user", "content": "What is the weather in Paris?"},
+                {
+                    "role": "assistant",
+                    "content": first.choices[0].message.content or "",
+                    "tool_calls": [
+                        {
+                            "id": tool_call.id,
+                            "type": "function",
+                            "function": {
+                                "name": tool_call.function.name,
+                                "arguments": tool_call.function.arguments,
+                            },
+                        }
+                    ],
+                },
+                {
+                    "role": "tool",
+                    "tool_call_id": tool_call.id,
+                    "content": json.dumps({"location": "Paris", "temperature_c": 18, "conditions": "sunny"}),
+                },
+            ],
+        )
+        assert follow_up.choices and follow_up.choices[0].message.content, (
+            "Anthropic follow-up response did not incorporate the tool result"
+        )
+
+    @pytest.mark.tier1
+    def test_tc_e2e_007(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-007: Verify Responses API tool calling and follow-up."""
+        model_id = _anthropic_model_id(ogx_client=ogx_client)
+        first = ogx_client.responses.create(
+            model=model_id,
+            input="What is the weather in Paris?",
+            tools=[WEATHER_TOOL],
+        )
+        function_calls = [output for output in first.output if output.type == "function_call"]
+        assert function_calls, "Anthropic Responses API returned no function_call output"
+        function_call = function_calls[0]
+        assert function_call.name == "get_weather", (
+            f"Expected Responses API tool 'get_weather', got {function_call.name!r}"
+        )
+        assert json.loads(function_call.arguments).get("location"), (
+            "Responses API tool call omitted the location argument"
+        )
+
+        follow_up = ogx_client.responses.create(
+            model=model_id,
+            input=[
+                {
+                    "type": "message",
+                    "role": "user",
+                    "content": [{"type": "input_text", "text": "What is the weather in Paris?"}],
+                },
+                {
+                    "type": "function_call",
+                    "call_id": function_call.call_id,
+                    "name": function_call.name,
+                    "arguments": function_call.arguments,
+                },
+                {
+                    "type": "function_call_output",
+                    "call_id": function_call.call_id,
+                    "output": json.dumps({"location": "Paris", "temperature_c": 18, "conditions": "sunny"}),
+                },
+            ],
+        )
+        assert follow_up.output_text, "Anthropic Responses API follow-up returned no final text"
+
+    @pytest.mark.tier2
+    def test_tc_e2e_008(self, ogx_client: OgxClient) -> None:
+        """TC-E2E-008: Verify MCP tool use with Anthropic models."""
+        _anthropic_provider(ogx_client=ogx_client)
+        pytest.fail(
+            reason="TC-E2E-008 requires a configured MCP server and invocation evidence; "
+            "wire an MCP harness before enabling this test"
+        )
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server, expected_provider",
+    [
+        pytest.param(
+            {"name": "test-anthropic-enabled", "randomize_name": True},
+            {"enable_anthropic": True},
+            True,
+            id="enabled",
+        ),
+        pytest.param(
+            {"name": "test-anthropic-disabled", "randomize_name": True},
+            {"enable_anthropic": False},
+            False,
+            id="disabled",
+        ),
+    ],
+    indirect=["unprivileged_model_namespace", "ogx_server"],
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicActivation:
+    """Conditional activation of remote::anthropic."""
+
+    @pytest.mark.tier1
+    def test_tc_e2e_009(self, ogx_client: OgxClient, expected_provider: bool) -> None:
+        """TC-E2E-009: Verify activation follows ANTHROPIC_API_KEY presence."""
+        provider_types = [provider.provider_type for provider in ogx_client.providers.list()]
+        assert (ANTHROPIC_PROVIDER_TYPE in provider_types) is expected_provider, (
+            f"Expected remote::anthropic presence={expected_provider}, got provider types {provider_types!r}"
+        )
+
+        if expected_provider:
+            _assert_chat_completion(
+                ogx_client=ogx_client,
+                model_id=_anthropic_model_id(ogx_client=ogx_client),
+            )
+            return
+
+        with pytest.raises(APIStatusError) as exc_info:
+            ogx_client.chat.completions.create(
+                model=ANTHROPIC_INFERENCE_MODEL or "claude-3-5-sonnet-latest",
+                messages=[{"role": "user", "content": "ACK"}],
+            )
+        assert 400 <= exc_info.value.status_code < 500, (
+            f"Expected a descriptive 4xx error with Anthropic disabled, got {exc_info.value.status_code}"
+        )
