+"""Negative tests for the remote::anthropic provider."""
+
+import json
+
+import pytest
+import structlog
+from ogx_client import APIStatusError, OgxClient
+
+from tests.ogx.conftest import ogx_client, ogx_server
+from tests.ogx.constants import (
+    ANTHROPIC_API_KEY,
+    ANTHROPIC_INFERENCE_MODEL,
+    ANTHROPIC_PROVIDER_DATA_HEADER,
+    ANTHROPIC_PROVIDER_ID,
+    ANTHROPIC_PROVIDER_TYPE,
+)
+
+LOGGER = structlog.get_logger(name=__name__)
+
+pytestmark = [pytest.mark.ogx, pytest.mark.skip_on_disconnected]
+
+
+def _anthropic_model_id(ogx_client: OgxClient) -> str:
+    """Return an Anthropic model id from an active provider."""
+    if ANTHROPIC_INFERENCE_MODEL:
+        return ANTHROPIC_INFERENCE_MODEL
+    for model in ogx_client.models.list().data:
+        if model.provider_id == ANTHROPIC_PROVIDER_ID and model.model_type == "llm":
+            return model.id
+    pytest.fail(reason="remote::anthropic is active but registered no LLM model")
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-invalid-key", "randomize_name": True},
+            {"enable_anthropic": True},
+            id="invalid-config-key",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicInvalidConfigKey:
+    """Authentication failure with an invalid config-level Anthropic key."""
+
+    @pytest.mark.tier3
+    def test_tc_neg_001(self, ogx_client: OgxClient) -> None:
+        """TC-NEG-001: Verify invalid config keys fail without leaking secrets."""
+        if not ANTHROPIC_API_KEY:
+            pytest.fail(
+                reason="Set OGX_CORE_ANTHROPIC_API_KEY (or ANTHROPIC_API_KEY) to an invalid "
+                "value to run the invalid config-level key scenario"
+            )
+
+        with pytest.raises(APIStatusError) as exc_info:
+            ogx_client.chat.completions.create(
+                model=_anthropic_model_id(ogx_client=ogx_client),
+                messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+            )
+
+        assert exc_info.value.status_code in (401, 403), (
+            f"Expected HTTP 401 or 403 for an invalid Anthropic key, got {exc_info.value.status_code}"
+        )
+        error_text = str(exc_info.value.body or exc_info.value)
+        assert ANTHROPIC_API_KEY not in error_text, "Invalid Anthropic API key leaked in the error response"
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-invalid-override", "randomize_name": True},
+            {"enable_anthropic": True},
+            id="invalid-override",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicInvalidOverride:
+    """Authentication failure with an invalid per-request Anthropic key."""
+
+    @pytest.mark.tier3
+    def test_tc_neg_002(self, ogx_client: OgxClient) -> None:
+        """TC-NEG-002: Verify invalid per-request keys do not corrupt the config key."""
+        invalid_key = "invalid-anthropic-key-for-negative-test"
+        with pytest.raises(APIStatusError) as exc_info:
+            ogx_client.chat.completions.create(
+                model=_anthropic_model_id(ogx_client=ogx_client),
+                messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+                extra_headers={
+                    ANTHROPIC_PROVIDER_DATA_HEADER: json.dumps({"anthropic_api_key": invalid_key})
+                },
+            )
+
+        assert exc_info.value.status_code in (401, 403), (
+            f"Expected HTTP 401 or 403 for an invalid per-request key, got {exc_info.value.status_code}"
+        )
+        error_text = str(exc_info.value.body or exc_info.value)
+        assert invalid_key not in error_text, "Invalid per-request Anthropic key leaked in the error response"
+
+        follow_up = ogx_client.chat.completions.create(
+            model=_anthropic_model_id(ogx_client=ogx_client),
+            messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+        )
+        assert follow_up.choices and follow_up.choices[0].message.content, (
+            "Config-level Anthropic key did not work after an invalid per-request override"
+        )
+
+
+@pytest.mark.parametrize(
+    "unprivileged_model_namespace, ogx_server",
+    [
+        pytest.param(
+            {"name": "test-anthropic-unset-key", "randomize_name": True},
+            {"enable_anthropic": False},
+            id="unset-key",
+        ),
+    ],
+    indirect=True,
+)
+@pytest.mark.usefixtures("unprivileged_model_namespace", "ogx_server")
+class TestAnthropicMissingKey:
+    """Provider behavior when ANTHROPIC_API_KEY is not set."""
+
+    @pytest.mark.tier3
+    def test_tc_neg_003(self, ogx_client: OgxClient) -> None:
+        """TC-NEG-003: Verify Anthropic is inactive and requests fail descriptively."""
+        provider_types = [provider.provider_type for provider in ogx_client.providers.list()]
+        assert ANTHROPIC_PROVIDER_TYPE not in provider_types, (
+            f"remote::anthropic activated without ANTHROPIC_API_KEY; providers={provider_types!r}"
+        )
+
+        with pytest.raises(APIStatusError) as exc_info:
+            ogx_client.chat.completions.create(
+                model=ANTHROPIC_INFERENCE_MODEL or "claude-3-5-sonnet-latest",
+                messages=[{"role": "user", "content": "Reply with exactly ACK."}],
+            )
+        assert 400 <= exc_info.value.status_code < 500, (
+            f"Expected a descriptive 4xx error with Anthropic disabled, got {exc_info.value.status_code}"
+        )
