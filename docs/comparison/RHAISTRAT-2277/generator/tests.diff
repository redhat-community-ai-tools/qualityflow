+@pytest.mark.post_upgrade
+def test_tc_e2e_005(admin_client: DynamicClient) -> None:
+    """TC-E2E-005: Verify file-search citations reference the pre-upgrade file with valid offsets.
+
+    Given one known uploaded file and a question whose answer is in that file.
+    When the Responses API is called with the file_search tool.
+    Then citations name that file and every annotation offset yields a non-empty span.
+
+    OGX port-8321 delegation is not observable through this public harness and remains unverified.
+    """
+    route, _ = _praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    known_answer = "The archival retention period is seven years."
+    with _api_client(route=route, token=token) as client:
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt") as upload:
+            upload.write(f"{known_answer}\n")
+            upload.flush()
+            created_file = client.files.create(file=upload.name, purpose="assistants")
+        created_store = client.vector_stores.create(name="citation-offset-probe")
+        client.vector_stores.files.create(vector_store_id=created_store.id, file_id=created_file.id)
+        _wait_for_completed_attachment(
+            client=client,
+            vector_store_id=created_store.id,
+            file_id=created_file.id,
+        )
+
+        response = client.responses.create(
+            model=os.getenv("OGX_PRAXIS_MODEL", DEFAULT_RESPONSE_MODEL),
+            input="What retention period does the archival policy specify?",
+            stream=False,
+            max_output_tokens=128,
+            tools=[{"type": "file_search", "vector_store_ids": [created_store.id]}],
+        )
+
+    citations = _citation_annotations(response=response)
+    assert citations, "Expected at least one file_citation annotation"
+    assert any(annotation.file_id == created_file.id for annotation in citations), (
+        f"Expected citation for uploaded file {created_file.id}, got {[a.file_id for a in citations]}"
+    )
+    output_text = response.output_text or ""
+    assert output_text, "Response output_text must be non-empty before validating citation offsets"
+    for annotation in citations:
+        start_index = annotation.start_index
+        end_index = annotation.end_index
+        assert isinstance(start_index, int) and isinstance(end_index, int), "Citation offsets must be integers"
+        assert 0 <= start_index < end_index <= len(output_text), (
