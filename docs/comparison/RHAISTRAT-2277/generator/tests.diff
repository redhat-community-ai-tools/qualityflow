+"""Upgrade coverage for the OGX-to-Praxis routing transition."""
+
+from collections.abc import Generator
+from contextlib import contextmanager
+import json
+import os
+from typing import Any
+
+import httpx
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.config_map import ConfigMap
+from ocp_resources.deployment import Deployment
+from ocp_resources.service import Service
+from ogx_client import OgxClient
+
+from tests.ogx.constants import OGX_CLIENT_VERIFY_SSL
+from utilities.resources.http_route import HTTPRoute
+
+
+RESPONSES_PATH = "/v1/responses"
+BASELINE_CONFIG_MAP = "ogx-praxis-upgrade-inventory"
+PRAXIS_LABEL_SELECTOR = "app.kubernetes.io/name=praxis-gateway"
+
+
+def _route_matches_path(route: HTTPRoute, path: str) -> bool:
+    """Return whether an HTTPRoute rule explicitly matches ``path``."""
+    for rule in route.instance.spec.rules or []:
+        for match in rule.get("matches", []):
+            path_match = match.get("path", {})
+            value = path_match.get("value")
+            match_type = path_match.get("type", "PathPrefix")
+            if value == path:
+                return True
+            if match_type == "PathPrefix" and value and path.startswith(value.rstrip("/") + "/"):
+                return True
+    return False
+
+
+def _single_praxis_route(client: DynamicClient, path: str) -> HTTPRoute:
+    """Return the sole public HTTPRoute for ``path``."""
+    routes = [route for route in HTTPRoute.get(client=client) if _route_matches_path(route=route, path=path)]
+    assert len(routes) == 1, (
+        f"Expected exactly one HTTPRoute for {path}, found {len(routes)}: "
+        f"{[f'{route.namespace}/{route.name}' for route in routes]}"
+    )
+    return routes[0]
+
+
+def _backend_service(client: DynamicClient, route: HTTPRoute) -> Service:
+    """Return the first backend Service declared by ``route``."""
+    refs: list[dict[str, Any]] = []
+    for rule in route.instance.spec.rules or []:
+        refs.extend(rule.get("backendRefs", []))
+    assert refs, f"HTTPRoute {route.namespace}/{route.name} has no backendRefs"
+    backend = refs[0]
+    name = backend.get("name")
+    namespace = backend.get("namespace", route.namespace)
+    assert name, "HTTPRoute backendRef must have a name"
+    service = Service(client=client, name=name, namespace=namespace)
+    assert service.exists, f"Backend Service {namespace}/{name} does not exist"
+    return service
+
+
+def _praxis_deployment(client: DynamicClient, service: Service) -> Deployment:
+    """Return the Deployment whose selector matches the Praxis Service."""
+    service_selector = dict(service.instance.spec.selector or {})
+    for deployment in Deployment.get(client=client, namespace=service.namespace):
+        selector = dict(deployment.instance.spec.selector.matchLabels or {})
+        if all(selector.get(key) == value for key, value in service_selector.items()):
+            return deployment
+    pytest.fail(f"No Deployment in {service.namespace} matches Service selector {service_selector}")
+
+
+def _public_hostname(route: HTTPRoute) -> str:
+    """Return the first public hostname declared by ``route``."""
+    hostnames = route.instance.spec.hostnames or []
+    assert hostnames, f"HTTPRoute {route.namespace}/{route.name} declares no public hostname"
+    return str(hostnames[0])
+
+
+def _api_token() -> str:
+    """Return the externally supplied tenant token."""
+    token = os.getenv("OGX_PRAXIS_TOKEN")
+    if not token:
+        pytest.skip("OGX_PRAXIS_TOKEN is required to inspect public API state")
+    return token
+
+
+@contextmanager
+def _api_client(route: HTTPRoute, token: str) -> Generator[OgxClient]:
+    """Build an OGX-compatible client for the public route."""
+    http_client = httpx.Client(
+        verify=OGX_CLIENT_VERIFY_SSL,
+        timeout=60,
+        headers={"Authorization": f"Bearer {token}"},
+    )
+    try:
+        yield OgxClient(
+            base_url=f"https://{_public_hostname(route=route)}",
+            http_client=http_client,
+            timeout=60,
+        )
+    finally:
+        http_client.close()
+
+
+def _get_json(route: HTTPRoute, token: str, path: str) -> dict[str, Any]:
+    """GET a public JSON endpoint and fail on a non-success response."""
+    response = httpx.get(
+        f"https://{_public_hostname(route=route)}{path}",
+        headers={"Authorization": f"Bearer {token}"},
+        timeout=60,
+    )
+    assert response.status_code == 200, f"GET {path} returned {response.status_code}"
+    return response.json()
+
+
+def _state_inventory(route: HTTPRoute, token: str) -> dict[str, Any]:
+    """Return counts and sampled IDs for all migrated resource families."""
+    inventory: dict[str, Any] = {}
+    for resource_type, path in (
+        ("files", "/v1/files"),
+        ("vector_stores", "/v1/vector_stores"),
+        ("conversations", "/v1/conversations"),
+        ("responses", "/v1/responses"),
+    ):
+        body = _get_json(route=route, token=token, path=path)
+        items = body.get("data", [])
+        inventory[resource_type] = {
+            "count": len(items),
+            "sampled_ids": [item.get("id") for item in items[:5] if item.get("id")],
+        }
+    return inventory
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+@pytest.mark.pre_upgrade
+@pytest.mark.post_upgrade
+def test_tc_upg_001(
+    admin_client: DynamicClient,
+    pytestconfig: pytest.Config,
+) -> None:
+    """TC-UPG-001: Verify state preservation and readiness-ordered Praxis routing across upgrade.
+
+    Given the same public hostname and tenant credentials across the upgrade.
+    When pre-upgrade state is captured and post-upgrade routing and state are inspected.
+    Then Praxis is ready before public routing, state counts and sampled IDs are unchanged, and the host is stable.
+
+    The continuous two-second probe and maximum disruption window require an external upgrade orchestration
+    harness; they are intentionally reported as unverified rather than replaced by a fabricated assertion.
+    """
+    route = _single_praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    service = _backend_service(client=admin_client, route=route)
+    deployment = _praxis_deployment(client=admin_client, service=service)
+    namespace = service.namespace
