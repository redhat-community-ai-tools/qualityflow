+"""End-to-end coverage for the OGX-to-Praxis migration.
+
+These tests intentionally discover routing from the cluster instead of assuming
+Praxis service names. A missing or ambiguous route is a failure, not a skip,
+because the public topology is part of the migration contract.
+"""
+
+from collections.abc import Generator
+from contextlib import contextmanager
+import json
+import math
+import os
+import tempfile
+import time
+from typing import Any
+
+import httpx
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.config_map import ConfigMap
+from ocp_resources.deployment import Deployment
+from ocp_resources.pod import Pod
+from ocp_resources.route import Route
+from ocp_resources.service import Service
+from ogx_client import OgxClient
+
+from tests.ogx.constants import OGX_CLIENT_VERIFY_SSL
+from utilities.resources.http_route import HTTPRoute
+
+
+RESPONSES_PATH = "/v1/responses"
+EMBEDDINGS_PATH = "/v1/embeddings"
+BASELINE_CONFIG_MAP = "ogx-praxis-migration-baseline"
+PRAXIS_LABEL_SELECTOR = "app.kubernetes.io/name=praxis-gateway"
+OGX_LABEL_SELECTOR = "app=ogx"
+DEFAULT_RESPONSE_MODEL = "granite-3-8b-instruct"
+DEFAULT_EMBEDDING_MODEL = "nomic-embed-text-v1.5"
+
+
+def _route_matches_path(route: HTTPRoute, path: str) -> bool:
+    """Return whether any HTTPRoute rule explicitly matches ``path``."""
+    rules = route.instance.spec.rules or []
+    for rule in rules:
+        for match in rule.get("matches", []):
+            path_match = match.get("path", {})
+            value = path_match.get("value")
+            match_type = path_match.get("type", "PathPrefix")
+            if value == path:
+                return True
+            if match_type == "PathPrefix" and value and path.startswith(value.rstrip("/") + "/"):
+                return True
+    return False
+
+
+def _routes_for_path(client: DynamicClient, path: str) -> list[HTTPRoute]:
+    """Return every cluster-wide HTTPRoute that declares ``path``."""
+    return [route for route in HTTPRoute.get(client=client) if _route_matches_path(route=route, path=path)]
+
+
+def _single_route_for_path(client: DynamicClient, path: str) -> HTTPRoute:
+    """Return the sole HTTPRoute for ``path`` or fail with a topology error."""
+    routes = _routes_for_path(client=client, path=path)
+    assert len(routes) == 1, (
+        f"Expected exactly one HTTPRoute for {path}, found {len(routes)}: "
+        f"{[f'{route.namespace}/{route.name}' for route in routes]}"
+    )
+    return routes[0]
+
+
+def _backend_refs(route: HTTPRoute) -> list[dict[str, Any]]:
+    """Return every backendRef declared by ``route``."""
+    refs: list[dict[str, Any]] = []
+    for rule in route.instance.spec.rules or []:
+        refs.extend(rule.get("backendRefs", []))
+    return refs
+
+
+def _service_for_backend(client: DynamicClient, route: HTTPRoute, backend_ref: dict[str, Any]) -> Service:
+    """Return the Service named by one backendRef, failing if it is absent."""
+    name = backend_ref.get("name")
+    namespace = backend_ref.get("namespace", route.namespace)
+    assert name, f"HTTPRoute {route.namespace}/{route.name} has a backendRef without a name"
+    service = Service(client=client, name=name, namespace=namespace)
+    assert service.exists, f"Backend Service {namespace}/{name} does not exist"
+    return service
+
+
+def _selector_values(service: Service) -> dict[str, str]:
+    """Return the Service selector as a plain string dictionary."""
+    selector = service.instance.spec.selector or {}
+    return {str(key): str(value) for key, value in selector.items()}
+
+
+def _is_praxis_service(service: Service) -> bool:
+    """Return whether ``service`` selects the documented Praxis gateway workload."""
+    selector = _selector_values(service=service)
+    return selector.get("app.kubernetes.io/name") == "praxis-gateway" or selector.get("app") == "praxis-gateway"
+
+
+def _is_ogx_service(service: Service) -> bool:
+    """Return whether ``service`` selects the OGX workload."""
+    selector = _selector_values(service=service)
+    return selector.get("app") == "ogx" or selector.get("app.kubernetes.io/name") == "ogx"
+
+
+def _praxis_route(client: DynamicClient, path: str) -> tuple[HTTPRoute, Service]:
+    """Return the sole Praxis HTTPRoute and its backend Service for ``path``."""
+    route = _single_route_for_path(client=client, path=path)
+    refs = _backend_refs(route=route)
+    assert refs, f"HTTPRoute {route.namespace}/{route.name} has no backendRefs"
+    services = [_service_for_backend(client=client, route=route, backend_ref=ref) for ref in refs]
+    assert all(_is_praxis_service(service=service) for service in services), (
+        f"HTTPRoute {route.namespace}/{route.name} must select only Praxis, got selectors: "
+        f"{[_selector_values(service=service) for service in services]}"
+    )
+    return route, services[0]
+
+
+def _public_hostname(route: HTTPRoute) -> str:
+    """Return the first public hostname declared by ``route``."""
+    hostnames = route.instance.spec.hostnames or []
+    assert hostnames, f"HTTPRoute {route.namespace}/{route.name} declares no public hostname"
+    return str(hostnames[0])
+
+
+def _api_token() -> str:
+    """Return the externally supplied tenant token, skipping only when absent."""
+    token = os.getenv("OGX_PRAXIS_TOKEN")
+    if not token:
+        pytest.skip("OGX_PRAXIS_TOKEN is required to exercise the authenticated public API")
+    return token
+
+
+@contextmanager
+def _api_client(route: HTTPRoute, token: str | None = None) -> Generator[OgxClient]:
+    """Build an OGX-compatible client for the public Praxis route."""
+    headers = {}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    http_client = httpx.Client(verify=OGX_CLIENT_VERIFY_SSL, timeout=60, headers=headers)
+    try:
+        yield OgxClient(
+            base_url=f"https://{_public_hostname(route=route)}",
+            http_client=http_client,
+            timeout=60,
+        )
+    finally:
+        http_client.close()
+
+
+def _post_json(route: HTTPRoute, token: str, path: str, payload: dict[str, Any]) -> httpx.Response:
+    """POST JSON directly so response headers remain available to the test."""
+    return httpx.post(
+        f"https://{_public_hostname(route=route)}{path}",
+        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
+        json=payload,
+        timeout=60,
+    )
+
+
+def _request_id(response: httpx.Response) -> str:
+    """Return the request ID used to correlate the public request with pod logs."""
+    request_id = response.headers.get("x-request-id") or response.headers.get("request-id")
+    assert request_id, "Public API response did not expose a request ID for backend correlation"
+    return request_id
+
+
+def _pod_logs(client: DynamicClient, label_selector: str, namespace: str | None = None) -> str:
+    """Return concatenated logs for all pods selected by ``label_selector``."""
+    logs: list[str] = []
+    pods = Pod.get(client=client, label_selector=label_selector)
+    if namespace:
+        pods = [pod for pod in pods if pod.namespace == namespace]
+    for pod in pods:
+        containers = pod.instance.spec.containers or []
+        assert containers, f"Pod {pod.namespace}/{pod.name} has no containers"
+        try:
+            logs.append(pod.log(container=containers[0].name))
+        except Exception:  # noqa: BLE001 - an unreadable log must not hide readable evidence
+            continue
+    return "\n".join(logs)
+
+
+def _assert_no_external_ogx_route(client: DynamicClient) -> None:
+    """Fail if any external route exposes the OGX implementation publicly."""
+    for route in HTTPRoute.get(client=client):
+        if not _route_matches_path(route=route, path=RESPONSES_PATH):
+            continue
+        for backend_ref in _backend_refs(route=route):
+            service = _service_for_backend(client=client, route=route, backend_ref=backend_ref)
+            assert not _is_ogx_service(service=service), (
+                f"HTTPRoute {route.namespace}/{route.name} externally exposes OGX Service "
+                f"{service.namespace}/{service.name}"
+            )
+
+    for openshift_route in Route.get(client=client):
+        route_path = openshift_route.instance.spec.path or ""
+        if RESPONSES_PATH not in route_path:
+            continue
+        backend = openshift_route.instance.spec.to or {}
+        service_name = backend.get("name")
+        service = Service(client=client, name=service_name, namespace=openshift_route.namespace)
+        if service.exists:
+            assert not _is_ogx_service(service=service), (
+                f"OpenShift Route {openshift_route.namespace}/{openshift_route.name} exposes OGX Service "
+                f"{service.namespace}/{service.name}"
+            )
+
+
+def _deployment_for_service(client: DynamicClient, service: Service) -> Deployment:
+    """Return the Deployment whose selector matches ``service``."""
+    service_selector = _selector_values(service=service)
+    deployments = list(Deployment.get(client=client, namespace=service.namespace))
+    for deployment in deployments:
+        selector = dict(deployment.instance.spec.selector.matchLabels or {})
+        if all(selector.get(key) == value for key, value in service_selector.items()):
+            return deployment
+    pytest.fail(f"No Deployment in {service.namespace} matches Service selector {service_selector}")
+
+
+def _vector_store_file_completed(client: OgxClient, vector_store_id: str, file_id: str) -> bool:
+    """Return whether one vector-store file reports completed ingestion."""
+    files = client.vector_stores.files.list(vector_store_id=vector_store_id, filter="completed")
+    return any(item.id == file_id for item in files)
+
+
+def _wait_for_completed_attachment(
+    client: OgxClient,
+    vector_store_id: str,
+    file_id: str,
+    timeout_seconds: int = 120,
+) -> None:
+    """Wait for a vector-store attachment to complete with a hard deadline."""
+    deadline = time.monotonic() + timeout_seconds
+    while time.monotonic() < deadline:
+        if _vector_store_file_completed(client=client, vector_store_id=vector_store_id, file_id=file_id):
+            return
+        time.sleep(2)
+    pytest.fail(f"File {file_id} did not complete ingestion in vector store {vector_store_id} within {timeout_seconds}s")
+
+
+def _citation_annotations(response: Any) -> list[Any]:
+    """Return every file_citation annotation from a Responses API object."""
+    annotations: list[Any] = []
+    for output_item in response.output:
+        if output_item.type != "message" or not isinstance(output_item.content, list):
+            continue
+        for content_item in output_item.content:
+            annotations.extend(content_item.annotations or [])
+    return [annotation for annotation in annotations if annotation.type == "file_citation"]
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_e2e_001(admin_client: DynamicClient) -> None:
+    """TC-E2E-001: Verify greenfield Praxis routing and a single public implementation.
+
+    Given a greenfield RHOAI 3.6 deployment.
+    When the /v1/responses topology and an authenticated request are inspected.
+    Then exactly one external route selects Praxis, the response is valid, and OGX is not public.
+    """
+    route, praxis_service = _praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    response = _post_json(
+        route=route,
+        token=token,
+        path=RESPONSES_PATH,
+        payload={
+            "model": os.getenv("OGX_PRAXIS_MODEL", DEFAULT_RESPONSE_MODEL),
+            "input": "Summarize the Q3 migration report.",
+        },
+    )
+    assert response.status_code == 200, f"Expected HTTP 200 from {RESPONSES_PATH}, got {response.status_code}"
+    body = response.json()
+    assert body.get("id"), "Responses body must contain a non-empty id"
+    assert body.get("output"), "Responses body must contain a non-empty output"
+
+    request_id = _request_id(response=response)
+    praxis_logs = _pod_logs(
+        client=admin_client,
+        label_selector=PRAXIS_LABEL_SELECTOR,
+        namespace=praxis_service.namespace,
+    )
+    ogx_logs = _pod_logs(
+        client=admin_client,
+        label_selector=OGX_LABEL_SELECTOR,
+        namespace=praxis_service.namespace,
+    )
+    assert request_id in praxis_logs, f"Request ID {request_id} was not found in Praxis pod logs"
+    assert request_id not in ogx_logs, f"Request ID {request_id} unexpectedly appeared in OGX pod logs"
+    _assert_no_external_ogx_route(client=admin_client)
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+def test_tc_e2e_002(admin_client: DynamicClient) -> None:
+    """TC-E2E-002: Verify Praxis embedding routing, dimensions, batching, and usage.
+
+    Given a configured embedding backend with a recorded expected dimension.
+    When single and two-element embedding requests are sent.
+    Then both return valid vectors with exact dimensions and ordered batch indexes.
+    """
+    dimension_raw = os.getenv("OGX_PRAXIS_EMBEDDING_DIMENSION")
+    if not dimension_raw:
+        pytest.skip("OGX_PRAXIS_EMBEDDING_DIMENSION must be recorded before the run")
+    expected_dimension = int(dimension_raw)
+    model = os.getenv("OGX_PRAXIS_EMBEDDING_MODEL", DEFAULT_EMBEDDING_MODEL)
+    route, _ = _praxis_route(client=admin_client, path=EMBEDDINGS_PATH)
+    token = _api_token()
+
+    single = _post_json(
+        route=route,
+        token=token,
+        path=EMBEDDINGS_PATH,
+        payload={"model": model, "input": "quarterly migration readiness review"},
+    )
+    assert single.status_code == 200, f"Expected HTTP 200 from {EMBEDDINGS_PATH}, got {single.status_code}"
+    single_body = single.json()
+    assert single_body.get("model") == model, f"Expected model {model!r}, got {single_body.get('model')!r}"
+    single_data = single_body.get("data", [])
+    assert len(single_data) == 1, f"Expected one embedding object, got {len(single_data)}"
+    embedding = single_data[0].get("embedding", [])
+    assert len(embedding) == expected_dimension, (
+        f"Expected embedding dimension {expected_dimension}, got {len(embedding)}"
+    )
+    assert all(isinstance(value, float) and math.isfinite(value) for value in embedding), (
+        "Every embedding value must be a finite float"
+    )
+
+    batch = _post_json(
+        route=route,
+        token=token,
+        path=EMBEDDINGS_PATH,
+        payload={"model": model, "input": ["migration readiness", "rollback readiness"]},
+    )
+    assert batch.status_code == 200, f"Expected HTTP 200 for batch embeddings, got {batch.status_code}"
+    batch_body = batch.json()
+    batch_data = batch_body.get("data", [])
+    assert len(batch_data) == 2, f"Expected two embedding objects, got {len(batch_data)}"
+    assert sorted(item.get("index") for item in batch_data) == [0, 1], "Batch indexes must be exactly 0 and 1"
+    usage = batch_body.get("usage", {})
+    assert usage.get("prompt_tokens", 0) > 0, "usage.prompt_tokens must be present and greater than zero"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+@pytest.mark.pre_upgrade
+@pytest.mark.post_upgrade
+def test_tc_e2e_003(
+    admin_client: DynamicClient,
+    pytestconfig: pytest.Config,
+) -> None:
+    """TC-E2E-003: Verify 3.5-created files and vector stores survive unchanged through Praxis.
+
+    Given the same public client and IDs across the upgrade boundary.
+    When pre-upgrade responses are captured and post-upgrade responses are compared.
+    Then the required identity and metadata fields remain byte-identical.
+    """
+    route, praxis_service = _praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    namespace = praxis_service.namespace
+
+    if pytestconfig.option.pre_upgrade:
+        with _api_client(route=route, token=token) as client:
+            file_baselines: list[dict[str, Any]] = []
+            for index in range(3):
+                with tempfile.NamedTemporaryFile(mode="w", suffix=".txt") as upload:
+                    upload.write(f"migration baseline file {index}\n")
+                    upload.flush()
+                    created = client.files.create(file=upload.name, purpose="assistants")
+                fetched = client.files.retrieve(file_id=created.id)
+                file_baselines.append(fetched.model_dump())
+
+            vector_store_baselines: list[dict[str, Any]] = []
+            for index in range(2):
+                created_store = client.vector_stores.create(name=f"migration-baseline-{index}")
+                fetched_store = client.vector_stores.retrieve(vector_store_id=created_store.id)
+                vector_store_baselines.append(fetched_store.model_dump())
+
+        baseline = {
+            "files": file_baselines,
+            "vector_stores": vector_store_baselines,
+        }
+        with ConfigMap(
+            client=admin_client,
+            name=BASELINE_CONFIG_MAP,
+            namespace=namespace,
+            data={"baseline.json": json.dumps(baseline)},
+            teardown=False,
+        ):
+            pass
+        return
+
+    if not pytestconfig.option.post_upgrade:
+        pytest.skip("TC-E2E-003 requires the pre-upgrade and post-upgrade phases")
+
+    baseline_config_map = ConfigMap(client=admin_client, name=BASELINE_CONFIG_MAP, namespace=namespace)
+    assert baseline_config_map.exists, f"Baseline ConfigMap {namespace}/{BASELINE_CONFIG_MAP} is missing"
+    baseline = json.loads(baseline_config_map.instance.data["baseline.json"])
+    with _api_client(route=route, token=token) as client:
+        for baseline_file in baseline["files"]:
+            fetched = client.files.retrieve(file_id=baseline_file["id"])
+            current = fetched.model_dump()
+            for field in ("id", "bytes", "filename", "created_at", "status"):
+                assert current.get(field) == baseline_file.get(field), (
+                    f"File {baseline_file['id']} changed {field}: {baseline_file.get(field)!r} -> {current.get(field)!r}"
+                )
+
+        for baseline_store in baseline["vector_stores"]:
+            fetched = client.vector_stores.retrieve(vector_store_id=baseline_store["id"])
+            current = fetched.model_dump()
+            for field in ("id", "created_at", "name"):
+                assert current.get(field) == baseline_store.get(field), (
+                    f"Vector store {baseline_store['id']} changed {field}: "
+                    f"{baseline_store.get(field)!r} -> {current.get(field)!r}"
+                )
+
+
+@pytest.mark.ogx
+@pytest.mark.tier1
+@pytest.mark.post_upgrade
+def test_tc_e2e_004(admin_client: DynamicClient) -> None:
+    """TC-E2E-004: Verify upgraded-topology resource creation and backend ownership signals.
+
+    Given an upgraded cluster with Praxis fronting OGX.
+    When File, Vector Store, Conversation, and Response resources are created.
+    Then each returns a non-empty ID and the IDs are visible only in the public Praxis backend logs.
+
+    Database ownership and audit-log exclusivity require direct state-store access that this
+    harness does not expose; those acceptance criteria remain explicitly unverified.
+    """
+    route, praxis_service = _praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    with _api_client(route=route, token=token) as client:
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt") as upload:
+            upload.write("authoritative backend ownership probe\n")
+            upload.flush()
+            created_file = client.files.create(file=upload.name, purpose="assistants")
+        created_store = client.vector_stores.create(name="authoritative-backend-probe")
+        client.vector_stores.files.create(vector_store_id=created_store.id, file_id=created_file.id)
+        _wait_for_completed_attachment(
+            client=client,
+            vector_store_id=created_store.id,
+            file_id=created_file.id,
+        )
+        created_conversation = client.conversations.create(metadata={"purpose": "migration-ownership"})
+        created_response = client.responses.create(
+            model=os.getenv("OGX_PRAXIS_MODEL", DEFAULT_RESPONSE_MODEL),
+            input="Return the single word: migration.",
+            conversation=created_conversation.id,
+            store=True,
+            stream=False,
+            max_output_tokens=32,
+        )
+
+    resource_ids = [created_file.id, created_store.id, created_conversation.id, created_response.id]
+    assert all(resource_ids), f"Every created resource must return a non-empty ID, got {resource_ids}"
+
+    praxis_logs = _pod_logs(
+        client=admin_client,
+        label_selector=PRAXIS_LABEL_SELECTOR,
+        namespace=praxis_service.namespace,
+    )
+    ogx_logs = _pod_logs(
+        client=admin_client,
+        label_selector=OGX_LABEL_SELECTOR,
+        namespace=praxis_service.namespace,
+    )
+    for resource_id in resource_ids:
+        assert resource_id in praxis_logs, f"Resource {resource_id} was not observed in Praxis logs"
+        assert resource_id not in ogx_logs, f"Resource {resource_id} unexpectedly appeared in OGX logs"
+
+
+@pytest.mark.ogx
