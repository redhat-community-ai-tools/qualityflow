+"""Negative and security coverage for the OGX-to-Praxis migration."""
+
+from collections.abc import Generator
+from contextlib import contextmanager
+import os
+import socket
+import tempfile
+import time
+from typing import Any
+
+import httpx
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.deployment import Deployment
+from ocp_resources.service import Service
+from ogx_client import APIError, OgxClient
+
+from tests.ogx.constants import OGX_CLIENT_VERIFY_SSL
+from utilities.resources.http_route import HTTPRoute
+
+
+RESPONSES_PATH = "/v1/responses"
+PRAXIS_LABEL_SELECTOR = "app.kubernetes.io/name=praxis-gateway"
+OGX_LABEL_SELECTOR = "app=ogx"
+DEFAULT_RESPONSE_MODEL = "granite-3-8b-instruct"
+
+
+def _route_matches_path(route: HTTPRoute, path: str) -> bool:
+    """Return whether an HTTPRoute rule explicitly matches ``path``."""
+    for rule in route.instance.spec.rules or []:
+        for match in rule.get("matches", []):
+            path_match = match.get("path", {})
+            value = path_match.get("value")
+            match_type = path_match.get("type", "PathPrefix")
+            if value == path:
+                return True
+            if match_type == "PathPrefix" and value and path.startswith(value.rstrip("/") + "/"):
+                return True
+    return False
+
+
+def _single_praxis_route(client: DynamicClient, path: str) -> HTTPRoute:
+    """Return the sole public HTTPRoute for ``path``."""
+    routes = [route for route in HTTPRoute.get(client=client) if _route_matches_path(route=route, path=path)]
+    assert len(routes) == 1, (
+        f"Expected exactly one HTTPRoute for {path}, found {len(routes)}: "
+        f"{[f'{route.namespace}/{route.name}' for route in routes]}"
+    )
+    return routes[0]
+
+
+def _public_hostname(route: HTTPRoute) -> str:
+    """Return the first public hostname declared by ``route``."""
+    hostnames = route.instance.spec.hostnames or []
+    assert hostnames, f"HTTPRoute {route.namespace}/{route.name} declares no public hostname"
+    return str(hostnames[0])
+
+
+def _api_token() -> str:
+    """Return the externally supplied tenant token."""
+    token = os.getenv("OGX_PRAXIS_TOKEN")
+    if not token:
+        pytest.skip("OGX_PRAXIS_TOKEN is required to exercise authenticated requests")
+    return token
+
+
+@contextmanager
+def _api_client(
+    route: HTTPRoute,
+    token: str | None = None,
+    user_id: str | None = None,
+    tenant_id: str | None = None,
+) -> Generator[OgxClient]:
+    """Build an OGX-compatible client with optional tenant identity headers."""
+    headers: dict[str, str] = {}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    if user_id:
+        headers["x-user-id"] = user_id
+    if tenant_id:
+        headers["x-tenant-id"] = tenant_id
+    http_client = httpx.Client(verify=OGX_CLIENT_VERIFY_SSL, timeout=60, headers=headers)
+    try:
+        yield OgxClient(
+            base_url=f"https://{_public_hostname(route=route)}",
+            http_client=http_client,
+            timeout=60,
+        )
+    finally:
+        http_client.close()
+
+
+def _post_json(
+    route: HTTPRoute,
+    path: str,
+    payload: dict[str, Any],
+    token: str | None = None,
+) -> httpx.Response:
+    """POST JSON directly so status and body remain observable."""
+    headers = {"Content-Type": "application/json"}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    return httpx.post(
+        f"https://{_public_hostname(route=route)}{path}",
+        headers=headers,
+        json=payload,
+        timeout=60,
+    )
+
+
+def _status_code(exc: Exception) -> int | None:
+    """Extract an HTTP status code from an SDK or httpx exception."""
+    status_code = getattr(exc, "status_code", None)
+    if status_code is None and hasattr(exc, "response") and exc.response is not None:
+        status_code = getattr(exc.response, "status_code", None)
+    return status_code
+
+
+def _ogx_service(client: DynamicClient, namespace: str) -> Service:
+    """Return the internal OGX Service selected by the documented workload label."""
+    services = [
+        service
+        for service in Service.get(client=client, namespace=namespace)
+        if dict(service.instance.spec.selector or {}).get("app") == "ogx"
+    ]
+    assert services, "No internal OGX Service was found with selector app=ogx"
+    return services[0]
+
+
+def _deployment_for_service(client: DynamicClient, service: Service) -> Deployment:
+    """Return the Deployment whose selector matches ``service``."""
+    service_selector = dict(service.instance.spec.selector or {})
+    for deployment in Deployment.get(client=client, namespace=service.namespace):
+        selector = dict(deployment.instance.spec.selector.matchLabels or {})
+        if all(selector.get(key) == value for key, value in service_selector.items()):
+            return deployment
+    pytest.fail(f"No Deployment in {service.namespace} matches Service selector {service_selector}")
+
+
+def _wait_for_replicas(deployment: Deployment, expected: int, timeout: int = 120) -> None:
+    """Wait for a Deployment to reach an exact ready-replica count."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        ready = deployment.instance.status.readyReplicas or 0
+        if ready == expected:
+            return
+        time.sleep(2)
+    pytest.fail(
+        f"Deployment {deployment.namespace}/{deployment.name} did not reach {expected} ready replicas "
+        f"within {timeout}s"
+    )
+
+
+def _structured_error(response: httpx.Response) -> dict[str, Any]:
+    """Return the OpenAI-compatible error object or fail with a useful message."""
+    try:
+        body = response.json()
+    except ValueError as exc:
+        pytest.fail(f"Expected a JSON error body, got {response.text!r}: {exc}")
+    error = body.get("error")
+    assert isinstance(error, dict), f"Expected an error object, got {body!r}"
+    return error
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_neg_001(admin_client: DynamicClient) -> None:
+    """TC-NEG-001: Verify the OGX delegation port is private and public auth rejects bad credentials.
+
+    Given Praxis is public and OGX is internal-only.
+    When port 8321 and authenticated API boundaries are probed.
+    Then no external TCP handshake succeeds and unauthenticated or malformed requests return 401.
+    """
+    route = _single_praxis_route(client=admin_client, path=RESPONSES_PATH)
+    hostname = _public_hostname(route=route)
+
+    try:
+        with socket.create_connection((hostname, 8321), timeout=5):
+            pytest.fail(f"External TCP connection to {hostname}:8321 unexpectedly succeeded")
+    except (OSError, TimeoutError):
+        pass
+
+    payload = {
+        "model": os.getenv("OGX_PRAXIS_MODEL", DEFAULT_RESPONSE_MODEL),
+        "input": "Return the single word: security.",
+    }
+    unauthenticated = _post_json(route=route, path=RESPONSES_PATH, payload=payload)
+    assert unauthenticated.status_code == 401, (
+        f"Expected HTTP 401 without Authorization, got {unauthenticated.status_code}"
+    )
+    unauthenticated_body = unauthenticated.text.lower()
+    for forbidden in ("traceback", "exception", ".svc.cluster.local", "pod/"):
+        assert forbidden not in unauthenticated_body, (
+            f"Unauthenticated error leaked internal detail {forbidden!r}: {unauthenticated.text}"
+        )
+
+    malformed = _post_json(
+        route=route,
+        path=RESPONSES_PATH,
+        payload=payload,
+        token="not-a-valid-token",
+    )
+    assert malformed.status_code == 401, f"Expected HTTP 401 for malformed bearer token, got {malformed.status_code}"
+
+
+@pytest.mark.ogx
+@pytest.mark.tier3
+def test_tc_neg_002(admin_client: DynamicClient) -> None:
+    """TC-NEG-002: Verify structured errors and recovery when OGX delegation is unavailable.
+
+    Given a known file and vector store that work while OGX is healthy.
+    When OGX is temporarily scaled to zero.
+    Then state-dependent requests return structured HTTP 503 errors and recovery restores the baseline.
+    """
+    route = _single_praxis_route(client=admin_client, path=RESPONSES_PATH)
+    token = _api_token()
+    with _api_client(route=route, token=token) as client:
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt") as upload:
+            upload.write("delegation failure baseline\n")
+            upload.flush()
+            created_file = client.files.create(file=upload.name, purpose="assistants")
+        created_store = client.vector_stores.create(name="delegation-failure-probe")
+        baseline = client.files.retrieve(file_id=created_file.id).model_dump()
+
+    ogx_service = _ogx_service(client=admin_client, namespace=route.namespace)
+    deployment = _deployment_for_service(client=admin_client, service=ogx_service)
+    original_replicas = deployment.instance.spec.replicas or 1
+    deployment.scale_replicas(replica_count=0)
+    try:
+        _wait_for_replicas(deployment=deployment, expected=0)
+        unavailable_file = _post_json(
+            route=route,
+            path=f"/v1/files/{created_file.id}",
+            payload={},
+            token=token,
+        )
+        assert unavailable_file.status_code == 503, (
+            f"Expected HTTP 503 while OGX is unavailable, got {unavailable_file.status_code}"
+        )
+        file_error = _structured_error(response=unavailable_file)
+        for field in ("type", "message", "code"):
+            assert file_error.get(field), f"Error object field {field!r} must be non-empty"
+
+        unavailable_response = _post_json(
+            route=route,
+            path=RESPONSES_PATH,
+            payload={
+                "model": os.getenv("OGX_PRAXIS_MODEL", DEFAULT_RESPONSE_MODEL),
+                "input": "Return the single word: unavailable.",
+                "tools": [{"type": "file_search", "vector_store_ids": [created_store.id]}],
+            },
+            token=token,
+        )
+        assert unavailable_response.status_code == 503, (
+            f"Expected HTTP 503 for delegated file_search, got {unavailable_response.status_code}"
+        )
+        response_error = _structured_error(response=unavailable_response)
+        for field in ("type", "message", "code"):
+            assert response_error.get(field), f"Error object field {field!r} must be non-empty"
+        error_text = unavailable_response.text.lower()
+        for forbidden in ("traceback", "exception", ".svc.cluster.local", "pod/"):
+            assert forbidden not in error_text, f"Error body leaked internal detail {forbidden!r}"
+    finally:
+        deployment.scale_replicas(replica_count=original_replicas)
+        _wait_for_replicas(deployment=deployment, expected=original_replicas)
+
+    with _api_client(route=route, token=token) as client:
+        recovered = client.files.retrieve(file_id=created_file.id).model_dump()
+    for field in ("id", "bytes", "filename", "created_at", "status"):
+        assert recovered.get(field) == baseline.get(field), (
+            f"Recovered file changed {field}: {baseline.get(field)!r} -> {recovered.get(field)!r}"
+        )
+
+
+@pytest.mark.ogx
