+from __future__ import annotations
+
+import os
+import time
+from typing import Any
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.deployment import Deployment
+from ocp_resources.resource import ResourceEditor
+from ocp_utilities.monitoring import Prometheus
+from timeout_sampler import TimeoutSampler
+
+
+ALERT_NAME = "MaaSHighAuthDenyRate"
+
+
+def _query_value(prometheus: Prometheus, query: str) -> float:
+    results = prometheus.query_sampler(query=query)
+    assert results, f"PromQL query returned no data: {query}"
+    return float(results[-1]["value"][1])
+
+
+def _authorino_deployment(admin_client: DynamicClient) -> Deployment:
+    namespace = os.environ.get("AUTHORINO_NAMESPACE", "")
+    namespaces = [namespace] if namespace else ["rh-connectivity-link", "kuadrant-system"]
+    for candidate_namespace in namespaces:
+        deployment = Deployment(
+            client=admin_client,
+            name="authorino",
+            namespace=candidate_namespace,
+        )
+        if deployment.exists:
+            return deployment
+    pytest.fail("Authorino deployment not found in configured namespaces")
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+@pytest.mark.slow
+def test_tc_e2e_001(prometheus: Prometheus) -> None:
+    """TC-E2E-001: Verify raw metrics, recording rules, and dashboard values from live auth traffic."""
+    decision_rate = _query_value(
+        prometheus=prometheus,
+        query='sum(rate(auth_server_authconfig_response_status[5m]))',
+    )
+    assert decision_rate > 0, f"Expected positive decision rate, got {decision_rate}"
+
+    deny_ratio = _query_value(
+        prometheus=prometheus,
+        query=(
+            'sum(rate(auth_server_authconfig_response_status{status!="OK"}[5m])) '
+            '/ sum(rate(auth_server_authconfig_response_status[5m]))'
+        ),
+    )
+    assert 0.15 <= deny_ratio <= 0.25, f"Expected approximately 20% denial, got {deny_ratio}"
+
+    latency = _query_value(
+        prometheus=prometheus,
+        query='maas:auth_latency_p95:5m',
+    )
+    assert 0 < latency < 1.0, f"Expected positive sub-second P95 latency, got {latency}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+@pytest.mark.slow
+def test_tc_e2e_002(prometheus: Prometheus) -> None:
+    """TC-E2E-002: Verify a sustained deny-rate breach fires and later resolves the alert."""
+    alerts = prometheus.get_all_alerts_by_alert_name(alert_name=ALERT_NAME)
+    assert alerts, "Expected MaaSHighAuthDenyRate to be active during elevated deny traffic"
+    assert any(alert.get("state") == "firing" for alert in alerts), (
+        f"Expected a firing alert, got {alerts}"
+    )
+
+    deny_ratio = _query_value(
+        prometheus=prometheus,
+        query='maas:auth_deny_ratio:rate5m',
+    )
+    assert deny_ratio > 0.10, f"Expected elevated deny ratio, got {deny_ratio}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_e2e_003(admin_client: DynamicClient, prometheus: Prometheus) -> None:
+    """TC-E2E-003: Verify observability survives an Authorino rolling update."""
+    deployment = _authorino_deployment(admin_client=admin_client)
+    baseline_rate = _query_value(
+        prometheus=prometheus,
+        query='sum(maas:auth_decisions:rate5m)',
+    )
+    assert baseline_rate > 0, f"Expected positive baseline decision rate, got {baseline_rate}"
+
+    rollout_id = str(int(time.time()))
+    with ResourceEditor(
+        patches={
+            deployment: {
+                "spec": {
+                    "template": {
+                        "metadata": {
+                            "annotations": {"authorino-rollout-test": rollout_id}
+                        }
+                    }
+                }
+            }
+        }
+    ):
+        deployment.wait_for_condition(condition="Available", status="True", timeout=300)
+        for sample in TimeoutSampler(
+            wait_timeout=300,
+            sleep=30,
+            func=_query_value,
+            prometheus=prometheus,
+            query='sum(maas:auth_decisions:rate5m)',
+        ):
+            if sample > 0:
+                break
+        else:
+            pytest.fail("Recording rules did not resume after the Authorino rollout")
+
+        assert not prometheus.get_firing_alerts(alert_name=ALERT_NAME), (
+            "Authorino rollout triggered MaaSHighAuthDenyRate spuriously"
+        )
+
+    recovered_rate = _query_value(
+        prometheus=prometheus,
+        query='sum(maas:auth_decisions:rate5m)',
+    )
+    assert abs(recovered_rate - baseline_rate) <= baseline_rate * 0.20, (
+        f"Decision rate did not recover near baseline: baseline={baseline_rate}, recovered={recovered_rate}"
+    )
