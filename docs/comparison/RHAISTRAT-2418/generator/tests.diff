+@pytest.mark.tier3
+@pytest.mark.slow
+def test_tc_edge_004(prometheus: Prometheus) -> None:
+    """TC-EDGE-004: Verify recording rules aggregate multiple Authorino replicas correctly."""
+    per_replica_results = prometheus.query_sampler(
+        query=(
+            'sum by (instance, authconfig, namespace, status) '
+            '(rate(auth_server_authconfig_response_status{job="authorino-server-metrics"}[5m]))'
+        )
+    )
+    instances = {result["metric"].get("instance") for result in per_replica_results}
+    assert len(instances) >= 2, f"Expected at least two scraped Authorino replicas, got {instances}"
+    assert all(float(result["value"][1]) > 0 for result in per_replica_results), (
+        "Expected every scraped replica to receive traffic"
+    )
+
+    summed_raw_rate = sum(float(result["value"][1]) for result in per_replica_results)
+    recording_rule_rate = _query_value(
+        prometheus=prometheus,
+        query='sum(maas:auth_decisions:rate5m)',
+    )
+    assert recording_rule_rate > 0, "Expected a positive recording-rule decision rate"
+    assert abs(summed_raw_rate - recording_rule_rate) <= recording_rule_rate * 0.05, (
+        f"Raw replica sum {summed_raw_rate} differs from recording rule {recording_rule_rate} by more than 5%"
+    )
+
+    label_results = prometheus.query_sampler(query='maas:auth_decisions:rate5m')
+    assert label_results, "Recording-rule query returned no data"
+    expected_labels = {"__name__", "authconfig", "namespace", "status"}
+    for result in label_results:
+        assert set(result["metric"]) == expected_labels, (
+            f"Unexpected recording-rule labels: {set(result['metric'])}"
+        )
