+from __future__ import annotations
+
+import os
+import re
+from typing import Any
+
+import pytest
+import requests
+from ocp_utilities.monitoring import Prometheus
+
+
+FORBIDDEN_LABELS = {
+    "enduser.id",
+    "user",
+    "cost_center",
+    "organization_id",
+    "subscription",
+}
+AUTHCONFIG_HASH_PATTERN = re.compile(r"^[a-f0-9]{64}$")
+
+
+def _metrics_text() -> str:
+    url = os.environ.get("AUTHORINO_METRICS_URL", "")
+    if not url:
+        pytest.skip("AUTHORINO_METRICS_URL is required to query Authorino /server-metrics")
+    response = requests.get(url=url, timeout=15, verify=False)
+    assert response.status_code == 200, (
+        f"Authorino metrics endpoint returned HTTP {response.status_code}: {response.text[:200]}"
+    )
+    return response.text
+
+
+def _label_names(line: str) -> set[str]:
+    if "{" not in line:
+        return set()
+    labels_text = line.split("{", 1)[1].split("}", 1)[0]
+    return {
+        match.group(1)
+        for match in re.finditer(r'([A-Za-z_][A-Za-z0-9_]*)="', labels_text)
+    }
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+def test_tc_privacy_001() -> None:
+    """TC-PRIVACY-001: Verify auth decision metrics do not expose user-identifying labels."""
+    lines = [
+        line
+        for line in _metrics_text().splitlines()
+        if line.startswith("auth_server_authconfig_response_status")
+        or line.startswith("auth_server_authconfig_duration_seconds")
+    ]
+    assert lines, "Expected Authorino auth decision metrics in /server-metrics"
+    for line in lines:
+        labels = _label_names(line)
+        forbidden = labels & FORBIDDEN_LABELS
+        assert not forbidden, f"User-identifying labels found in {line}: {forbidden}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+def test_tc_privacy_002(prometheus: Prometheus) -> None:
+    """TC-PRIVACY-002: Verify dashboard filters and queries expose only policy hashes and statuses."""
+    results = prometheus.query_sampler(
+        query='count by (authconfig) (auth_server_authconfig_response_status)'
+    )
+    assert results, "Prometheus returned no dashboard authconfig filter values"
+    for result in results:
+        authconfig_hash = result["metric"].get("authconfig")
+        assert authconfig_hash and AUTHCONFIG_HASH_PATTERN.fullmatch(authconfig_hash), (
+            f"Dashboard filter exposes a non-hash authconfig value: {authconfig_hash}"
+        )
+
+    dashboard_url = os.environ.get("PERSES_DASHBOARD_URL", "")
+    if not dashboard_url:
+        pytest.skip("PERSES_DASHBOARD_URL is required to inspect dashboard queries")
+    response = requests.get(
+        url=f"{dashboard_url.rstrip('/')}/api/dashboards/dashboard-4-maas-auth-decisions-admin",
+        timeout=15,
+        verify=False,
+    )
+    assert response.status_code == 200, (
+        f"Perses API returned HTTP {response.status_code}: {response.text[:200]}"
+    )
+    dashboard_text = response.text
+    for forbidden_label in FORBIDDEN_LABELS:
+        assert forbidden_label not in dashboard_text, (
+            f"Dashboard query references user-identifying label {forbidden_label}"
+        )
