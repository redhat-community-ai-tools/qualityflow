+from __future__ import annotations
+
+import os
+import time
+from typing import Any
+
+import pytest
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.deployment import Deployment
+from ocp_resources.resource import ResourceEditor
+from ocp_utilities.monitoring import Prometheus
+from timeout_sampler import TimeoutSampler
+
+
+ALERT_NAME = "MaaSHighAuthDenyRate"
+SERVICE_MONITOR_JOB = "authorino-server-metrics"
+
+
+def _query_value(prometheus: Prometheus, query: str) -> float:
+    results = prometheus.query_sampler(query=query)
+    assert results, f"PromQL query returned no data: {query}"
+    return float(results[-1]["value"][1])
+
+
+def _authorino_deployment(admin_client: DynamicClient) -> Deployment:
+    namespace = os.environ.get("AUTHORINO_NAMESPACE", "")
+    namespaces = [namespace] if namespace else ["rh-connectivity-link", "kuadrant-system"]
+    for candidate_namespace in namespaces:
+        deployment = Deployment(
+            client=admin_client,
+            name="authorino",
+            namespace=candidate_namespace,
+        )
+        if deployment.exists:
+            return deployment
+    pytest.fail("Authorino deployment not found in configured namespaces")
+
+
+@pytest.mark.metrics
+@pytest.mark.tier3
+def test_tc_edge_001(prometheus: Prometheus) -> None:
+    """TC-EDGE-001: Verify dashboard queries return safe zero values during a cold start."""
+    decision_rate = _query_value(
+        prometheus=prometheus,
+        query='sum(rate(auth_server_authconfig_response_status[5m])) or vector(0)',
+    )
+    assert decision_rate == 0, f"Expected zero decision rate during cold start, got {decision_rate}"
+
+    deny_ratio = _query_value(
+        prometheus=prometheus,
+        query=(
+            'sum(rate(auth_server_authconfig_response_status{status!="OK"}[5m])) '
+            '/ sum(rate(auth_server_authconfig_response_status[5m])) '
+            '> -Inf or vector(0)'
+        ),
+    )
