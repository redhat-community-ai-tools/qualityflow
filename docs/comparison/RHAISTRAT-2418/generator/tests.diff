+from __future__ import annotations
+
+import os
+import time
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+import pytest
+import requests
+from ocp_utilities.monitoring import Prometheus
+
+
+ALERT_NAME = "MaaSHighAuthDenyRate"
+ALERT_SUMMARY = "High auth denial rate for an Authorino AuthConfig"
+
+
+def _required_environment(name: str) -> str:
+    value = os.environ.get(name, "")
+    if not value:
+        pytest.skip(f"{name} is required to drive Authorino auth traffic")
+    return value
+
+
+def _send_request(session: requests.Session, url: str, token: str) -> int:
+    response = session.get(
+        url,
+        headers={"Authorization": f"Bearer {token}"},
+        timeout=10,
+        verify=False,
+    )
+    return response.status_code
+
+
+def _generate_traffic(
+    url: str,
+    valid_token: str,
+    invalid_token: str,
+    deny_ratio: float,
+    duration_seconds: int,
+) -> tuple[int, int]:
+    allowed = 0
+    denied = 0
+    deadline = time.monotonic() + duration_seconds
+    with requests.Session() as session, ThreadPoolExecutor(max_workers=8) as executor:
+        while time.monotonic() < deadline:
+            batch_size = 20
+            tokens = [
+                invalid_token if index / batch_size < deny_ratio else valid_token
+                for index in range(batch_size)
+            ]
+            statuses = list(
+                executor.map(
+                    lambda token: _send_request(
+                        session=session,
+                        url=url,
+                        token=token,
+                    ),
+                    tokens,
+                )
+            )
+            allowed += statuses.count(200)
+            denied += sum(status in (401, 403) for status in statuses)
+            time.sleep(1)
+    return allowed, denied
+
+
+def _matching_alerts(
+    prometheus: Prometheus,
+    authconfig_hash: str,
+    namespace: str,
+) -> list[dict[str, Any]]:
+    return [
+        alert
+        for alert in prometheus.get_all_alerts_by_alert_name(alert_name=ALERT_NAME)
+        if alert.get("labels", {}).get("authconfig") == authconfig_hash
+        and alert.get("labels", {}).get("namespace") == namespace
+    ]
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_alert_001(prometheus: Prometheus) -> None:
+    """TC-ALERT-001: Verify the high deny-rate alert fires after a sustained threshold breach."""
+    url = _required_environment("AUTHORINO_CHECK_URL")
+    valid_token = _required_environment("AUTHORINO_VALID_TOKEN")
+    invalid_token = _required_environment("AUTHORINO_INVALID_TOKEN")
+    authconfig_hash = _required_environment("AUTHORINO_AUTHCONFIG_HASH")
+    namespace = _required_environment("AUTHORINO_NAMESPACE")
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        traffic_future = executor.submit(
+            _generate_traffic,
+            url=url,
+            valid_token=valid_token,
+            invalid_token=invalid_token,
+            deny_ratio=0.20,
+            duration_seconds=15 * 60,
+        )
+        time.sleep(5 * 60)
+        early_alerts = _matching_alerts(
+            prometheus=prometheus,
+            authconfig_hash=authconfig_hash,
+            namespace=namespace,
+        )
+        assert all(alert.get("state") != "firing" for alert in early_alerts), (
+            f"Alert fired before the 10-minute sustain window: {early_alerts}"
+        )
+        allowed, denied = traffic_future.result()
+
+    assert denied > 0, "No denied requests were generated"
+    assert allowed > 0, "No allowed requests were generated"
+
+    alerts = _matching_alerts(
+        prometheus=prometheus,
+        authconfig_hash=authconfig_hash,
+        namespace=namespace,
+    )
+    assert len(alerts) == 1, f"Expected exactly one matching alert, found {len(alerts)}"
+    alert = alerts[0]
+    assert alert.get("state") == "firing", f"Expected firing alert, got {alert.get('state')}"
+    assert alert.get("labels", {}).get("severity") == "warning"
+    assert alert.get("annotations", {}).get("summary") == ALERT_SUMMARY
+    description = alert.get("annotations", {}).get("description", "")
+    assert authconfig_hash in description and namespace in description
+
+
+@pytest.mark.metrics
+@pytest.mark.tier3
+@pytest.mark.slow
+def test_tc_alert_002(prometheus: Prometheus) -> None:
+    """TC-ALERT-002: Verify the alert stays inactive when the deny ratio is at or below 10%."""
+    url = _required_environment("AUTHORINO_CHECK_URL")
+    valid_token = _required_environment("AUTHORINO_VALID_TOKEN")
+    invalid_token = _required_environment("AUTHORINO_INVALID_TOKEN")
+
+    _generate_traffic(
+        url=url,
+        valid_token=valid_token,
+        invalid_token=invalid_token,
+        deny_ratio=0.05,
+        duration_seconds=15 * 60,
+    )
+
+    firing_alerts = prometheus.get_firing_alerts(alert_name=ALERT_NAME)
+    assert not firing_alerts, f"Alert fired below the deny threshold: {firing_alerts}"
+    results = prometheus.query_sampler(query='maas:auth_deny_ratio:rate5m')
+    assert results, "Deny-ratio recording rule returned no data"
+    latest_value = float(results[-1]["value"][1])
+    assert 0 <= latest_value <= 0.10, f"Expected deny ratio at or below 0.10, got {latest_value}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier3
+@pytest.mark.slow
+def test_tc_alert_003(prometheus: Prometheus) -> None:
+    """TC-ALERT-003: Verify the alert waits for the full 10-minute sustain period."""
+    url = _required_environment("AUTHORINO_CHECK_URL")
+    valid_token = _required_environment("AUTHORINO_VALID_TOKEN")
+    invalid_token = _required_environment("AUTHORINO_INVALID_TOKEN")
+    authconfig_hash = _required_environment("AUTHORINO_AUTHCONFIG_HASH")
+    namespace = _required_environment("AUTHORINO_NAMESPACE")
+
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        traffic_future = executor.submit(
+            _generate_traffic,
+            url=url,
+            valid_token=valid_token,
+            invalid_token=invalid_token,
+            deny_ratio=0.20,
+            duration_seconds=11 * 60,
+        )
+        time.sleep(9 * 60)
+        early_alerts = _matching_alerts(
+            prometheus=prometheus,
+            authconfig_hash=authconfig_hash,
+            namespace=namespace,
+        )
+        assert all(alert.get("state") != "firing" for alert in early_alerts), (
+            f"Alert fired before the sustain window: {early_alerts}"
+        )
+        traffic_future.result()
+
+    alerts = _matching_alerts(
+        prometheus=prometheus,
+        authconfig_hash=authconfig_hash,
+        namespace=namespace,
+    )
+    assert alerts, "Expected the alert to become active after the sustain window"
+    assert any(alert.get("state") == "firing" for alert in alerts), (
+        f"Expected a firing alert after 11 minutes, got {alerts}"
+    )
+
+
+@pytest.mark.metrics
+@pytest.mark.tier3
+@pytest.mark.slow
+def test_tc_alert_004(prometheus: Prometheus) -> None:
+    """TC-ALERT-004: Verify negligible traffic does not trigger the alert even at 100% denial."""
+    url = _required_environment("AUTHORINO_CHECK_URL")
+    invalid_token = _required_environment("AUTHORINO_INVALID_TOKEN")
+
+    with requests.Session() as session:
+        status_code = _send_request(
+            session=session,
+            url=url,
+            token=invalid_token,
+        )
+    assert status_code in (401, 403), f"Expected a denied request, got HTTP {status_code}"
+
+    time.sleep(15 * 60)
+    firing_alerts = prometheus.get_firing_alerts(alert_name=ALERT_NAME)
+    assert not firing_alerts, f"Alert fired despite negligible traffic: {firing_alerts}"
