+from __future__ import annotations
+
+import os
+from typing import Any
+
+import pytest
+import requests
+from ocp_utilities.monitoring import Prometheus
+
+
+DASHBOARD_NAME = "dashboard-4-maas-auth-decisions-admin"
+EXPECTED_DISPLAY_NAME = "Auth decisions"
+EXPECTED_PANELS = {
+    "totalDecisionRate",
+    "overallDenyRate",
+    "p95Latency",
+    "activePolicies",
+    "decisionsByStatus",
+    "decisionsByPolicy",
+    "denyRatioByPolicy",
+    "latencyByPolicy",
+}
+
+
+def _dashboard_url() -> str:
+    url = os.environ.get("PERSES_DASHBOARD_URL", "")
+    if not url:
+        pytest.skip("PERSES_DASHBOARD_URL is required to query the Perses API")
+    return url.rstrip("/")
+
+
+def _get_dashboard() -> dict[str, Any]:
+    response = requests.get(
+        url=f"{_dashboard_url()}/api/dashboards/{DASHBOARD_NAME}",
+        timeout=15,
+        verify=False,
+    )
+    assert response.status_code == 200, (
+        f"Perses API returned HTTP {response.status_code}: {response.text[:200]}"
+    )
+    return response.json()
+
+
+def _panel_names(dashboard: dict[str, Any]) -> set[str]:
+    panels = dashboard.get("spec", {}).get("panels", {})
+    if isinstance(panels, dict):
+        return set(panels)
+    if isinstance(panels, list):
+        return {panel.get("name", "") for panel in panels}
+    return set()
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+def test_tc_dash_001() -> None:
+    """TC-DASH-001: Verify the Authorino auth-decisions dashboard is deployed and accessible."""
+    dashboard = _get_dashboard()
+    assert dashboard.get("metadata", {}).get("name") == DASHBOARD_NAME
+    assert dashboard.get("spec", {}).get("display_name") == EXPECTED_DISPLAY_NAME
+    assert EXPECTED_PANELS.issubset(_panel_names(dashboard)), (
+        f"Missing dashboard panels: {sorted(EXPECTED_PANELS - _panel_names(dashboard))}"
+    )
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_dash_002(prometheus: Prometheus) -> None:
+    """TC-DASH-002: Verify the decisions-per-second panel reflects live auth traffic."""
+    results = prometheus.query_sampler(
+        query='sum(rate(auth_server_authconfig_response_status[5m])) or vector(0)'
+    )
+    assert results, "Decision-rate query returned no data"
+    value = float(results[-1]["value"][1])
+    assert value > 0, f"Expected a positive decision rate, got {value}"
+    _get_dashboard()
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_dash_003(prometheus: Prometheus) -> None:
+    """TC-DASH-003: Verify the deny-rate panel reports the generated deny percentage."""
+    results = prometheus.query_sampler(
+        query=(
+            'sum(rate(auth_server_authconfig_response_status{status!="OK"}[5m])) / '
+            'sum(rate(auth_server_authconfig_response_status[5m])) > -Inf or vector(0)'
+        )
+    )
+    assert results, "Deny-ratio query returned no data"
+    value = float(results[-1]["value"][1])
+    assert 0.20 <= value <= 0.30, f"Expected approximately 25% denial, got {value}"
+    _get_dashboard()
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_dash_004(prometheus: Prometheus) -> None:
+    """TC-DASH-004: Verify status-series data contains allowed and denied gRPC codes."""
+    results = prometheus.query_sampler(
+        query='sum by (status) (rate(auth_server_authconfig_response_status[5m]))'
+    )
+    statuses = {result["metric"].get("status") for result in results}
+    assert "OK" in statuses, f"Expected OK status series, got {sorted(statuses)}"
+    assert any(status and status != "OK" for status in statuses), (
+        f"Expected at least one non-OK status series, got {sorted(statuses)}"
+    )
+    assert all(float(result["value"][1]) > 0 for result in results), (
+        "Expected every status series to have a positive rate"
+    )
+    _get_dashboard()
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+@pytest.mark.slow
+def test_tc_dash_005(prometheus: Prometheus) -> None:
+    """TC-DASH-005: Verify the authconfig filter narrows panel data to one policy."""
+    values = prometheus.query_sampler(
+        query='count(count by (authconfig) (auth_server_authconfig_response_status))'
+    )
+    assert values, "Authconfig label query returned no data"
+    total_policies = int(float(values[-1]["value"][1]))
+    assert total_policies >= 2, f"Expected at least two authconfig policies, got {total_policies}"
+
+    label_values = prometheus.query_sampler(
+        query='count by (authconfig) (auth_server_authconfig_response_status)'
+    )
+    authconfig_hashes = [result["metric"]["authconfig"] for result in label_values]
+    selected_hash = authconfig_hashes[0]
+    filtered_results = prometheus.query_sampler(
+        query=(
+            f'sum(rate(auth_server_authconfig_response_status{{authconfig="{selected_hash}"}}[5m]))'
+        )
+    )
+    assert filtered_results, "Filtered decision-rate query returned no data"
+    assert all(
+        result["metric"].get("authconfig") == selected_hash
+        for result in filtered_results
+    ), "Filtered query leaked data from another authconfig"
+    _get_dashboard()
