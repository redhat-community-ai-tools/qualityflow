+from __future__ import annotations
+
+import hashlib
+import os
+import re
+from typing import Any
+
+import pytest
+import requests
+from kubernetes.dynamic import DynamicClient
+from ocp_utilities.monitoring import Prometheus
+
+
+AUTHCONFIG_HASH_PATTERN = re.compile(r"^[a-f0-9]{64}$")
+
+
+def _metrics_text() -> str:
+    url = os.environ.get("AUTHORINO_METRICS_URL", "")
+    if not url:
+        pytest.skip("AUTHORINO_METRICS_URL is required to query Authorino /server-metrics")
+    response = requests.get(url=url, timeout=15, verify=False)
+    assert response.status_code == 200, (
+        f"Authorino metrics endpoint returned HTTP {response.status_code}: {response.text[:200]}"
+    )
+    return response.text
+
+
+def _metric_lines(metric_name: str) -> list[str]:
+    return [
+        line
+        for line in _metrics_text().splitlines()
+        if line.startswith(metric_name)
+    ]
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+def test_tc_metrics_001() -> None:
+    """TC-METRICS-001: Verify the auth decision counter and its label schema."""
+    lines = _metric_lines("auth_server_authconfig_response_status")
+    assert lines, "auth_server_authconfig_response_status is absent from /server-metrics"
+    for line in lines:
+        labels = line.split("{", 1)[1].split("}", 1)[0] if "{" in line else ""
+        assert "authconfig=" in labels, f"Missing authconfig label in {line}"
+        assert "namespace=" in labels, f"Missing namespace label in {line}"
+        assert "status=" in labels, f"Missing status label in {line}"
+        assert "enduser.id" not in labels and "user=" not in labels, (
+            f"Unexpected user-identifying label in {line}"
+        )
+        value = float(line.rsplit(" ", 1)[1])
+        assert value > 0, f"Expected a non-zero counter value in {line}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+def test_tc_metrics_002() -> None:
+    """TC-METRICS-002: Verify the auth decision histogram and its standard buckets."""
+    bucket_lines = _metric_lines("auth_server_authconfig_duration_seconds_bucket")
+    count_lines = _metric_lines("auth_server_authconfig_duration_seconds_count")
+    sum_lines = _metric_lines("auth_server_authconfig_duration_seconds_sum")
+    assert bucket_lines, "Histogram bucket metric is absent from /server-metrics"
+    assert count_lines, "Histogram count metric is absent from /server-metrics"
+    assert sum_lines, "Histogram sum metric is absent from /server-metrics"
+    assert any('le="' in line for line in bucket_lines), "Histogram buckets do not expose le boundaries"
+    for line in bucket_lines + count_lines + sum_lines:
+        assert "authconfig=" in line, f"Missing authconfig label in {line}"
+        assert "namespace=" in line, f"Missing namespace label in {line}"
+    for line in count_lines + sum_lines:
+        assert float(line.rsplit(" ", 1)[1]) > 0, f"Expected a non-zero histogram value in {line}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+def test_tc_metrics_003() -> None:
+    """TC-METRICS-003: Verify evaluator counters and histograms with their label schema."""
+    evaluator_total_lines = _metric_lines("auth_server_evaluator_total")
+    evaluator_bucket_lines = _metric_lines("auth_server_evaluator_duration_seconds_bucket")
+    evaluator_count_lines = _metric_lines("auth_server_evaluator_duration_seconds_count")
+    evaluator_sum_lines = _metric_lines("auth_server_evaluator_duration_seconds_sum")
+    assert evaluator_total_lines, "auth_server_evaluator_total is absent from /server-metrics"
+    assert evaluator_bucket_lines, "Evaluator histogram bucket metric is absent"
+    assert evaluator_count_lines, "Evaluator histogram count metric is absent"
+    assert evaluator_sum_lines, "Evaluator histogram sum metric is absent"
+    for line in evaluator_total_lines + evaluator_bucket_lines + evaluator_count_lines + evaluator_sum_lines:
+        assert "evaluator_name=" in line, f"Missing evaluator_name label in {line}"
+        assert "evaluator_type=" in line, f"Missing evaluator_type label in {line}"
+    for line in evaluator_total_lines + evaluator_count_lines + evaluator_sum_lines:
+        assert float(line.rsplit(" ", 1)[1]) > 0, f"Expected a non-zero evaluator value in {line}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+def test_tc_metrics_004(admin_client: DynamicClient, prometheus: Prometheus) -> None:
+    """TC-METRICS-004: Verify authconfig labels are SHA-256 hashes of AuthConfig resources."""
+    authconfig_resource = admin_client.resources.get(
+        api_version="authorino.kuadrant.io/v1beta1",
+        kind="AuthConfig",
+    )
+    authconfigs = authconfig_resource.get()
+    resource_hashes = {
+        hashlib.sha256(item["metadata"]["name"].encode()).hexdigest()
+        for item in authconfigs.items
+    }
+    assert resource_hashes, "No AuthConfig resources were found"
+
+    results = prometheus.query_sampler(
+        query='count by (authconfig) (auth_server_authconfig_response_status)'
+    )
+    assert results, "Prometheus returned no authconfig label values"
+    metric_hashes = {result["metric"]["authconfig"] for result in results}
+    assert metric_hashes, "Prometheus authconfig label values are empty"
+    for metric_hash in metric_hashes:
+        assert AUTHCONFIG_HASH_PATTERN.fullmatch(metric_hash), (
+            f"authconfig label is not a SHA-256 hash: {metric_hash}"
+        )
+    assert metric_hashes == resource_hashes, (
+        f"Prometheus authconfig hashes do not match AuthConfig resources: {metric_hashes ^ resource_hashes}"
+    )
