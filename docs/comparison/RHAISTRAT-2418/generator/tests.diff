+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+from ocp_utilities.monitoring import Prometheus
+
+
+def _query_value(prometheus: Prometheus, query: str) -> float:
+    results = prometheus.query_sampler(query=query)
+    assert results, f"PromQL query returned no data: {query}"
+    return float(results[-1]["value"][1])
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+@pytest.mark.slow
+def test_tc_rules_001(prometheus: Prometheus) -> None:
+    """TC-RULES-001: Verify the five-minute auth decision rate recording rule."""
+    results = prometheus.query_sampler(query='maas:auth_decisions:rate5m')
+    assert results, "maas:auth_decisions:rate5m returned no data"
+    for result in results:
+        labels = result["metric"]
+        assert {"authconfig", "namespace", "status"}.issubset(labels), (
+            f"Recording rule is missing required labels: {labels}"
+        )
+        assert float(result["value"][1]) > 0, "Recording rule returned a non-positive rate"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+@pytest.mark.slow
+def test_tc_rules_002(prometheus: Prometheus) -> None:
+    """TC-RULES-002: Verify the deny-ratio recording rule computes the expected ratio."""
+    results = prometheus.query_sampler(query='maas:auth_deny_ratio:rate5m')
+    assert results, "maas:auth_deny_ratio:rate5m returned no data"
+    for result in results:
+        labels = result["metric"]
+        assert {"authconfig", "namespace"}.issubset(labels), (
+            f"Deny-ratio recording rule is missing required labels: {labels}"
+        )
+        value = float(result["value"][1])
+        assert 0.20 <= value <= 0.30, f"Expected approximately 25% denial, got {value}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+@pytest.mark.slow
+def test_tc_rules_003(prometheus: Prometheus) -> None:
+    """TC-RULES-003: Verify the P95 auth decision latency recording rule."""
+    results = prometheus.query_sampler(query='maas:auth_latency_p95:5m')
+    assert results, "maas:auth_latency_p95:5m returned no data"
+    for result in results:
+        labels = result["metric"]
+        assert {"authconfig", "namespace"}.issubset(labels), (
+            f"P95 latency recording rule is missing required labels: {labels}"
+        )
+        value = float(result["value"][1])
+        assert 0.001 <= value <= 1.0, f"Expected sub-second P95 latency, got {value}"
+
+
+@pytest.mark.metrics
+@pytest.mark.tier1
+def test_tc_rules_004() -> None:
+    """TC-RULES-004: Verify the Authorino alerting-rule promtool unit suite passes."""
+    repository_path = os.environ.get("MAAS_REPO_PATH", "")
+    if not repository_path:
+        pytest.skip("MAAS_REPO_PATH is required to run the promtool unit suite")
+    promtool_path = shutil.which("promtool")
+    if not promtool_path:
+        pytest.skip("promtool is not installed in the test environment")
+
+    unit_test_path = Path(repository_path) / "deployment/base/observability/maas-auth-alerting.unit-tests.yaml"
+    assert unit_test_path.is_file(), f"Promtool unit-test file not found: {unit_test_path}"
+
+    completed_process = subprocess.run(
+        args=[promtool_path, "test", "rules", str(unit_test_path)],
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=False,
+    )
+    assert completed_process.returncode == 0, (
+        f"promtool failed with exit code {completed_process.returncode}: {completed_process.stderr}"
+    )
+    assert "SUCCESS" in completed_process.stdout, (
+        f"promtool did not report SUCCESS: {completed_process.stdout}"
+    )
