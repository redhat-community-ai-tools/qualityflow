+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+
+METRIC_NAMES = (
+    "auth_server_authconfig_response_status",
+    "auth_server_authconfig_duration_seconds",
+    "auth_server_evaluator_total",
+    "auth_server_evaluator_duration_seconds",
+    "maas:auth_decisions:rate5m",
+    "maas:auth_deny_ratio:rate5m",
+    "maas:auth_latency_p95:5m",
+    "MaaSHighAuthDenyRate",
+)
+
+
+@pytest.mark.metrics
+@pytest.mark.tier2
+def test_tc_doc_001() -> None:
+    """TC-DOC-001: Verify Authorino auth-decision metrics are documented in the catalog."""
+    docs_path = os.environ.get("RHOAI_METRICS_CATALOG_PATH", "")
+    if not docs_path:
+        pytest.skip("RHOAI_METRICS_CATALOG_PATH is required to validate the metrics catalog")
+    catalog = Path(docs_path)
+    assert catalog.is_file(), f"Metrics catalog not found at {catalog}"
+    content = catalog.read_text(encoding="utf-8")
+
+    missing_metrics = [metric for metric in METRIC_NAMES if metric not in content]
+    assert not missing_metrics, f"Missing metric documentation: {missing_metrics}"
+
+    required_fields = (
+        "Metric type",
+        "Label schema",
+        "Source component",
+        "Authorino",
+        "/server-metrics",
+        "30s",
+    )
+    missing_fields = [field for field in required_fields if field not in content]
+    assert not missing_fields, f"Missing documentation fields: {missing_fields}"
+    assert content.count("PromQL") >= 2, "Expected at least two example PromQL queries"
+    assert "SHA-256" in content, "Expected authconfig hash-to-policy mapping documentation"
