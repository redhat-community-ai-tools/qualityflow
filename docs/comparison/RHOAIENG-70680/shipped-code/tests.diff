+"""QualityFlow tests for Agent Catalog custom sources.
+
+STP: outputs/RHOAIENG-70680/stp/RHOAIENG-70680_test_plan.md
+Jira: https://redhat.atlassian.net/browse/RHOAIENG-70680
+"""
+
+from typing import Any, Self
+
+import pytest
+import structlog
+from kubernetes.dynamic import DynamicClient
+
+from tests.ai_hub.agent_catalog.config.constants import (
+    TEST_AGENT_CATALOG_SOURCE_ID,
+    TEST_AGENT_NAMES,
+)
+from tests.ai_hub.constants import CATALOG_CONTAINER
+from tests.ai_hub.utils import execute_get_command_with_retry, get_model_catalog_pod
+
+LOGGER = structlog.get_logger(name=__name__)
+
+pytestmark = [
+    pytest.mark.usefixtures(
+        "updated_dsc_component_state_scope_session",
+        "model_registry_namespace",
+    ),
+]
+
+INVALID_AGENT_CATALOG_SOURCE_ID = "qf_invalid_agent_catalog"
+INVALID_AGENT_CATALOG_SOURCE = {
+    "name": "QualityFlow Invalid Agent Catalog",
+    "id": INVALID_AGENT_CATALOG_SOURCE_ID,
+    "type": "yaml",
+    "enabled": True,
+    "properties": {"yamlCatalogPath": "qf-invalid-agents.yaml"},
+    "labels": ["QualityFlow Invalid Agents"],
+}
+
+MALFORMED_AGENTS_YAML = """\
+agents:
+  - name: malformed-agent
+    displayName: Malformed Agent
+"""
+
+
+class TestQualityFlowAgentCatalogSources:
+    """Custom agent-source loading and rejection behavior."""
+
+    @pytest.mark.tier2
+    @pytest.mark.qf_test_id("TS-RHOAIENG-70680-031")
+    def test_generated_custom_source_loads_into_catalog_service(
+        self: Self,
+        agent_catalog_configmap_patch: None,
+        model_catalog_api_url: str,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """Given a generated custom agent catalog source
+        When the source is registered in the installed catalog
+        Then the source is available and its agents are listed
+
+        STP: outputs/RHOAIENG-70680/stp/RHOAIENG-70680_test_plan.md
+        """
+        sources_response = execute_get_command_with_retry(
+            url=f"{model_catalog_api_url}sources",
+            headers=model_registry_rest_headers,
+            params={"assetType": "agents"},
+        )
+        matching_sources = [
+            source
+            for source in sources_response.get("items", [])
+            if source.get("id") == TEST_AGENT_CATALOG_SOURCE_ID
+        ]
+        assert matching_sources, (
+            f"Custom agent source '{TEST_AGENT_CATALOG_SOURCE_ID}' was not returned: {sources_response}"
+        )
+        assert matching_sources[0].get("status") == "available", (
+            f"Custom agent source is not available: {matching_sources[0]}"
+        )
+
+        agents_response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"pageSize": 1000},
+        )
+        returned_names = {agent["name"] for agent in agents_response.get("items", [])}
+        assert TEST_AGENT_NAMES <= returned_names, (
+            f"Expected custom agents {TEST_AGENT_NAMES}; missing {TEST_AGENT_NAMES - returned_names}"
+        )
+        LOGGER.info(f"Custom source {TEST_AGENT_CATALOG_SOURCE_ID} published {TEST_AGENT_NAMES}")
+
+    @pytest.mark.tier3
+    @pytest.mark.qf_test_id("TS-RHOAIENG-70680-039")
+    @pytest.mark.parametrize(
+        "agent_catalog_invalid_configmap_patch",
+        [
+            pytest.param(
+                {
+                    "source": INVALID_AGENT_CATALOG_SOURCE,
+                    "agents_yaml": MALFORMED_AGENTS_YAML,
+                },
+                id="malformed_custom_source_yaml",
+            )
+        ],
+        indirect=True,
+    )
+    def test_malformed_custom_source_yaml_is_rejected(
+        self: Self,
+        agent_catalog_invalid_configmap_patch: None,
+        model_catalog_api_url: str,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        admin_client: DynamicClient,
+        model_registry_namespace: str,
+    ) -> None:
+        """Given a malformed custom agent catalog source
+        When the catalog loads the source
+        Then the source is rejected with a YAML diagnostic and healthy agents remain available
+
+        STP: outputs/RHOAIENG-70680/stp/RHOAIENG-70680_test_plan.md
+        """
+        sources_response = execute_get_command_with_retry(
+            url=f"{model_catalog_api_url}sources",
+            headers=model_registry_rest_headers,
+            params={"assetType": "agents"},
+        )
+        matching_sources = [
+            source
+            for source in sources_response.get("items", [])
+            if source.get("id") == INVALID_AGENT_CATALOG_SOURCE_ID
+        ]
+        assert matching_sources, (
+            f"Invalid agent source '{INVALID_AGENT_CATALOG_SOURCE_ID}' was not returned: {sources_response}"
+        )
+        assert matching_sources[0].get("status") == "error", (
+            f"Expected malformed source status 'error', got: {matching_sources[0]}"
+        )
+
+        catalog_pod = get_model_catalog_pod(
+            client=admin_client, model_registry_namespace=model_registry_namespace
+        )[0]
+        catalog_log = catalog_pod.log(container=CATALOG_CONTAINER)
+        assert "error parsing YAML" in catalog_log, (
+            "Expected the catalog pod to log a YAML parsing diagnostic for the malformed source"
+        )
+
+        agents_response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"pageSize": 1000},
+        )
+        returned_names = {agent["name"] for agent in agents_response.get("items", [])}
+        assert TEST_AGENT_NAMES <= returned_names, (
+            f"Malformed source disrupted healthy agents; missing {TEST_AGENT_NAMES - returned_names}"
+        )
