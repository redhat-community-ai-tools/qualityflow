+from collections.abc import Generator
+from typing import Any
+
+import pytest
+import yaml
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.resource import ResourceEditor
+
+from tests.ai_hub.agent_catalog.config.constants import (
+    TEST_AGENT_CATALOG_SOURCE,
+    TEST_AGENT_CATALOG_SOURCE_ID,
+    TEST_AGENTS_YAML,
+)
+from tests.ai_hub.agent_catalog.utils import get_agent_catalog_sources
+from tests.ai_hub.utils import count_items_in_catalog_yaml, get_catalog_api_size, wait_for_catalog_api
+
+
+def pytest_configure(config: pytest.Config) -> None:
+    """Register the QualityFlow scenario-id marker."""
+    config.addinivalue_line("markers", "qf_test_id(id): QualityFlow scenario id")
+
+
+@pytest.fixture
+def agent_catalog_invalid_configmap_patch(
+    request: pytest.FixtureRequest,
+    admin_client: DynamicClient,
+    model_registry_namespace: str,
+    agent_catalog_rest_urls: list[str],
+    model_registry_rest_headers: dict[str, str],
+    default_agent_count: int,
+) -> Generator[None]:
+    """Patch the catalog ConfigMap with one valid and one invalid agent source."""
+    param: dict[str, Any] = request.param
+    invalid_source: dict[str, Any] = param["source"]
+
+    catalog_config_map, current_data = get_agent_catalog_sources(
+        admin_client=admin_client, model_registry_namespace=model_registry_namespace
+    )
+    if "agent_catalogs" not in current_data:
+        current_data["agent_catalogs"] = []
+
+    retained_sources = {
+        TEST_AGENT_CATALOG_SOURCE_ID,
+        invalid_source["id"],
+    }
+    current_data["agent_catalogs"] = [
+        entry for entry in current_data["agent_catalogs"] if entry.get("id") not in retained_sources
+    ]
+    current_data["agent_catalogs"].extend([TEST_AGENT_CATALOG_SOURCE, invalid_source])
+
+    patches = {
+        "data": {
+            "sources.yaml": yaml.dump(current_data, default_flow_style=False),
+            TEST_AGENT_CATALOG_SOURCE["properties"]["yamlCatalogPath"]: TEST_AGENTS_YAML,
+            invalid_source["properties"]["yamlCatalogPath"]: param["agents_yaml"],
+        }
+    }
+
+    pre_patch_size = get_catalog_api_size(
+        url=f"{agent_catalog_rest_urls[0]}agents", headers=model_registry_rest_headers
+    )
+    expected_setup_size = pre_patch_size + count_items_in_catalog_yaml(
+        catalog_yaml=TEST_AGENTS_YAML, key="agents"
+    )
+
+    with ResourceEditor(patches={catalog_config_map: patches}):
+        stable_data = wait_for_catalog_api(
+            endpoint="agents",
+            item_name="agents",
+            url=agent_catalog_rest_urls[0],
+            headers=model_registry_rest_headers,
+            previous_size=pre_patch_size,
+            expected_size=expected_setup_size,
+        )
+        yield
+
+    wait_for_catalog_api(
+        endpoint="agents",
+        item_name="agents",
+        url=agent_catalog_rest_urls[0],
+        headers=model_registry_rest_headers,
+        previous_size=stable_data.get("size", 0),
+        expected_size=default_agent_count,
+    )
