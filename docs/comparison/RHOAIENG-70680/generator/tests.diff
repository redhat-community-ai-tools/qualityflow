@@ -0,0 +1,134 @@
+from typing import Self
+
+import pytest
+import yaml
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.config_map import ConfigMap
+from ocp_resources.deployment import Deployment
+
+from tests.ai_hub.agent_catalog.config.constants import (
+    AGENT_SOURCES_CATALOGS_PATH_ARG,
+    AGENT_SOURCES_VOLUME_MOUNT_PATH,
+    TEST_AGENT_CATALOG_SOURCE_ID,
+)
+from tests.ai_hub.constants import CATALOG_CONTAINER
+from tests.ai_hub.model_catalog.constants import MODEL_CATALOG_DEPLOYMENT_NAME
+from tests.ai_hub.utils import execute_get_command_with_retry
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+]
+
+
+class TestE2EAgentCatalog:
+    """End-to-end journeys through the agent catalog API."""
+
+    def test_tc_e2e_001(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        agents_response: dict,
+    ) -> None:
+        """TC-E2E-001: Browse, search, fetch details, and fetch artifacts."""
+        searched = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"q": "ReAct"},
+        )
+        assert searched["items"], "ReAct search returned no agents"
+        agent = searched["items"][0]
+        detail = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{agent['id']}",
+            headers=model_registry_rest_headers,
+        )
+        assert detail == agent
+        artifacts = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{agent['id']}/artifacts",
+            headers=model_registry_rest_headers,
+        )
+        assert "size" in artifacts and "items" in artifacts
+        assert all(artifact["id"] for artifact in artifacts["items"])
+
+    def test_tc_e2e_002(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        agents_response: dict,
+    ) -> None:
+        """TC-E2E-002: Add a custom source and browse both default and custom agents."""
+        names = {agent["name"] for agent in agents_response["items"]}
+        assert any(agent["source_id"] == TEST_AGENT_CATALOG_SOURCE_ID for agent in agents_response["items"])
+        assert any(agent["source_id"] != TEST_AGENT_CATALOG_SOURCE_ID for agent in agents_response["items"])
+        filtered = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"sourceLabel": "Test Agents", "pageSize": "1000"},
+        )
+        assert {agent["name"] for agent in filtered["items"]} <= names
+
+    def test_tc_e2e_003(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-E2E-003: Filter, search, and paginate the same result set."""
+        params = {"filterQuery": "framework='langgraph'", "q": "agent", "pageSize": "1"}
+        first_page = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params=params,
+        )
+        assert first_page["size"] >= 1
+        assert len(first_page["items"]) == 1
+        ids = {first_page["items"][0]["id"]}
+        token = first_page.get("nextPageToken")
+        while token:
+            params["nextPageToken"] = token
+            page = execute_get_command_with_retry(
+                url=f"{agent_catalog_rest_urls[0]}agents",
+                headers=model_registry_rest_headers,
+                params=params,
+            )
+            page_ids = {agent["id"] for agent in page["items"]}
+            assert page_ids and not page_ids & ids, f"Duplicate or empty page: {page_ids}"
+            ids.update(page_ids)
+            token = page.get("nextPageToken")
+        assert len(ids) == first_page["size"]
+
+    def test_tc_e2e_004(
+        self: Self,
+        admin_client: DynamicClient,
+        model_registry_namespace: str,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-E2E-004: Validate operator wiring from ConfigMap through plugin API."""
+        configmap = ConfigMap(
+            name="agent-catalog-sources",
+            namespace=model_registry_namespace,
+            client=admin_client,
+        )
+        assert configmap.exists
+        sources = yaml.safe_load(configmap.instance.data["sources.yaml"])
+        assert "agent_catalogs" in sources
+
+        deployment = Deployment(
+            name=MODEL_CATALOG_DEPLOYMENT_NAME,
+            namespace=model_registry_namespace,
+            client=admin_client,
+        )
+        container = next(
+            container for container in deployment.instance.spec.template.spec.containers
+            if container.name == CATALOG_CONTAINER
+        )
+        assert AGENT_SOURCES_VOLUME_MOUNT_PATH in {mount.mountPath for mount in container.volumeMounts}
+        assert AGENT_SOURCES_CATALOGS_PATH_ARG in container.args
+
+        agents = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"pageSize": "1000"},
+        )
+        assert agents["items"]
diff --git a/tests/ai_hub/agent_catalog/test_filter_agent_catalog.py b/tests/ai_hub/agent_catalog/test_filter_agent_catalog.py
new file mode 100644
index 0000000..2717910
--- /dev/null
+++ b/tests/ai_hub/agent_catalog/test_filter_agent_catalog.py
@@ -0,0 +1,171 @@
+from typing import Any, Self
+
+import pytest
+
+from tests.ai_hub.agent_catalog.constants import (
+    AUTOGEN_FRAMEWORK,
+    CLAUDE_CODE_FRAMEWORK,
+    CREWAI_FRAMEWORK,
+    LANGGRAPH_FRAMEWORK,
+)
+from tests.ai_hub.agent_catalog.utils import filter_agents_match_criteria_or
+from tests.ai_hub.utils import execute_get_command_with_retry
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+]
+
+
+class TestFilterAgentCatalog:
+    """filterQuery coverage for the agent catalog API."""
+
+    def _filtered(
+        self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        query: str,
+    ) -> list[dict[str, Any]]:
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"filterQuery": query, "pageSize": "1000"},
+        )
+        return response["items"]
+
+    def test_tc_filter_001(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-001: Verify equality filtering by framework."""
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, f"framework='{LANGGRAPH_FRAMEWORK}'")
+        assert {item["name"] for item in items} == {
+            agent["name"] for agent in default_agents if agent["framework"] == LANGGRAPH_FRAMEWORK
+        }
+
+    def test_tc_filter_002(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-002: Verify non-equality excludes the selected framework."""
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, f"framework!='{CREWAI_FRAMEWORK}'")
+        assert items
+        assert {item["name"] for item in items} == {
+            agent["name"] for agent in default_agents if agent["framework"] != CREWAI_FRAMEWORK
+        }
+
+    def test_tc_filter_003(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-003: Verify case-sensitive LIKE matching."""
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, "name LIKE '%langgraph%'")
+        assert {item["name"] for item in items} == {
+            agent["name"] for agent in default_agents if "langgraph" in agent["name"]
+        }
+
+    def test_tc_filter_004(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-004: Verify case-insensitive ILIKE matching."""
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, "name ILIKE '%REACT%'")
+        assert {item["name"] for item in items} == {
+            agent["name"] for agent in default_agents if "react" in agent["name"].lower()
+        }
+
+    def test_tc_filter_005(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-005: Verify IN-list matching."""
+        values = (LANGGRAPH_FRAMEWORK, CREWAI_FRAMEWORK)
+        query = f"framework IN ('{values[0]}','{values[1]}')"
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, query)
+        assert {item["name"] for item in items} == {
+            agent["name"] for agent in default_agents if agent["framework"] in values
+        }
+
+    def test_tc_filter_006(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-006: Verify AND combines both conditions."""
+        items = self._filtered(
+            agent_catalog_rest_urls,
+            model_registry_rest_headers,
+            f"framework='{LANGGRAPH_FRAMEWORK}' AND name LIKE '%agent%'",
+        )
+        assert {item["name"] for item in items} == {
+            agent["name"]
+            for agent in default_agents
+            if agent["framework"] == LANGGRAPH_FRAMEWORK and "agent" in agent["name"]
+        }
+
+    def test_tc_filter_007(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-007: Verify OR returns agents matching either condition."""
+        query = f"framework='{AUTOGEN_FRAMEWORK}' OR framework='{CLAUDE_CODE_FRAMEWORK}'"
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, query)
+        assert {item["name"] for item in items} == {
+            agent["name"]
+            for agent in default_agents
+            if agent["framework"] in (AUTOGEN_FRAMEWORK, CLAUDE_CODE_FRAMEWORK)
+        }
+
+    def test_tc_filter_008(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-008: Verify sourceLabel filters to one source."""
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"sourceLabel": "Red Hat Agents", "pageSize": "1000"},
+        )
+        assert {item["name"] for item in response["items"]} == {
+            agent["name"] for agent in default_agents if agent["source_id"] == "rh_agents"
+        }
+
+    def test_tc_filter_009(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict[str, Any]],
+    ) -> None:
+        """TC-FILTER-009: Verify nested AND and OR precedence."""
+        query = f"(framework='{LANGGRAPH_FRAMEWORK}' OR framework='{CREWAI_FRAMEWORK}') AND name LIKE '%agent%'"
+        items = self._filtered(agent_catalog_rest_urls, model_registry_rest_headers, query)
+        expected = filter_agents_match_criteria_or(
+            agents=default_agents,
+            criteria_groups=[
+                [
+                    {"field": "framework", "operator": "=", "value": LANGGRAPH_FRAMEWORK},
+                    {"field": "name", "operator": "LIKE", "value": "%agent%"},
+                ],
+                [
+                    {"field": "framework", "operator": "=", "value": CREWAI_FRAMEWORK},
+                    {"field": "name", "operator": "LIKE", "value": "%agent%"},
+                ],
+            ],
+        )
+        assert {item["name"] for item in items} == expected
