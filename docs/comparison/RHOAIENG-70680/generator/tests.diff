@@ -0,0 +1,103 @@
+from typing import Self
+
+import pytest
+import requests
+
+from tests.ai_hub.agent_catalog.config.constants import TEST_AGENT_NAMES
+from tests.ai_hub.utils import execute_get_command_with_retry
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+]
+
+
+class TestApiAgentCatalog:
+    """API-level coverage for the agent catalog plugin."""
+
+    def test_tc_api_001(self: Self, agents_response: dict) -> None:
+        """TC-API-001: Verify agents from default and custom sources are listed together."""
+        items = agents_response["items"]
+        names = {agent["name"] for agent in items}
+        assert items, "Agent list is empty"
+        assert TEST_AGENT_NAMES <= names, f"Custom agents missing: {TEST_AGENT_NAMES - names}"
+
+    def test_tc_api_002(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        agents_response: dict,
+    ) -> None:
+        """TC-API-002: Verify retrieving one agent by ID returns its complete metadata."""
+        listed_agent = agents_response["items"][0]
+        fetched_agent = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{listed_agent['id']}",
+            headers=model_registry_rest_headers,
+        )
+        assert fetched_agent == listed_agent, "Agent detail response differs from list response"
+
+    def test_tc_api_003(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-API-003: Verify filter options expose fields and values from loaded agents."""
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/filter_options",
+            headers=model_registry_rest_headers,
+        )
+        filters = response["filters"]
+        assert {"framework", "agentType", "tags"} <= set(filters), f"Missing filters: {set(filters)}"
+        assert filters["framework"], "framework filter has no values"
+
+    def test_tc_api_004(
+        self: Self,
+        model_catalog_api_url: str,
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-API-004: Verify the agent plugin is registered and ready."""
+        catalog_base_url = model_catalog_api_url.split("/api/", maxsplit=1)[0]
+        response = requests.get(
+            url=f"{catalog_base_url}/readyz",
+            headers=model_registry_rest_headers,
+            verify=False,
+            timeout=30,
+        )
+        assert response.status_code == 200, f"/readyz returned {response.status_code}: {response.text}"
+        body = response.json()
+        assert body["status"] == "ready", f"Catalog is not ready: {body}"
+        assert "agent" in body["plugins"], f"Agent plugin missing from /readyz: {body}"
+
+    def test_tc_api_005(
+        self: Self,
+        model_catalog_api_url: str,
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-API-005: Verify unified catalog health while model, MCP, and agent plugins are loaded."""
+        catalog_base_url = model_catalog_api_url.split("/api/", maxsplit=1)[0]
+        response = requests.get(
+            url=f"{catalog_base_url}/healthz",
+            headers=model_registry_rest_headers,
+            verify=False,
+            timeout=30,
+        )
+        assert response.status_code == 200, f"/healthz returned {response.status_code}: {response.text}"
+        body = response.json()
+        assert body["status"] == "ok", f"Unified catalog is unhealthy: {body}"
+        assert {"model", "mcp", "agent"} <= set(body["plugins"]), f"Expected plugins missing: {body}"
+
+    def test_tc_api_006(
+        self: Self,
+        model_catalog_api_url: str,
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-API-006: Verify unified sources filtered by assetType returns agent sources."""
+        response = execute_get_command_with_retry(
+            url=f"{model_catalog_api_url}sources",
+            headers=model_registry_rest_headers,
+            params={"assetType": "agents"},
+        )
+        items = response["items"]
+        assert items, "No agent sources returned"
+        assert all(item.get("assetType") == "agents" for item in items), f"Non-agent source returned: {items}"
