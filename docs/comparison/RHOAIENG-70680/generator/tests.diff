+from typing import Self
+
+import pytest
+import yaml
+from kubernetes.dynamic import DynamicClient
+from ocp_resources.resource import ResourceEditor
+
+from tests.ai_hub.agent_catalog.utils import get_agent_catalog_sources
+from tests.ai_hub.utils import (
+    execute_get_command_with_retry,
+    get_catalog_api_size,
+    wait_for_catalog_api,
+)
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+]
+
+
+class TestSrcAgentCatalog:
+    """Agent source discovery and lifecycle coverage."""
+
+    def test_tc_src_001(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        default_agents: list[dict],
+    ) -> None:
+        """TC-SRC-001: Verify sourceLabel resolves to the expected source ID."""
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params={"sourceLabel": "Red Hat Agents", "pageSize": "1000"},
+        )
+        assert {agent["name"] for agent in response["items"]} == {
+            agent["name"] for agent in default_agents if agent["source_id"] == "rh_agents"
+        }
+
+    def test_tc_src_002(
+        self: Self,
+        agents_response: dict,
+        agent_catalog_configmap_patch: None,
+    ) -> None:
+        """TC-SRC-002: Verify a patched custom source appears in the API."""
+        assert any(agent["source_id"] == "test_agent_catalog" for agent in agents_response["items"])
+
+    def test_tc_src_003(
+        self: Self,
+        admin_client: DynamicClient,
+        model_registry_namespace: str,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-SRC-003: Verify agents from a disabled source are excluded."""
+        enabled_source = {
+            "name": "Enabled Source",
+            "id": "enabled_agent_source",
+            "type": "yaml",
+            "enabled": True,
+            "properties": {"yamlCatalogPath": "enabled-agents.yaml"},
+        }
+        disabled_source = {
+            "name": "Disabled Source",
+            "id": "disabled_agent_source",
+            "type": "yaml",
+            "enabled": False,
+            "properties": {"yamlCatalogPath": "disabled-agents.yaml"},
+        }
+        enabled_yaml = "source: Enabled Source\nagents:\n  - name: enabled-source-agent\n    displayName: Enabled\n    description: Enabled source agent.\n    framework: langgraph\n"
+        disabled_yaml = "source: Disabled Source\nagents:\n  - name: disabled-source-agent\n    displayName: Disabled\n    description: Disabled source agent.\n    framework: crewai\n"
+
+        configmap, current_data = get_agent_catalog_sources(
+            admin_client=admin_client,
+            model_registry_namespace=model_registry_namespace,
+        )
+        original_catalogs = list(current_data.get("agent_catalogs", []))
+        current_data["agent_catalogs"] = [
+            entry for entry in original_catalogs if entry.get("id") not in {"enabled_agent_source", "disabled_agent_source"}
+        ] + [enabled_source, disabled_source]
+        previous_size = get_catalog_api_size(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+        )
+        patches = {
+            "data": {
+                "sources.yaml": yaml.dump(current_data, default_flow_style=False),
+                "enabled-agents.yaml": enabled_yaml,
+                "disabled-agents.yaml": disabled_yaml,
+            }
+        }
+        with ResourceEditor(patches={configmap: patches}):
+            wait_for_catalog_api(
+                endpoint="agents",
+                item_name="agents",
+                url=agent_catalog_rest_urls[0],
+                headers=model_registry_rest_headers,
+                previous_size=previous_size,
+                expected_size=previous_size + 1,
+            )
+            response = execute_get_command_with_retry(
+                url=f"{agent_catalog_rest_urls[0]}agents",
+                headers=model_registry_rest_headers,
+                params={"pageSize": "1000"},
+            )
+            names = {agent["name"] for agent in response["items"]}
+            assert "enabled-source-agent" in names
+            assert "disabled-source-agent" not in names
+
+    def test_tc_src_004(
+        self: Self,
+        model_catalog_api_url: str,
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-SRC-004: Verify unified sources returns model, MCP, and agent types."""
+        response = execute_get_command_with_retry(
+            url=f"{model_catalog_api_url}sources",
+            headers=model_registry_rest_headers,
+        )
+        source_types = {item["assetType"] for item in response["items"]}
+        assert {"models", "mcp_servers", "agents"} <= source_types
