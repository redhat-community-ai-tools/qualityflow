@@ -0,0 +1,122 @@
+from typing import Self
+
+import pytest
+
+from tests.ai_hub.agent_catalog.artifacts.constants import (
+    ARTIFACT_FULL_AGENT_NAME,
+    ARTIFACT_IMAGE_COUNT,
+    ARTIFACT_IMAGE_ONLY_AGENT_NAME,
+    ARTIFACT_TEST_AGENTS_YAML,
+    ARTIFACT_TEST_LABEL,
+    ARTIFACT_TEST_LABEL_DEFINITION,
+    ARTIFACT_TEST_SOURCE,
+    ARTIFACT_TEMPLATE_COUNT,
+    DEFAULT_TEMPLATE_NAME,
+    EXPECTED_TEMPLATE_NAMES,
+)
+from tests.ai_hub.utils import execute_get_command_with_retry
+
+ARTIFACT_CONFIGMAP_PARAM = {
+    "source": ARTIFACT_TEST_SOURCE,
+    "label": ARTIFACT_TEST_LABEL,
+    "label_definition": ARTIFACT_TEST_LABEL_DEFINITION,
+    "agents_yaml": ARTIFACT_TEST_AGENTS_YAML,
+    "min_agents": 4,
+}
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+    pytest.mark.parametrize("agent_catalog_configmap_patch", [ARTIFACT_CONFIGMAP_PARAM], indirect=True),
+]
+
+
+class TestArtifactAgentCatalog:
+    """Artifact endpoint coverage for the agent catalog plugin."""
+
+    def _agent_id(self, agents_response: dict, agent_name: str) -> str:
+        agent = next((item for item in agents_response["items"] if item["name"] == agent_name), None)
+        assert agent, f"Agent '{agent_name}' not found in catalog"
+        return agent["id"]
+
+    def test_tc_artifact_001(
+        self: Self,
+        agents_response: dict,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-ARTIFACT-001: Verify all artifacts are returned for an agent."""
+        agent_id = self._agent_id(agents_response, ARTIFACT_FULL_AGENT_NAME)
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{agent_id}/artifacts",
+            headers=model_registry_rest_headers,
+        )
+        items = response["items"]
+        assert len(items) == ARTIFACT_IMAGE_COUNT + ARTIFACT_TEMPLATE_COUNT
+        assert {item["artifactType"] for item in items} == {"image-artifact", "template-artifact"}
+
+    def test_tc_artifact_002(
+        self: Self,
+        agents_response: dict,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-ARTIFACT-002: Verify artifactType returns only image artifacts."""
+        agent_id = self._agent_id(agents_response, ARTIFACT_FULL_AGENT_NAME)
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{agent_id}/artifacts",
+            headers=model_registry_rest_headers,
+            params={"artifactType": "image-artifact"},
+        )
+        items = response["items"]
+        assert len(items) == ARTIFACT_IMAGE_COUNT
+        assert all(item["artifactType"] == "image-artifact" for item in items)
+
+    def test_tc_artifact_003(
+        self: Self,
+        agents_response: dict,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-ARTIFACT-003: Verify template artifacts include agent.yaml content."""
+        agent_id = self._agent_id(agents_response, ARTIFACT_FULL_AGENT_NAME)
+        response = execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents/{agent_id}/artifacts",
+            headers=model_registry_rest_headers,
+            params={"artifactType": "template-artifact"},
+        )
+        items = response["items"]
+        assert len(items) == ARTIFACT_TEMPLATE_COUNT
+        assert {item["name"] for item in items} == EXPECTED_TEMPLATE_NAMES
+        assert DEFAULT_TEMPLATE_NAME in {item["name"] for item in items}
+        assert all(item["content"] for item in items), "A template artifact has empty content"
+
+    def test_tc_artifact_004(
+        self: Self,
+        agents_response: dict,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-ARTIFACT-004: Verify artifact pagination is complete and duplicate-free."""
+        agent_id = self._agent_id(agents_response, ARTIFACT_IMAGE_ONLY_AGENT_NAME)
+        url = f"{agent_catalog_rest_urls[0]}agents/{agent_id}/artifacts"
+        total_response = execute_get_command_with_retry(url=url, headers=model_registry_rest_headers)
+        total_count = total_response["size"]
+        assert total_count > 1, "Artifact pagination needs more than one item"
+
+        ids: list[str] = []
+        next_token: str | None = None
+        for page_number in range(1, total_count + 1):
+            params = {"pageSize": "1"}
+            if next_token:
+                params["nextPageToken"] = next_token
+            page = execute_get_command_with_retry(url=url, headers=model_registry_rest_headers, params=params)
+            items = page["items"]
+            assert len(items) == 1, f"Expected one artifact on page {page_number}, got {len(items)}"
+            artifact_id = items[0]["id"]
+            assert artifact_id not in ids, f"Duplicate artifact on page {page_number}: {artifact_id}"
+            ids.append(artifact_id)
+            next_token = page.get("nextPageToken")
+            assert next_token or page_number == total_count, f"nextPageToken missing on page {page_number}"
+        assert len(ids) == total_count
diff --git a/tests/ai_hub/agent_catalog/test_e2e_agent_catalog.py b/tests/ai_hub/agent_catalog/test_e2e_agent_catalog.py
