+SCHEMA_SOURCE = {
+    "name": "Schema Test Agent Catalog",
+    "id": SCHEMA_SOURCE_ID,
+    "type": "yaml",
+    "enabled": True,
+    "properties": {"yamlCatalogPath": SCHEMA_YAML_PATH},
+    "labels": ["Schema Test Agents"],
+}
+SCHEMA_LABEL_DEFINITION = {
+    "name": "Schema Test Agents",
+    "assetType": "agents",
+    "displayName": "Schema test agents",
+}
+SCHEMA_AGENTS_YAML = """\
+source: Schema Test Agent Catalog
+agents:
+  - name: schema-full-agent
+    displayName: Schema Full Agent
+    description: Agent carrying the complete metadata set.
+    framework: langgraph
+    agentType: assistant
+    tags:
+      - schema
+      - full
+    license: Apache-2.0
+    customProperties:
+      owner: platform-qe
+      visibility: internal
+    createTimeSinceEpoch: "1748736000000"
+  - name: schema-minimal-agent
+    displayName: Schema Minimal Agent
+    description: Agent carrying only required metadata.
+    framework: crewai
+"""
+
+SCHEMA_PATCH_PARAM = {
+    "source": SCHEMA_SOURCE,
+    "label": "Schema Test Agents",
+    "label_definition": SCHEMA_LABEL_DEFINITION,
+    "agents_yaml": SCHEMA_AGENTS_YAML,
+    "min_agents": 2,
+}
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+    pytest.mark.parametrize("agent_catalog_configmap_patch", [SCHEMA_PATCH_PARAM], indirect=True),
+]
+
+
+class TestSchemaAgentCatalog:
+    """Schema and property-forwarding coverage for agent records."""
+
+    def _agent(self, agents_response: dict, name: str) -> dict:
+        agent = next((item for item in agents_response["items"] if item["name"] == name), None)
+        assert agent, f"Agent '{name}' not found"
+        return agent
+
+    def test_tc_schema_001(self: Self, agents_response: dict) -> None:
+        """TC-SCHEMA-001: Verify full agent metadata is returned unchanged."""
+        agent = self._agent(agents_response, "schema-full-agent")
+        assert agent["framework"] == "langgraph"
+        assert agent["agentType"] == "assistant"
+        assert set(agent["tags"]) == {"schema", "full"}
+        assert agent["license"] == "Apache-2.0"
+        assert agent["description"]
+
+    def test_tc_schema_002(self: Self, agents_response: dict) -> None:
+        """TC-SCHEMA-002: Verify an agent with required-only metadata loads."""
+        agent = self._agent(agents_response, "schema-minimal-agent")
+        assert agent["name"] == "schema-minimal-agent"
+        assert agent["displayName"]
+        assert agent["description"]
+        assert agent["framework"] == "crewai"
+        assert agent["id"]
+        assert agent["source_id"] == SCHEMA_SOURCE_ID
+
+    def test_tc_schema_003(self: Self, agents_response: dict) -> None:
+        """TC-SCHEMA-003: Verify custom properties are forwarded without modification."""
+        agent = self._agent(agents_response, "schema-full-agent")
+        assert agent["customProperties"] == {"owner": "platform-qe", "visibility": "internal"}
