+from typing import Self
+
+import pytest
+
+from tests.ai_hub.utils import execute_get_command_with_retry
+
+
+pytestmark = [
+    pytest.mark.tier1,
+    pytest.mark.usefixtures("updated_dsc_component_state_scope_session", "model_registry_namespace"),
+]
+
+
+class TestPageAgentCatalog:
+    """Pagination and ordering coverage for the agent catalog API."""
+
+    def _list(
+        self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+        params: dict[str, str],
+    ) -> dict:
+        return execute_get_command_with_retry(
+            url=f"{agent_catalog_rest_urls[0]}agents",
+            headers=model_registry_rest_headers,
+            params=params,
+        )
+
+    def test_tc_page_001(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-PAGE-001: Verify pageSize limits each page and exposes nextPageToken."""
+        response = self._list(agent_catalog_rest_urls, model_registry_rest_headers, {"pageSize": "2"})
+        assert len(response["items"]) <= 2
+        if response["size"] > 2:
+            assert response["nextPageToken"]
+
+    def test_tc_page_002(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-PAGE-002: Verify NAME ascending ordering."""
+        response = self._list(
+            agent_catalog_rest_urls,
+            model_registry_rest_headers,
+            {"orderBy": "NAME", "sortOrder": "ASC", "pageSize": "1000"},
+        )
+        names = [agent["name"] for agent in response["items"]]
+        assert names == sorted(names)
+
+    def test_tc_page_003(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-PAGE-003: Verify CREATE_TIME descending ordering."""
+        response = self._list(
+            agent_catalog_rest_urls,
+            model_registry_rest_headers,
+            {"orderBy": "CREATE_TIME", "sortOrder": "DESC", "pageSize": "1000"},
+        )
+        timestamps = [int(agent["createTimeSinceEpoch"]) for agent in response["items"]]
+        assert timestamps == sorted(timestamps, reverse=True)
+
+    def test_tc_page_004(
+        self: Self,
+        agent_catalog_rest_urls: list[str],
+        model_registry_rest_headers: dict[str, str],
+    ) -> None:
+        """TC-PAGE-004: Verify filtered pagination is complete, ordered, and duplicate-free."""
+        query = "framework='langgraph'"
+        total_response = self._list(agent_catalog_rest_urls, model_registry_rest_headers, {"filterQuery": query})
+        total = total_response["size"]
+        assert total > 0
+
+        ids: list[str] = []
+        token: str | None = None
+        for page_number in range(1, total + 1):
+            params = {"filterQuery": query, "pageSize": "1", "orderBy": "id", "sortOrder": "ASC"}
+            if token:
+                params["nextPageToken"] = token
+            page = self._list(agent_catalog_rest_urls, model_registry_rest_headers, params)
+            items = page["items"]
+            assert len(items) == 1, f"Expected one item on page {page_number}, got {len(items)}"
+            assert items[0]["framework"] == "langgraph"
+            agent_id = items[0]["id"]
+            assert agent_id not in ids, f"Duplicate agent on page {page_number}: {agent_id}"
+            ids.append(agent_id)
+            token = page.get("nextPageToken")
+            assert token or page_number == total
+        assert len(ids) == total
